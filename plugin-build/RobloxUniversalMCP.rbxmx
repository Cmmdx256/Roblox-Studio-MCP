		<Item class="ModuleScript" referent="RBX_24">
			<Properties>
				<string name="Name">ContextEngine</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local ContextEngine = {}

local KEY_SERVICES = {
	"Workspace",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPlayer",
	"Lighting",
	"SoundService",
}

function ContextEngine.BuildSummary(params: { maxDepth: number?, includeScriptSummaries: boolean? }): (any, ErrorCodes.ErrorObject?)
	local maxDepth = params.maxDepth or 3
	local includeScripts = params.includeScriptSummaries ~= false

	local servicesOverview: { [string]: any } = {}
	local scriptCount = 0
	local moduleCount = 0
	local remoteEventCount = 0
	local remoteFunctionCount = 0
	local modelCount = 0
	local totalInstances = 0

	local remotes = {}
	local scripts = {}

	local function scanService(serviceName: string)
		local service: Instance? = nil
		pcall(function()
			service = game:GetService(serviceName)
		end)
		if not service then return end

		local function summarizeNode(inst: Instance, depth: number): any
			totalInstances += 1

			if inst:IsA("Script") then
				scriptCount += 1
				if includeScripts and #scripts < 30 then
					table.insert(scripts, { path = inst:GetFullName(), className = inst.ClassName })
				end
			elseif inst:IsA("LocalScript") then
				scriptCount += 1
				if includeScripts and #scripts < 30 then
					table.insert(scripts, { path = inst:GetFullName(), className = inst.ClassName })
				end
			elseif inst:IsA("ModuleScript") then
				moduleCount += 1
				if includeScripts and #scripts < 30 then
					table.insert(scripts, { path = inst:GetFullName(), className = inst.ClassName })
				end
			elseif inst:IsA("RemoteEvent") then
				remoteEventCount += 1
				if #remotes < 25 then
					table.insert(remotes, { name = inst.Name, path = inst:GetFullName(), type = "RemoteEvent" })
				end
			elseif inst:IsA("RemoteFunction") then
				remoteFunctionCount += 1
				if #remotes < 25 then
					table.insert(remotes, { name = inst.Name, path = inst:GetFullName(), type = "RemoteFunction" })
				end
			elseif inst:IsA("Model") then
				modelCount += 1
			end

			if depth >= maxDepth then
				local childCount = #inst:GetChildren()
				if childCount > 0 then
					return { _summary = string.format("%d children", childCount) }
				else
					return nil
				end
			end

			local children = inst:GetChildren()
			if #children == 0 then
				return nil
			end

			local childMap: { [string]: any } = {}
			for _, child in ipairs(children) do
				-- Only detail containers, models, folders, scripts, remotes
				if child:IsA("Folder") or child:IsA("Model") or child:IsA("LuaSourceContainer") or child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("ScreenGui") then
					childMap[child.Name .. " (" .. child.ClassName .. ")"] = summarizeNode(child, depth + 1)
				end
			end

			return childMap
		end

		servicesOverview[serviceName] = summarizeNode(service, 1)
	end

	for _, sName in ipairs(KEY_SERVICES) do
		scanService(sName)
	end

	return {
		success = true,
		placeInfo = {
			placeId = game.PlaceId,
			gameId = game.GameId,
		},
		metrics = {
			totalInstancesScanned = totalInstances,
			serverScripts = scriptCount,
			moduleScripts = moduleCount,
			remoteEvents = remoteEventCount,
			remoteFunctions = remoteFunctionCount,
			models = modelCount,
		},
		remotes = remotes,
		keyScripts = scripts,
		hierarchy = servicesOverview,
	}, nil
end

function ContextEngine.GetArchitecture(): (any, ErrorCodes.ErrorObject?)
	local remotes = {}
	local sharedModules = {}
	local serverModules = {}

	local repStorage: Instance? = nil
	pcall(function() repStorage = game:GetService("ReplicatedStorage") end)
	if repStorage then
		for _, desc in ipairs(repStorage:GetDescendants()) do
			if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") or desc:IsA("BindableEvent") then
				table.insert(remotes, { name = desc.Name, className = desc.ClassName, path = desc:GetFullName() })
			elseif desc:IsA("ModuleScript") then
				table.insert(sharedModules, { name = desc.Name, path = desc:GetFullName() })
			end
		end
	end

	local sss: Instance? = nil
	pcall(function() sss = game:GetService("ServerScriptService") end)
	if sss then
		for _, desc in ipairs(sss:GetDescendants()) do
			if desc:IsA("ModuleScript") then
				table.insert(serverModules, { name = desc.Name, path = desc:GetFullName() })
			end
		end
	end

	return {
		success = true,
		remotes = remotes,
		sharedModules = sharedModules,
		serverModules = serverModules,
	}, nil
end

return ContextEngine
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_25">
			<Properties>
				<string name="Name">HierarchyScanner</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local UuidRegistry = require(script.Parent.Parent.Addressing.UuidRegistry)
local LuauTypeCoercion = require(script.Parent.Parent.Utils.LuauTypeCoercion)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local HierarchyScanner = {}

export type TreeNode = {
	name: string,
	className: string,
	path: string,
	uuid: string,
	childrenCount: number,
	properties: { [string]: any }?,
	children: { TreeNode }?,
}

function HierarchyScanner.GetTree(params: {
	root: string?,
	depth: number?,
	includeProperties: { string }?,
	classNameFilter: { string }?,
	maxItems: number?,
}): (any, ErrorCodes.ErrorObject?)
	local rootStr = params.root or "Workspace"
	local rootInst, err = InstanceResolver.Resolve(rootStr)
	if not rootInst then
		return nil, err
	end

	local maxDepth = params.depth or 2
	local maxItems = params.maxItems or 100
	local itemCount = 0

	local filterMap: { [string]: boolean }? = nil
	if params.classNameFilter and #params.classNameFilter > 0 then
		filterMap = {}
		for _, name in ipairs(params.classNameFilter) do
			filterMap[name] = true
		end
	end

	local function scanNode(inst: Instance, currentDepth: number): TreeNode?
		if itemCount >= maxItems then
			return nil
		end
		itemCount += 1

		local node: TreeNode = {
			name = inst.Name,
			className = inst.ClassName,
			path = inst:GetFullName(),
			uuid = UuidRegistry.GetOrCreateUuid(inst),
			childrenCount = #inst:GetChildren(),
		}

		if params.includeProperties and #params.includeProperties > 0 then
			node.properties = {}
			for _, prop in ipairs(params.includeProperties) do
				pcall(function()
					local val = (inst :: any)[prop]
					if val ~= nil then
						node.properties[prop] = LuauTypeCoercion.Serialize(val)
					end
				end)
			end
		end

		if currentDepth < maxDepth then
			local childNodes = {}
			for _, child in ipairs(inst:GetChildren()) do
				if not filterMap or filterMap[child.ClassName] then
					local cNode = scanNode(child, currentDepth + 1)
					if cNode then
						table.insert(childNodes, cNode)
					end
					if itemCount >= maxItems then
						break
					end
				end
			end
			node.children = childNodes
		end

		return node
	end

	local tree = scanNode(rootInst, 0)

	return {
		success = true,
		totalItemsReturned = itemCount,
		tree = tree,
	}, nil
end

function HierarchyScanner.Search(params: {
	query: string?,
	className: string?,
	tag: string?,
	scope: string?,
	attributeName: string?,
	attributeValue: any?,
	limit: number?,
}): (any, ErrorCodes.ErrorObject?)
	local scopeStr = params.scope or "game"
	local scopeInst: Instance = game
	if scopeStr ~= "game" then
		local sInst, sErr = InstanceResolver.Resolve(scopeStr)
		if sInst then
			scopeInst = sInst
		else
			return nil, sErr
		end
	end

	local limit = params.limit or 50
	local queryLower = params.query and string.lower(params.query)
	local CollectionService = game:GetService("CollectionService")
	local results = {}

	local function checkInstance(inst: Instance)
		if #results >= limit then return end

		-- ClassName filter
		if params.className and inst.ClassName ~= params.className then
			return
		end

		-- Query name pattern
		if queryLower and not string.find(string.lower(inst.Name), queryLower) then
			return
		end

		-- Tag filter
		if params.tag and not CollectionService:HasTag(inst, params.tag) then
			return
		end

		-- Attribute filter
		if params.attributeName then
			local attr = inst:GetAttribute(params.attributeName)
			if attr == nil then return end
			if params.attributeValue ~= nil and attr ~= params.attributeValue then
				return
			end
		end

		table.insert(results, {
			name = inst.Name,
			className = inst.ClassName,
			path = inst:GetFullName(),
			uuid = UuidRegistry.GetOrCreateUuid(inst),
		})
	end

	for _, desc in ipairs(scopeInst:GetDescendants()) do
		checkInstance(desc)
		if #results >= limit then
			break
		end
	end

	return {
		success = true,
		count = #results,
		results = results,
	}, nil
end

return HierarchyScanner
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_26">
			<Properties>
				<string name="Name">Core</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_27">
			<Properties>
				<string name="Name">CommandRouter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local InstanceAdapter = require(script.Parent.Parent.Adapters.InstanceAdapter)
local PropertyAdapter = require(script.Parent.Parent.Adapters.PropertyAdapter)
local AttributeAdapter = require(script.Parent.Parent.Adapters.AttributeAdapter)
local TagAdapter = require(script.Parent.Parent.Adapters.TagAdapter)
local ScriptAdapter = require(script.Parent.Parent.Adapters.ScriptAdapter)
local SelectionAdapter = require(script.Parent.Parent.Adapters.SelectionAdapter)
local OutputAdapter = require(script.Parent.Parent.Adapters.OutputAdapter)
local PlaytestAdapter = require(script.Parent.Parent.Adapters.PlaytestAdapter)
local TerrainAdapter = require(script.Parent.Parent.Adapters.TerrainAdapter)
local HierarchyScanner = require(script.Parent.Parent.Context.HierarchyScanner)
local ContextEngine = require(script.Parent.Parent.Context.ContextEngine)
local TransactionManager = require(script.Parent.TransactionManager)
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local UuidRegistry = require(script.Parent.Parent.Addressing.UuidRegistry)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local CommandRouter = {}

type ActionHandler = (params: any) -> (any, ErrorCodes.ErrorObject?)

local actionHandlers: { [string]: ActionHandler } = {
	-- Studio / Info / Inspection
	studio_info = function(_params)
		return {
			success = true,
			placeId = game.PlaceId,
			placeName = game.Name,
			gameId = game.GameId,
			jobId = game.JobId,
			creatorId = game.CreatorId,
			creatorType = tostring(game.CreatorType),
		}, nil
	end,

	studio_get_tree = function(params)
		return HierarchyScanner.GetTree(params)
	end,

	studio_search = function(params)
		return HierarchyScanner.Search(params)
	end,

	studio_inspect = function(params)
		local inst, err = InstanceResolver.Resolve(params.target)
		if not inst then return nil, err end

		local propRes = PropertyAdapter.GetAll({ target = params.target })
		local attrRes = AttributeAdapter.GetAll({ target = params.target })
		local tagsRes = TagAdapter.GetTags({ target = params.target })

		local childSummary = {}
		for _, c in ipairs(inst:GetChildren()) do
			table.insert(childSummary, {
				name = c.Name,
				className = c.ClassName,
				uuid = UuidRegistry.GetOrCreateUuid(c),
			})
		end

		local scriptPreview: string? = nil
		if params.includeScriptSourceSnippet and (inst:IsA("LuaSourceContainer") or inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript")) then
			local sRes = ScriptAdapter.GetSource({ target = params.target })
			if sRes and sRes.source then
				local lines = string.split(sRes.source, "\n")
				local previewLines = {}
				for i = 1, math.min(20, #lines) do
					table.insert(previewLines, lines[i])
				end
				scriptPreview = table.concat(previewLines, "\n")
			end
		end

		return {
			success = true,
			uuid = UuidRegistry.GetOrCreateUuid(inst),
			name = inst.Name,
			className = inst.ClassName,
			path = inst:GetFullName(),
			parent = inst.Parent and inst.Parent:GetFullName() or "nil",
			childrenCount = #childSummary,
			children = childSummary,
			properties = propRes and propRes.properties or {},
			attributes = attrRes and attrRes.attributes or {},
			tags = tagsRes and tagsRes.tags or {},
			scriptSourcePreview = scriptPreview,
		}, nil
	end,

	-- Instance Operations
	instance_create = function(params)
		local tx = TransactionManager.BeginTransaction("Create " .. (params.className or "Instance"))
		local res, err = InstanceAdapter.Create(params)
		if res then
			TransactionManager.CommitTransaction("Create " .. (params.className or "Instance"), tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	instance_delete = function(params)
		local tx = TransactionManager.BeginTransaction("Delete " .. (params.target or "Instance"))
		local res, err = InstanceAdapter.Delete(params)
		if res then
			TransactionManager.CommitTransaction("Delete " .. (params.target or "Instance"), tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	instance_clone = function(params)
		local tx = TransactionManager.BeginTransaction("Clone " .. (params.target or "Instance"))
		local res, err = InstanceAdapter.Clone(params)
		if res then
			TransactionManager.CommitTransaction("Clone " .. (params.target or "Instance"), tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	instance_reparent = function(params)
		local tx = TransactionManager.BeginTransaction("Reparent " .. (params.target or "Instance"))
		local res, err = InstanceAdapter.Reparent(params)
		if res then
			TransactionManager.CommitTransaction("Reparent " .. (params.target or "Instance"), tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	instance_rename = function(params)
		local tx = TransactionManager.BeginTransaction("Rename " .. (params.target or "Instance"))
		local res, err = InstanceAdapter.Rename(params)
		if res then
			TransactionManager.CommitTransaction("Rename " .. (params.target or "Instance"), tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	instance_move = function(params)
		local tx = TransactionManager.BeginTransaction("Move " .. (params.target or "Instance"))
		local res, err = InstanceAdapter.Move(params)
		if res then
			TransactionManager.CommitTransaction("Move " .. (params.target or "Instance"), tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	-- Property Operations
	property_get = function(params)
		return PropertyAdapter.Get(params)
	end,

	property_set = function(params)
		local tx = TransactionManager.BeginTransaction("Set " .. (params.property or "Property"))
		local res, err = PropertyAdapter.Set(params)
		if res then
			TransactionManager.CommitTransaction("Set " .. (params.property or "Property"), tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	property_get_all = function(params)
		return PropertyAdapter.GetAll(params)
	end,

	-- Attribute Operations
	attribute_get = function(params)
		return AttributeAdapter.Get(params)
	end,

	attribute_set = function(params)
		local tx = TransactionManager.BeginTransaction("Set Attribute " .. (params.attributeName or ""))
		local res, err = AttributeAdapter.Set(params)
		if res then
			TransactionManager.CommitTransaction("Set Attribute", tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	attribute_delete = function(params)
		local tx = TransactionManager.BeginTransaction("Delete Attribute " .. (params.attributeName or ""))
		local res, err = AttributeAdapter.Delete(params)
		if res then
			TransactionManager.CommitTransaction("Delete Attribute", tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	attribute_get_all = function(params)
		return AttributeAdapter.GetAll(params)
	end,

	-- Tag Operations
	tag_add = function(params)
		return TagAdapter.Add(params)
	end,

	tag_remove = function(params)
		return TagAdapter.Remove(params)
	end,

	tag_get_tags = function(params)
		return TagAdapter.GetTags(params)
	end,

	tag_get_tagged = function(params)
		return TagAdapter.GetTagged(params)
	end,

	-- Script Operations
	script_get_source = function(params)
		return ScriptAdapter.GetSource(params)
	end,

	script_set_source = function(params)
		local tx = TransactionManager.BeginTransaction("Update Script Source " .. (params.target or ""))
		local res, err = ScriptAdapter.SetSource(params)
		if res then
			TransactionManager.CommitTransaction("Update Script Source", tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	script_patch_source = function(params)
		local tx = TransactionManager.BeginTransaction("Patch Script " .. (params.target or ""))
		local res, err = ScriptAdapter.PatchSource(params)
		if res then
			TransactionManager.CommitTransaction("Patch Script", tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	script_search_code = function(params)
		return ScriptAdapter.SearchCode(params)
	end,

	-- Selection Operations
	selection_get = function(_params)
		return SelectionAdapter.Get()
	end,

	selection_set = function(params)
		return SelectionAdapter.Set(params)
	end,

	selection_add = function(params)
		return SelectionAdapter.Add(params)
	end,

	selection_clear = function(_params)
		return SelectionAdapter.Clear()
	end,

	-- Playtest & Simulation
	playtest_control = function(params)
		return PlaytestAdapter.Control(params)
	end,

	playtest_get_state = function(_params)
		return PlaytestAdapter.GetState()
	end,

	-- Output & Error Observation
	output_get = function(params)
		return OutputAdapter.GetRecent(params)
	end,

	output_get_errors = function(params)
		return OutputAdapter.GetErrors(params)
	end,

	output_clear = function(_params)
		return OutputAdapter.Clear()
	end,

	-- Context & Summary
	context_build = function(params)
		return ContextEngine.BuildSummary(params)
	end,

	context_get_architecture = function(_params)
		return ContextEngine.GetArchitecture()
	end,

	-- Terrain Operations
	terrain_fill_block = function(params)
		local tx = TransactionManager.BeginTransaction("Terrain FillBlock")
		local res, err = TerrainAdapter.FillBlock(params)
		if res then
			TransactionManager.CommitTransaction("Terrain FillBlock", tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	terrain_fill_ball = function(params)
		local tx = TransactionManager.BeginTransaction("Terrain FillBall")
		local res, err = TerrainAdapter.FillBall(params)
		if res then
			TransactionManager.CommitTransaction("Terrain FillBall", tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	terrain_clear = function(params)
		local tx = TransactionManager.BeginTransaction("Terrain Clear")
		local res, err = TerrainAdapter.Clear(params)
		if res then
			TransactionManager.CommitTransaction("Terrain Clear", tx)
		else
			TransactionManager.CancelTransaction(tx)
		end
		return res, err
	end,

	-- Batch / Transactional Execution
	batch_execute = function(params)
		local txName = params.transactionName or "MCP Batch"
		local stopOnError = params.stopOnError ~= false
		local operations = params.operations or {}

		local tx = TransactionManager.BeginTransaction(txName)
		local results = {}
		local hasError = false
		local failureIndex = -1

		for i, op in ipairs(operations) do
			local opAction = op.action
			local opParams = op.params or {}

			local res, err = CommandRouter.Dispatch(opAction, opParams)
			if err then
				hasError = true
				failureIndex = i
				table.insert(results, {
					index = i,
					action = opAction,
					success = false,
					error = err,
				})
				if stopOnError then
					break
				end
			else
				table.insert(results, {
					index = i,
					action = opAction,
					success = true,
					result = res,
				})
			end
		end

		if hasError and stopOnError then
			TransactionManager.CancelTransaction(tx)
		else
			TransactionManager.CommitTransaction(txName, tx)
		end

		return {
			success = not (hasError and stopOnError),
			totalOperations = #operations,
			executedCount = #results,
			hasError = hasError,
			failureIndex = failureIndex > 0 and failureIndex or nil,
			results = results,
		}, nil
	end,
}

function CommandRouter.Dispatch(action: string, params: any): (any, ErrorCodes.ErrorObject?)
	local handler = actionHandlers[action]
	if not handler then
		return nil, ErrorCodes.Create(
			ErrorCodes.UNSUPPORTED_OPERATION,
			string.format("Action '%s' is not supported by Universal Studio API.", action),
			{ action = action }
		)
	end

	local success, result, err = pcall(function()
		return handler(params or {})
	end)

	if not success then
		return nil, ErrorCodes.Create(
			ErrorCodes.INTERNAL_ERROR,
			string.format("Exception executing '%s': %s", action, tostring(result)),
			{ action = action, trace = debug.traceback() }
		)
	end

	return result, err
end

return CommandRouter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_28">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Core Plugin Configuration

local Config = {
	Host = "http://127.0.0.1",
	Port = 38883,
	PollInterval = 0.15,
	ActivePollInterval = 0.02,
	HandshakeRetryInterval = 3.0,
	MaxBatchSize = 50,
	DebugMode = true,
	EventBatchInterval = 0.1,
	MaxLogBuffer = 200,
}

function Config.GetBaseUrl(): string
	return string.format("%s:%d", Config.Host, Config.Port)
end

return Config
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_29">
			<Properties>
				<string name="Name">Errors</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Standardized Error Codes matching prompt specification

local Errors = {
	PLUGIN_NOT_INITIALIZED = "PLUGIN_NOT_INITIALIZED",
	MCP_NOT_CONNECTED = "MCP_NOT_CONNECTED",
	INVALID_REQUEST = "INVALID_REQUEST",
	INVALID_ARGUMENT = "INVALID_ARGUMENT",
	INSTANCE_NOT_FOUND = "INSTANCE_NOT_FOUND",
	INSTANCE_AMBIGUOUS = "INSTANCE_AMBIGUOUS",
	PROPERTY_NOT_FOUND = "PROPERTY_NOT_FOUND",
	PROPERTY_NOT_WRITABLE = "PROPERTY_NOT_WRITABLE",
	SCRIPT_NOT_EDITABLE = "SCRIPT_NOT_EDITABLE",
	SCRIPT_PATCH_FAILED = "SCRIPT_PATCH_FAILED",
	UNSUPPORTED_API = "UNSUPPORTED_API",
	SECURITY_RESTRICTION = "SECURITY_RESTRICTION",
	ROBLOX_API_ERROR = "ROBLOX_API_ERROR",
	HTTP_PERMISSION_ERROR = "HTTP_PERMISSION_ERROR",
	TRANSPORT_ERROR = "TRANSPORT_ERROR",
	TIMEOUT = "TIMEOUT",
	INTERNAL_ERROR = "INTERNAL_ERROR",
}

export type ErrorObject = {
	code: string,
	message: string,
	details: { [string]: any }?,
	target: string?,
}

function Errors.Create(code: string, message: string, details: { [string]: any }?, target: string?): ErrorObject
	return {
		code = code,
		message = message,
		details = details or {},
		target = target,
	}
end

return Errors
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_30">
			<Properties>
				<string name="Name">ExecutionQueue</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local ExecutionQueue = {}

type QueuedTask = {
	execute: () -> (),
}

local queue: { QueuedTask } = {}
local isProcessing = false

function ExecutionQueue.Enqueue(taskFn: () -> ())
	table.insert(queue, { execute = taskFn })
	if not isProcessing then
		task.spawn(ExecutionQueue.ProcessNext)
	end
end

function ExecutionQueue.ProcessNext()
	if isProcessing or #queue == 0 then return end
	isProcessing = true

	while #queue > 0 do
		local currentTask = table.remove(queue, 1)
		if currentTask then
			local success, err = pcall(currentTask.execute)
			if not success then
				warn("[ExecutionQueue] Error executing queued task:", err)
			end
		end
		task.wait()
	end

	isProcessing = false
end

return ExecutionQueue
]]></ProtectedString>
			</Properties>
