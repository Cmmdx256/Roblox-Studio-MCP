		writableProperties = { "SoundId", "Volume", "PlaybackSpeed", "Looped", "Playing", "TimePosition" },
		events = { "Played", "Stopped", "Ended" },
	},

	-- 6. Value Objects
	["StringValue"] = { name = "StringValue", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
	["IntValue"] = { name = "IntValue", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
	["NumberValue"] = { name = "NumberValue", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
	["BoolValue"] = { name = "BoolValue", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
	["ObjectValue"] = { name = "ObjectValue", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
	["CFrameValue"] = { name = "CFrameValue", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
	["Vector3Value"] = { name = "Vector3Value", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
	["Color3Value"] = { name = "Color3Value", category = "Values", superClass = "ValueBase", security = "None", creatable = true, readableProperties = { "Value" }, writableProperties = { "Value" }, events = { "Changed" } },
}

function CapabilityCatalog.GetClass(className: string): ClassSpec?
	return classCatalog[className]
end

function CapabilityCatalog.GetAllClasses(): { [string]: ClassSpec }
	return classCatalog
end

function CapabilityCatalog.IsCreatable(className: string): boolean
	local spec = classCatalog[className]
	return spec ~= nil and spec.creatable
end

return CapabilityCatalog
