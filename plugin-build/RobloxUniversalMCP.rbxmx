		local tx = ChangeHistoryAdapter.BeginRecording("Set Attribute " .. (params.attributeName or ""))
		local res, err = AttributeAdapter.Set(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["attribute_set"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Set Attribute " .. (params.attributeName or ""))
		local res, err = AttributeAdapter.Set(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["attribute.delete"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Delete Attribute " .. (params.attributeName or ""))
		local res, err = AttributeAdapter.Delete(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["attribute_delete"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Delete Attribute " .. (params.attributeName or ""))
		local res, err = AttributeAdapter.Delete(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,

	-- 8. Selection
	["selection.get"] = function(_params)
		return SelectionAdapter.Get()
	end,
	["selection_get"] = function(_params)
		return SelectionAdapter.Get()
	end,
	["selection.set"] = function(params)
		local instances = {}
		if params.targets then
			for _, t in ipairs(params.targets) do
				local inst = InstanceAdapter.Resolve(t)
				if inst then table.insert(instances, inst) end
			end
		end
		return SelectionAdapter.Set(instances)
	end,
	["selection_set"] = function(params)
		local instances = {}
		if params.targets then
			for _, t in ipairs(params.targets) do
				local inst = InstanceAdapter.Resolve(t)
				if inst then table.insert(instances, inst) end
			end
		end
		return SelectionAdapter.Set(instances)
	end,
	["selection_add"] = function(params)
		local instances = {}
		if params.targets then
			for _, t in ipairs(params.targets) do
				local inst = InstanceAdapter.Resolve(t)
				if inst then table.insert(instances, inst) end
			end
		end
		return SelectionAdapter.Add(instances)
	end,
	["selection.clear"] = function(_params)
		return SelectionAdapter.Clear()
	end,
	["selection_clear"] = function(_params)
		return SelectionAdapter.Clear()
	end,

	-- 9. Scripts
	["script.get_source"] = function(params)
		return ScriptAdapter.GetSource(params)
	end,
	["script_get_source"] = function(params)
		return ScriptAdapter.GetSource(params)
	end,
	["script.set_source"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Update Script " .. (params.target or ""))
		local res, err = ScriptAdapter.SetSource(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["script_set_source"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Update Script " .. (params.target or ""))
		local res, err = ScriptAdapter.SetSource(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["script.patch"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Patch Script " .. (params.target or ""))
		local res, err = ScriptAdapter.PatchSource(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["script_patch_source"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Patch Script " .. (params.target or ""))
		local res, err = ScriptAdapter.PatchSource(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["script.search"] = function(params)
		return ScriptAdapter.SearchCode(params)
	end,
	["script_search_code"] = function(params)
		return ScriptAdapter.SearchCode(params)
	end,

	-- 10. Terrain
	["terrain_fill_block"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Terrain FillBlock")
		local res, err = TerrainAdapter.FillBlock(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["terrain_fill_ball"] = function(params)
		local tx = ChangeHistoryAdapter.BeginRecording("Terrain FillBall")
		local res, err = TerrainAdapter.FillBall(params)
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,
	["terrain_clear"] = function(_params)
		local tx = ChangeHistoryAdapter.BeginRecording("Terrain Clear")
		local res, err = TerrainAdapter.Clear()
		ChangeHistoryAdapter.FinishRecording(tx, res ~= nil)
		return res, err
	end,

	-- 11. Playtest & Simulation Control
	["playtest.state"] = function(_params)
		return PlaytestAdapter.GetState()
	end,
	["playtest_get_state"] = function(_params)
		return PlaytestAdapter.GetState()
	end,
	["playtest.control"] = function(params)
		return PlaytestAdapter.Control(params)
	end,
	["playtest_control"] = function(params)
		return PlaytestAdapter.Control(params)
	end,

	-- 12. Studio Console Output & Diagnostics
	["output.get"] = function(params)
		return OutputAdapter.GetRecent(params)
	end,
	["output_get"] = function(params)
		return OutputAdapter.GetRecent(params)
	end,
	["output.errors"] = function(params)
		return OutputAdapter.GetRecent({ limit = params.limit or 50, filterType = "MessageError" })
	end,
	["output_get_errors"] = function(params)
		return OutputAdapter.GetRecent({ limit = params.limit or 50, filterType = "MessageError" })
	end,
	["output.clear"] = function(_params)
		return OutputAdapter.Clear()
	end,
	["output_clear"] = function(_params)
		return OutputAdapter.Clear()
	end,

	-- 13. Batch Operations
	["batch.execute"] = function(params)
		local actions = params.actions or {}
		local tx = ChangeHistoryAdapter.BeginRecording("Batch MCP Execution (" .. #actions .. " actions)")
		local results = {}
		local overallSuccess = true

		for i, item in ipairs(actions) do
			local h = handlers[item.action]
			if h then
				local res, err = h(item.params or {})
				table.insert(results, { index = i, action = item.action, success = (err == nil), result = res, error = err })
				if err and params.stopOnError then
					overallSuccess = false
					break
				end
			else
				table.insert(results, { index = i, action = item.action, success = false, error = { code = "UNSUPPORTED_API", message = "Action not supported: " .. tostring(item.action) } })
				if params.stopOnError then
					overallSuccess = false
					break
				end
			end
		end

		ChangeHistoryAdapter.FinishRecording(tx, overallSuccess)
		return { success = overallSuccess, count = #results, results = results }, nil
	end,
	["batch_execute"] = function(params)
		local actions = params.actions or {}
		local tx = ChangeHistoryAdapter.BeginRecording("Batch MCP Execution (" .. #actions .. " actions)")
		local results = {}
		local overallSuccess = true

		for i, item in ipairs(actions) do
			local h = handlers[item.action]
			if h then
				local res, err = h(item.params or {})
				table.insert(results, { index = i, action = item.action, success = (err == nil), result = res, error = err })
				if err and params.stopOnError then
					overallSuccess = false
					break
				end
			else
				table.insert(results, { index = i, action = item.action, success = false, error = { code = "UNSUPPORTED_API", message = "Action not supported: " .. tostring(item.action) } })
				if params.stopOnError then
					overallSuccess = false
					break
				end
			end
		end

		ChangeHistoryAdapter.FinishRecording(tx, overallSuccess)
		return { success = overallSuccess, count = #results, results = results }, nil
	end,
}

function Router.Dispatch(action: string, params: any): (any, Errors.ErrorObject?)
	local handler = handlers[action]
	if not handler then
		return nil, Errors.Create(
			Errors.UNSUPPORTED_API,
			string.format("Action '%s' is not supported by Universal Studio API.", action)
		)
	end

	local success, result, err = pcall(function()
		return handler(params or {})
	end)

	if not success then
		return nil, Errors.Create(
			Errors.INTERNAL_ERROR,
			string.format("Exception executing '%s': %s", action, tostring(result))
		)
	end

	return result, err
end

return Router
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_48">
			<Properties>
				<string name="Name">Transport</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- MCP Transport: Polling HTTP communication with local MCP Bridge and live event streaming

local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local State = require(script.Parent.Parent.Core.State)
local Config = require(script.Parent.Parent.Core.Config)
local Logger = require(script.Parent.Parent.Core.Logger)
local Router = require(script.Parent.Router)
local ObservationEngine = require(script.Parent.Parent.Engine.ObservationEngine)
local StudioAdapter = require(script.Parent.Parent.Studio.StudioAdapter)

local Transport = {}

local isRunning = false
local hasShownActivationAlert = false

function Transport.ShowActivationAlert(baseUrl: string)
	if hasShownActivationAlert then return end
	hasShownActivationAlert = true

	-- 1. Studio Bottom-Right Notification Toast
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "⚡ Universal MCP Aktif!",
			Text = string.format("%s üzerinde bağlandı!", baseUrl),
			Duration = 8,
			Icon = "rbxasset://textures/ui/Settings/MenuBar/SettingsButton.png",
		})
	end)

	-- 2. Console Big Banner
	print(string.format([[

===================================================================
⚡ ROBLOX STUDIO UNIVERSAL MCP BRIDGE AKTİF EDİLDİ!
-------------------------------------------------------------------
🌐 Adres: %s
🎯 Durum: AI Agent (Claude / Cursor) projenizi yönetmeye hazır!
===================================================================
]], baseUrl))
end

function Transport.Handshake(): boolean
	local realPlaceName = StudioAdapter.ResolvePlaceName()
	local url = Config.GetBaseUrl() .. "/api/handshake"
	local payload = {
		sessionId = State.SessionId,
		placeId = game.PlaceId,
		placeName = realPlaceName,
		gameId = game.GameId,
		studioVersion = version(),
		mode = "Edit",
	}

	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
	end)

	if success and response and response.StatusCode == 200 then
		State.SetSubsystem("HTTP", "OK")
		State.SetSubsystem("MCP", "CONNECTED")
		Logger.Log("Connected to MCP Bridge at", Config.GetBaseUrl())
		Transport.ShowActivationAlert(Config.GetBaseUrl())
		return true
	else
		local rawErr = tostring(response and response.StatusMessage or response or "")
		if string.find(rawErr:lower(), "not allowed") or string.find(rawErr:lower(), "http") then
			State.SetSubsystem("HTTP", "BLOCKED")
			Logger.Warn("⚠️ Please enable 'Allow HTTP Requests' in Game Settings > Security!")
		else
			State.SetSubsystem("HTTP", "READY")
		end
		State.SetSubsystem("MCP", "OFFLINE")
		return false
	end
end

function Transport.SendResponse(payload: { [string]: any })
	local url = Config.GetBaseUrl() .. "/api/response"
	pcall(function()
		HttpService:RequestAsync({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
	end)
end

function Transport.Start()
	if isRunning then return end
	isRunning = true

	task.spawn(function()
		while isRunning and not Transport.Handshake() do
			task.wait(Config.HandshakeRetryInterval)
		end

		local pollUrl = Config.GetBaseUrl() .. "/api/poll"

		while isRunning do
			local events = ObservationEngine.DrainEvents(25)
			local pollPayload = {
				sessionId = State.SessionId,
				events = events,
			}

			local success, response = pcall(function()
				return HttpService:RequestAsync({
					Url = pollUrl,
					Method = "POST",
					Headers = { ["Content-Type"] = "application/json" },
					Body = HttpService:JSONEncode(pollPayload),
				})
			end)

			if success and response and response.StatusCode == 200 then
				State.SetSubsystem("MCP", "CONNECTED")
				local decodeSuccess, data = pcall(function()
					return HttpService:JSONDecode(response.Body)
				end)

				if decodeSuccess and data and data.commands and #data.commands > 0 then
					for _, cmd in ipairs(data.commands) do
						task.spawn(function()
							Logger.Log(string.format("Executing '%s' (ID: %s)", cmd.action, cmd.id))
							local result, err = Router.Dispatch(cmd.action, cmd.params)
							if err then
								Logger.Warn(string.format("Command '%s' failed: %s", cmd.action, err.message))
								Transport.SendResponse({ id = cmd.id, success = false, error = err })
							else
								Logger.Log(string.format("Command '%s' succeeded", cmd.action))
								Transport.SendResponse({ id = cmd.id, success = true, result = result })
							end
						end)
					end
					task.wait(Config.ActivePollInterval)
					continue
				end

				task.wait(Config.PollInterval)
			else
				State.SetSubsystem("MCP", "OFFLINE")
				task.wait(Config.HandshakeRetryInterval)
				Transport.Handshake()
			end
		end
	end)
end

function Transport.Stop()
	isRunning = false
	State.SetSubsystem("MCP", "OFFLINE")
end

return Transport
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_49">
			<Properties>
				<string name="Name">Observation</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_50">
			<Properties>
				<string name="Name">EventObserver</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Selection = game:GetService("Selection")
local OutputAdapter = require(script.Parent.Parent.Adapters.OutputAdapter)
local UuidRegistry = require(script.Parent.Parent.Addressing.UuidRegistry)
local Logger = require(script.Parent.Parent.Utils.Logger)

local EventObserver = {}

export type StudioEvent = {
	type: string,
	timestamp: number,
	data: { [string]: any },
}

local eventQueue: { StudioEvent } = {}
local isInitialized = false

function EventObserver.Initialize()
	if isInitialized then return end
	isInitialized = true

	-- 1. Initialize Output/Error observation
	OutputAdapter.Initialize()
	OutputAdapter.OnLog(function(logItem)
		EventObserver.PushEvent("log", {
			message = logItem.message,
			messageType = logItem.messageType,
			traceback = logItem.traceback,
		})
	end)

	-- 2. Selection Changed Observer
	pcall(function()
		Selection.SelectionChanged:Connect(function()
			local selected = Selection:Get()
			local items = {}
			for _, inst in ipairs(selected) do
				table.insert(items, {
					path = inst:GetFullName(),
					className = inst.ClassName,
					name = inst.Name,
					uuid = UuidRegistry.GetOrCreateUuid(inst),
				})
			end
			EventObserver.PushEvent("selection_changed", {
				count = #items,
				selection = items,
			})
		end)
	end)

	-- 3. Descendant Added / Removed (limited to key top-level services to prevent engine spam)
	local function observeService(serviceName: string)
		pcall(function()
			local s = game:GetService(serviceName)
			s.DescendantAdded:Connect(function(desc: Instance)
				-- Ignore CoreGui or internal instances
				if not desc:IsDescendantOf(game) then return end
				EventObserver.PushEvent("instance_added", {
					path = desc:GetFullName(),
					className = desc.ClassName,
					name = desc.Name,
					parent = desc.Parent and desc.Parent:GetFullName() or "nil",
				})
			end)

			s.DescendantRemoving:Connect(function(desc: Instance)
				EventObserver.PushEvent("instance_removing", {
					path = desc:GetFullName(),
					className = desc.ClassName,
					name = desc.Name,
				})
			end)
		end)
	end

	observeService("Workspace")
	observeService("ReplicatedStorage")
	observeService("ServerScriptService")
	observeService("StarterGui")

	Logger.Log("Event observers active.")
end

function EventObserver.PushEvent(eventType: string, data: { [string]: any })
	local ev: StudioEvent = {
		type = eventType,
		timestamp = os.time(),
		data = data,
	}
	table.insert(eventQueue, ev)
	-- Keep buffer bounded
	if #eventQueue > 100 then
		table.remove(eventQueue, 1)
	end
end

function EventObserver.FlushEvents(): { StudioEvent }
	if #eventQueue == 0 then
		return {}
	end
	local flushed = eventQueue
	eventQueue = {}
	return flushed
end

return EventObserver
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_51">
			<Properties>
				<string name="Name">Studio</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_52">
			<Properties>
				<string name="Name">AttributeAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Attribute Adapter: Luau Attribute CRUD

local Errors = require(script.Parent.Parent.Core.Errors)
local Utils = require(script.Parent.Parent.Core.Utils)
local InstanceAdapter = require(script.Parent.InstanceAdapter)

local AttributeAdapter = {}

function AttributeAdapter.Get(params: { target: string, attributeName: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local val = inst:GetAttribute(params.attributeName)
	return {
		success = true,
		attributeName = params.attributeName,
		value = Utils.Serialize(val),
	}, nil
end

function AttributeAdapter.GetAll(params: { target: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local attributes: { [string]: any } = {}
	for k, v in pairs(inst:GetAttributes()) do
		attributes[k] = Utils.Serialize(v)
	end

	return {
		success = true,
		target = inst:GetFullName(),
		attributes = attributes,
	}, nil
end

function AttributeAdapter.Set(params: { target: string, attributeName: string, value: any }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local coerced = Utils.Coerce(params.value)
	local success, setErr = pcall(function()
		inst:SetAttribute(params.attributeName, coerced)
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Failed to set attribute '%s': %s", params.attributeName, tostring(setErr)))
	end

	return {
		success = true,
		attributeName = params.attributeName,
		newValue = Utils.Serialize(inst:GetAttribute(params.attributeName)),
	}, nil
end

function AttributeAdapter.Delete(params: { target: string, attributeName: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local success, delErr = pcall(function()
		inst:SetAttribute(params.attributeName, nil)
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Failed to delete attribute '%s': %s", params.attributeName, tostring(delErr)))
	end

	return {
		success = true,
		deleted = true,
		attributeName = params.attributeName,
	}, nil
end

return AttributeAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_53">
			<Properties>
				<string name="Name">ChangeHistoryAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ChangeHistory Adapter for native Studio Undo/Redo recording

local Errors = require(script.Parent.Parent.Core.Errors)

local ChangeHistoryAdapter = {}

local activeRecordings = {}

local function getService(): ChangeHistoryService?
	local success, s = pcall(function()
		return game:GetService("ChangeHistoryService")
	end)
	return success and s or nil
end

function ChangeHistoryAdapter.BeginRecording(name: string): any
	local s = getService()
	if not s then return nil end

	local recordingId = nil
	local success = pcall(function()
		recordingId = (s :: any):TryBeginRecording(name or "MCP Operation")
	end)

	if success and recordingId then
		table.insert(activeRecordings, recordingId)
		return recordingId
	else
		-- Fallback to waypoint
		pcall(function()
			s:SetWaypoint(name or "MCP Operation")
		end)
		return nil
	end
end

function ChangeHistoryAdapter.FinishRecording(recordingId: any, commit: boolean?)
	local s = getService()
	if not s then return end

	if recordingId then
		local op = commit ~= false and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel
		pcall(function()
			(s :: any):FinishRecording(recordingId, op)
		end)
	else
		if commit ~= false then
			pcall(function()
				s:SetWaypoint("MCP Operation Complete")
			end)
		end
	end
end

return ChangeHistoryAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_54">
			<Properties>
				<string name="Name">InstanceAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Instance Adapter: Generic manipulation of Roblox Instances

local Errors = require(script.Parent.Parent.Core.Errors)
local Utils = require(script.Parent.Parent.Core.Utils)

local InstanceAdapter = {}

local SERVICES: { [string]: string } = {
	Workspace = "Workspace",
	workspace = "Workspace",
	ReplicatedStorage = "ReplicatedStorage",
	ServerScriptService = "ServerScriptService",
	ServerStorage = "ServerStorage",
	StarterGui = "StarterGui",
	StarterPack = "StarterPack",
	StarterPlayer = "StarterPlayer",
	Lighting = "Lighting",
	SoundService = "SoundService",
	MaterialService = "MaterialService",
	Chat = "Chat",
	Players = "Players",
	Teams = "Teams",
	TestService = "TestService",
	CollectionService = "CollectionService",
	ReplicatedFirst = "ReplicatedFirst",
}

function InstanceAdapter.Resolve(target: string): (Instance?, Errors.ErrorObject?)
	if not target or type(target) ~= "string" or #target == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Target path must be a non-empty string.")
	end

	if target == "game" or target == "DataModel" then
		return game, nil
	end

	local path = target
	if path:sub(1, 5) == "game." then
		path = path:sub(6)
	end

	local segments = string.split(path, ".")
	if #segments == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Invalid target path: " .. target)
	end

	local firstSegment = segments[1]
	local current: Instance? = nil

	local serviceName = SERVICES[firstSegment]
	if serviceName then
		pcall(function()
			current = game:GetService(serviceName)
		end)
	end

	if not current then
		current = game:FindFirstChild(firstSegment)
	end

	if not current then
		return nil, Errors.Create(Errors.INSTANCE_NOT_FOUND, string.format("Root container '%s' not found.", firstSegment), { target = target })
	end

	for i = 2, #segments do
		local seg = segments[i]
		if not current then break end

		local name, indexStr = seg:match("^(.-)%[(%d+)%]$")
		if name and indexStr then
			local targetIndex = tonumber(indexStr) or 1
			local matches = {}
			for _, child in ipairs(current:GetChildren()) do
				if child.Name == name then
					table.insert(matches, child)
				end
			end
			current = matches[targetIndex]
		else
			current = current:FindFirstChild(seg)
		end

		if not current then
			return nil, Errors.Create(
				Errors.INSTANCE_NOT_FOUND,
				string.format("Child '%s' not found under '%s'.", seg, segments[i - 1]),
				{ target = target, failedAt = seg }
			)
		end
	end

	return current, nil
end

function InstanceAdapter.Create(params: {
	className: string,
	parent: string,
	name: string?,
	properties: { [string]: any }?,
	attributes: { [string]: any }?,
	tags: { string }?,
}): (any, Errors.ErrorObject?)
	if not params.className or #params.className == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Parameter 'className' is required.")
	end
	if not params.parent or #params.parent == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Parameter 'parent' is required.")
	end

	local parentInst, parentErr = InstanceAdapter.Resolve(params.parent)
	if not parentInst then
		return nil, parentErr
	end

	local newInst: Instance
	local success, err = pcall(function()
		newInst = Instance.new(params.className)
	end)

	if not success or not newInst then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Cannot create Instance of ClassName '%s': %s", params.className, tostring(err)))
	end

	if params.name and #params.name > 0 then
		newInst.Name = params.name
	end

	if params.properties then
		for propName, rawVal in pairs(params.properties) do
			pcall(function()
				(newInst :: any)[propName] = Utils.Coerce(rawVal)
			end)
		end
	end

	if params.attributes then
		for attrName, val in pairs(params.attributes) do
			pcall(function()
				newInst:SetAttribute(attrName, Utils.Coerce(val))
			end)
		end
	end

	if params.tags then
		local cs: CollectionService? = nil
		pcall(function() cs = game:GetService("CollectionService") end)
		if cs then
			for _, tag in ipairs(params.tags) do
				cs:AddTag(newInst, tag)
			end
		end
	end

	local pSuccess, pErr = pcall(function()
		newInst.Parent = parentInst
	end)
	if not pSuccess then
		newInst:Destroy()
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Failed to parent new instance to '%s': %s", params.parent, tostring(pErr)))
	end

	return {
		success = true,
		name = newInst.Name,
		className = newInst.ClassName,
		path = newInst:GetFullName(),
	}, nil
end

function InstanceAdapter.Delete(params: { target: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if inst == game or inst == workspace then
		return nil, Errors.Create(Errors.SECURITY_RESTRICTION, "Cannot destroy root Game or Workspace container.")
	end

	local name = inst.Name
	local className = inst.ClassName
	local path = inst:GetFullName()

	local success, delErr = pcall(function()
		inst:Destroy()
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Failed to destroy '%s': %s", path, tostring(delErr)))
	end

	return {
		success = true,
		deleted = true,
		name = name,
		className = className,
		path = path,
	}, nil
end

function InstanceAdapter.Clone(params: {
	target: string,
	parent: string?,
	newName: string?,
	properties: { [string]: any }?,
}): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local cloned: Instance
	local success, cloneErr = pcall(function()
		cloned = inst:Clone()
	end)

	if not success or not cloned then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Failed to clone '%s': %s", params.target, tostring(cloneErr)))
	end

	if params.newName and #params.newName > 0 then
		cloned.Name = params.newName
	end

	if params.properties then
		for propName, rawVal in pairs(params.properties) do
			pcall(function()
				(cloned :: any)[propName] = Utils.Coerce(rawVal)
			end)
		end
	end

	local targetParent = inst.Parent or workspace
	if params.parent then
		local pInst, pErr = InstanceAdapter.Resolve(params.parent)
		if pInst then
			targetParent = pInst
		else
			cloned:Destroy()
			return nil, pErr
		end
	end

	cloned.Parent = targetParent

	return {
		success = true,
		name = cloned.Name,
		className = cloned.ClassName,
		path = cloned:GetFullName(),
	}, nil
end

function InstanceAdapter.Reparent(params: { target: string, newParent: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then return nil, err end

	local parentInst, parentErr = InstanceAdapter.Resolve(params.newParent)
	if not parentInst then return nil, parentErr end

	local success, setErr = pcall(function()
		inst.Parent = parentInst
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Failed to reparent '%s' to '%s': %s", params.target, params.newParent, tostring(setErr)))
	end

	return {
		success = true,
		target = inst:GetFullName(),
		newParent = parentInst:GetFullName(),
	}, nil
end

function InstanceAdapter.Rename(params: { target: string, newName: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then return nil, err end

	if not params.newName or #params.newName == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Parameter 'newName' is required.")
	end

	local oldName = inst.Name
	local success, renErr = pcall(function()
		inst.Name = params.newName
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, string.format("Failed to rename '%s': %s", oldName, tostring(renErr)))
	end

	return {
		success = true,
		oldName = oldName,
		newName = inst.Name,
		path = inst:GetFullName(),
	}, nil
end

function InstanceAdapter.Move(params: { target: string, position: any?, cframe: any? }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then return nil, err end

	if params.cframe then
		local cf = Utils.Coerce(params.cframe, "CFrame")
		if inst:IsA("PVInstance") then
			inst:PivotTo(cf)
		elseif inst:IsA("BasePart") then
			inst.CFrame = cf
		end
	elseif params.position then
		local pos = Utils.Coerce(params.position, "Vector3")
		if inst:IsA("Model") then
			inst:MoveTo(pos)
		elseif inst:IsA("BasePart") then
			inst.Position = pos
		end
	end

	return {
		success = true,
		target = inst:GetFullName(),
	}, nil
end

function InstanceAdapter.Inspect(params: { target: string, includeChildren: boolean? }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local children = {}
	if params.includeChildren ~= false then
		for _, c in ipairs(inst:GetChildren()) do
			table.insert(children, {
				name = c.Name,
				className = c.ClassName,
			})
		end
	end

	local attributes = {}
	pcall(function()
		for k, v in pairs(inst:GetAttributes()) do
			attributes[k] = Utils.Serialize(v)
		end
	end)

	local tags = {}
	pcall(function()
		local cs = game:GetService("CollectionService")
		tags = cs:GetTags(inst)
	end)

	local PropertyAdapter = require(script.Parent.PropertyAdapter)
	local propResult = PropertyAdapter.GetAll({ target = params.target })

	return {
		success = true,
		name = inst.Name,
		className = inst.ClassName,
		path = inst:GetFullName(),
		parent = inst.Parent and inst.Parent:GetFullName() or "nil",
		childrenCount = #inst:GetChildren(),
		children = children,
		attributes = attributes,
		tags = tags,
		properties = propResult and propResult.properties or {},
	}, nil
end

function InstanceAdapter.GetChildren(params: { target: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local children = {}
	for _, c in ipairs(inst:GetChildren()) do
		table.insert(children, {
			name = c.Name,
			className = c.ClassName,
			path = c:GetFullName(),
		})
	end

	return {
		success = true,
		target = inst:GetFullName(),
		count = #children,
		children = children,
	}, nil
end

function InstanceAdapter.GetDescendants(params: { target: string, limit: number? }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local maxCount = params.limit or 200
	local descendants = {}

	for _, d in ipairs(inst:GetDescendants()) do
		table.insert(descendants, {
			name = d.Name,
			className = d.ClassName,
			path = d:GetFullName(),
		})
		if #descendants >= maxCount then break end
	end

	return {
		success = true,
		target = inst:GetFullName(),
		count = #descendants,
		descendants = descendants,
	}, nil
end

return InstanceAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_55">
			<Properties>
				<string name="Name">PropertyAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Property Adapter: Safe reflection, type checking, and coercion

local Errors = require(script.Parent.Parent.Core.Errors)
local Utils = require(script.Parent.Parent.Core.Utils)
local InstanceAdapter = require(script.Parent.InstanceAdapter)

local PropertyAdapter = {}

local COMMON_PROPERTIES = {
	"Name", "ClassName", "Archivable",
	-- BasePart
	"Position", "CFrame", "Orientation", "Size", "PivotOffset",
	"Color", "BrickColor", "Material", "Transparency", "Reflectance",
	"Anchored", "CanCollide", "CanTouch", "CanQuery", "Massless", "CastShadow",
	-- Model
	"PrimaryPart", "WorldPivot",
	-- GuiObject
	"Position", "Size", "AnchorPoint", "Visible", "ZIndex", "LayoutOrder",
	"BackgroundColor3", "BackgroundTransparency", "BorderSizePixel", "BorderColor3",
	"Text", "TextColor3", "TextSize", "Font", "TextWrapped", "TextScaled", "TextXAlignment", "TextYAlignment",
	"Image", "ImageColor3", "ImageTransparency",
	-- Light
	"Brightness", "Color", "Range", "Shadows", "Angle",
	-- Sound
	"SoundId", "Volume", "PlaybackSpeed", "Playing", "Looped", "TimePosition",
	-- Values
	"Value",
	-- ParticleEmitter
	"Texture", "Rate", "Lifetime", "Speed", "SpreadAngle", "Enabled",
	-- Highlight
	"FillColor", "FillTransparency", "OutlineColor", "OutlineTransparency", "DepthMode",
}

function PropertyAdapter.Get(params: { target: string, property: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not params.property or #params.property == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Parameter 'property' is required.")
	end

	local rawVal: any
	local success, readErr = pcall(function()
		rawVal = (inst :: any)[params.property]
	end)

	if not success then
		return nil, Errors.Create(
			Errors.PROPERTY_NOT_FOUND,
			string.format("Property '%s' does not exist or is not readable on '%s': %s", params.property, inst.ClassName, tostring(readErr)),
			{ property = params.property, className = inst.ClassName },
			params.target
		)
	end

	return {
		success = true,
		property = params.property,
		value = Utils.Serialize(rawVal),
		rawType = typeof(rawVal),
	}, nil
end

function PropertyAdapter.GetAll(params: { target: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local properties: { [string]: any } = {}

	for _, propName in ipairs(COMMON_PROPERTIES) do
		pcall(function()
			local val = (inst :: any)[propName]
			if val ~= nil then
				properties[propName] = Utils.Serialize(val)
			end
		end)
	end

	return {
		success = true,
		target = inst:GetFullName(),
		className = inst.ClassName,
		properties = properties,
	}, nil
end

function PropertyAdapter.Set(params: { target: string, property: string, value: any }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not params.property or #params.property == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Parameter 'property' is required.")
	end

	local existingType: string? = nil
	pcall(function()
		local val = (inst :: any)[params.property]
		if val ~= nil then
			existingType = typeof(val)
		end
	end)

	local coercedVal = Utils.Coerce(params.value, existingType)

	local success, setErr = pcall(function()
		(inst :: any)[params.property] = coercedVal
	end)

	if not success then
		return nil, Errors.Create(
			Errors.PROPERTY_NOT_WRITABLE,
			string.format("Failed to set property '%s' on '%s' (%s): %s", params.property, inst.Name, inst.ClassName, tostring(setErr)),
			{ property = params.property, value = params.value, className = inst.ClassName },
			params.target
		)
	end

	local updatedVal: any = nil
	pcall(function()
		updatedVal = (inst :: any)[params.property]
	end)

	return {
		success = true,
		property = params.property,
		newValue = Utils.Serialize(updatedVal),
	}, nil
end

return PropertyAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_56">
			<Properties>
				<string name="Name">ScriptAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Script Adapter: Verified reading and writing of Script, LocalScript, ModuleScript source

local ScriptEditorService = game:GetService("ScriptEditorService")
local Errors = require(script.Parent.Parent.Core.Errors)
local InstanceAdapter = require(script.Parent.InstanceAdapter)

local ScriptAdapter = {}

local function isScriptInstance(inst: Instance): boolean
	return inst:IsA("LuaSourceContainer") or inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript")
end

function ScriptAdapter.GetSource(params: { target: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not isScriptInstance(inst) then
		return nil, Errors.Create(
			Errors.INVALID_ARGUMENT,
			string.format("Instance '%s' (%s) is not a Script, LocalScript, or ModuleScript.", inst.Name, inst.ClassName),
			nil,
			params.target
		)
	end

	local source: string? = nil

	-- 1. Try modern ScriptEditorService
	pcall(function()
		source = ScriptEditorService:GetEditorSource(inst :: any)
	end)

	-- 2. Fallback to Script.Source
	if source == nil then
		local success, readErr = pcall(function()
			source = (inst :: any).Source
		end)
		if not success or source == nil then
			return nil, Errors.Create(
				Errors.SCRIPT_NOT_EDITABLE,
				string.format("Cannot read source of '%s': %s", params.target, tostring(readErr)),
				nil,
				params.target
			)
		end
	end

	local lines = string.split(source, "\n")

	return {
		success = true,
		target = inst:GetFullName(),
		className = inst.ClassName,
		lineCount = #lines,
		characterCount = #source,
		source = source,
	}, nil
end

function ScriptAdapter.SetSource(params: { target: string, source: string }): (any, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not isScriptInstance(inst) then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, string.format("Instance '%s' is not a script.", inst.Name), nil, params.target)
	end

	if params.source == nil or type(params.source) ~= "string" then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Parameter 'source' must be a string.")
	end

	local updated = false
	local updateErr: any = nil

	-- 1. Try ScriptEditorService:UpdateSourceAsync
	pcall(function()
		ScriptEditorService:UpdateSourceAsync(inst :: any, function(_oldSource)
			return params.source
		end)
		updated = true
	end)

	-- 2. Fallback to direct Source property
	if not updated then
		local success, setErr = pcall(function()
			(inst :: any).Source = params.source
		end)
		if success then
			updated = true
		else
			updateErr = setErr
		end
	end

	if not updated then
		return nil, Errors.Create(
			Errors.SCRIPT_NOT_EDITABLE,
			string.format("Failed to update script source for '%s': %s", params.target, tostring(updateErr)),
			nil,
			params.target
		)
	end

	local lines = string.split(params.source, "\n")

	return {
		success = true,
		target = inst:GetFullName(),
		className = inst.ClassName,
		lineCount = #lines,
		characterCount = #params.source,
	}, nil
end

function ScriptAdapter.PatchSource(params: {
	target: string,
	search: string,
	replacement: string,
	isRegex: boolean?,
	allowMultiple: boolean?,
}): (any, Errors.ErrorObject?)
	local currentData, readErr = ScriptAdapter.GetSource({ target = params.target })
	if not currentData then
		return nil, readErr
	end

	local source = currentData.source
	local newSource: string
	local count = 0

	if params.isRegex then
		newSource, count = string.gsub(source, params.search, params.replacement, params.allowMultiple and 0 or 1)
	else
		local pattern = string.gsub(params.search, "([%%%^%$%(%)%%.%[%]%*%+%-%?])", "%%%1")
		newSource, count = string.gsub(source, pattern, params.replacement, params.allowMultiple and 0 or 1)
	end

	if count == 0 then
		return nil, Errors.Create(
			Errors.SCRIPT_PATCH_FAILED,
			string.format("Search pattern not found in script '%s'.", params.target),
			{ target = params.target, search = params.search }
		)
	end

	return ScriptAdapter.SetSource({
		target = params.target,
		source = newSource,
	})
end

function ScriptAdapter.SearchCode(params: {
	query: string,
	scope: string?,
	caseSensitive: boolean?,
	maxResults: number?,
}): (any, Errors.ErrorObject?)
	if not params.query or #params.query == 0 then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Parameter 'query' cannot be empty.")
	end

	local scopeRoot: Instance = game
	if params.scope and params.scope ~= "game" then
		local sInst, sErr = InstanceAdapter.Resolve(params.scope)
		if sInst then
			scopeRoot = sInst
		else
			return nil, sErr
		end
	end

	local maxResults = params.maxResults or 50
	local results = {}
	local totalMatches = 0

	local pattern = string.gsub(params.query, "([%%%^%$%(%)%%.%[%]%*%+%-%?])", "%%%1")
	if not params.caseSensitive then
		pattern = string.lower(pattern)
	end

	for _, desc in ipairs(scopeRoot:GetDescendants()) do
		if isScriptInstance(desc) then
			local source: string? = nil
			pcall(function() source = (desc :: any).Source end)

			if source and #source > 0 then
				local lines = string.split(source, "\n")
				local scriptMatches = {}

				for lineNum, line in ipairs(lines) do
					local testLine = params.caseSensitive and line or string.lower(line)
					if string.find(testLine, pattern) then
						table.insert(scriptMatches, {
							line = lineNum,
							content = line,
						})
						totalMatches += 1
						if totalMatches >= maxResults then break end
					end
				end

				if #scriptMatches > 0 then
					table.insert(results, {
						path = desc:GetFullName(),
						className = desc.ClassName,
						matches = scriptMatches,
					})
				end
			end

			if totalMatches >= maxResults then break end
		end
	end

	return {
		success = true,
		query = params.query,
		totalMatches = totalMatches,
		matchingScriptsCount = #results,
		results = results,
	}, nil
end

return ScriptAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_57">
			<Properties>
				<string name="Name">SelectionAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Selection Adapter: Safe integration with Selection service

local Errors = require(script.Parent.Parent.Core.Errors)

local SelectionAdapter = {}

local function getSelectionService(): Selection?
	local success, service = pcall(function()
		return game:GetService("Selection")
	end)
	return success and service or nil
end

function SelectionAdapter.Get(): (any, Errors.ErrorObject?)
	local service = getSelectionService()
	if not service then
		return nil, Errors.Create(Errors.UNSUPPORTED_API, "Selection service is not available.")
	end

	local selected = service:Get()
	local items = {}
	for _, inst in ipairs(selected) do
		table.insert(items, {
			name = inst.Name,
			className = inst.ClassName,
			path = inst:GetFullName(),
		})
	end

	return {
		success = true,
		count = #items,
		selection = items,
	}, nil
end

function SelectionAdapter.Set(instances: { Instance }): (any, Errors.ErrorObject?)
	local service = getSelectionService()
	if not service then
		return nil, Errors.Create(Errors.UNSUPPORTED_API, "Selection service is not available.")
	end

	service:Set(instances)
	return {
		success = true,
		count = #instances,
	}, nil
end

function SelectionAdapter.Add(instances: { Instance }): (any, Errors.ErrorObject?)
	local service = getSelectionService()
	if not service then
		return nil, Errors.Create(Errors.UNSUPPORTED_API, "Selection service is not available.")
	end

	local current = service:Get()
	for _, inst in ipairs(instances) do
		if not table.find(current, inst) then
			table.insert(current, inst)
		end
	end

	service:Set(current)
	return {
		success = true,
		count = #current,
	}, nil
end

function SelectionAdapter.Clear(): (any, Errors.ErrorObject?)
	local service = getSelectionService()
	if not service then
		return nil, Errors.Create(Errors.UNSUPPORTED_API, "Selection service is not available.")
	end

	service:Set({})
	return {
		success = true,
		cleared = true,
	}, nil
end

return SelectionAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_58">
			<Properties>
				<string name="Name">StudioAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Studio Adapter: Deep inspection, Tree traversal, Architecture mapping, and Service validation

local State = require(script.Parent.Parent.Core.State)
local Logger = require(script.Parent.Parent.Core.Logger)
local Errors = require(script.Parent.Parent.Core.Errors)
local Utils = require(script.Parent.Parent.Core.Utils)
local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")

local StudioAdapter = {}

local KEY_SERVICES = {
	"Workspace",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Lighting",
	"SoundService",
	"MaterialService",
	"Teams",
	"ReplicatedFirst",
	"TextChatService",
}

function StudioAdapter.ResolvePlaceName(): (string, string?, boolean)
	local placeName = game.Name
	local creatorName: string? = nil
	local isPublished = false

	if game.PlaceId > 0 then
		isPublished = true
		local success, info = pcall(function()
			return MarketplaceService:GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
		end)

		if success and info and info.Name and #info.Name > 0 then
			placeName = info.Name
			if info.Creator and info.Creator.Name then
				creatorName = info.Creator.Name
			end
		end
	else
		-- Unsaved / Local project
		if placeName == "Place1" or placeName == "Game" or placeName == "DataModel" then
			placeName = "Local Place (Unpublished)"
		end
	end

	return placeName, creatorName, isPublished
end

function StudioAdapter.Initialize(): boolean
	local realPlaceName, creatorName, isPublished = StudioAdapter.ResolvePlaceName()

	State.SetSubsystem("DataModel", "OK")
	State.PlaceInfo.PlaceName = realPlaceName
	State.PlaceInfo.PlaceId = game.PlaceId
	State.PlaceInfo.GameId = game.GameId

	-- 2. Validate Selection Service
	local successSel, selService = pcall(function()
		return game:GetService("Selection")
	end)
	if successSel and selService then
		State.SetSubsystem("Selection", "OK")
	else
		State.SetSubsystem("Selection", "UNAVAILABLE")
	end

	-- 3. Validate ChangeHistoryService
	local successHistory, histService = pcall(function()
		return game:GetService("ChangeHistoryService")
	end)
	if successHistory and histService then
		State.SetSubsystem("ChangeHistory", "OK")
	else
		State.SetSubsystem("ChangeHistory", "UNAVAILABLE")
	end

	-- 4. Validate ScriptEditorService
	local successScriptEditor, ses = pcall(function()
		return game:GetService("ScriptEditorService")
	end)
	if successScriptEditor and ses then
		State.SetSubsystem("ScriptAPI", "FULL")
	else
		State.SetSubsystem("ScriptAPI", "FALLBACK")
	end

	-- 5. Validate HttpService
	local successHttp, httpService = pcall(function()
		return game:GetService("HttpService")
	end)
	if successHttp and httpService then
		local testSuccess, testRes = pcall(function()
			return httpService:GetAsync("http://127.0.0.1:38883/api/status")
		end)
		if testSuccess then
			State.SetSubsystem("HTTP", "OK")
		else
			local errStr = tostring(testRes or "")
			if string.find(errStr:lower(), "not allowed") or string.find(errStr:lower(), "http") then
				State.SetSubsystem("HTTP", "BLOCKED")
			else
				State.SetSubsystem("HTTP", "READY")
			end
		end
	else
		State.SetSubsystem("HTTP", "UNAVAILABLE")
	end

	State.SetSubsystem("StudioAPI", "OK")
	return true
end

function StudioAdapter.GetInfo(): (any, Errors.ErrorObject?)
	local realPlaceName, creatorName, isPublished = StudioAdapter.ResolvePlaceName()

	local serviceStats = {}
	for _, sName in ipairs(KEY_SERVICES) do
		pcall(function()
			local s = game:GetService(sName)
			if s then
				serviceStats[sName] = #s:GetChildren()
			end
		end)
	end

	return {
		success = true,
		placeId = game.PlaceId,
		placeName = realPlaceName,
		gameId = game.GameId,
		jobId = game.JobId,
		isPublished = isPublished,
		creatorId = game.CreatorId,
		creatorName = creatorName,
		creatorType = tostring(game.CreatorType),
		placeVersion = game.PlaceVersion,
		diagnostics = State.GetDiagnostics(),
		serviceStats = serviceStats,
	}, nil
end

local function serializeTreeNode(inst: Instance, currentDepth: number, maxDepth: number, classFilterMap: { [string]: boolean }?, limitRef: { count: number, max: number }): any
	if limitRef.count >= limitRef.max then
		return nil
	end
	limitRef.count += 1

	local node: { [string]: any } = {
		name = inst.Name,
		className = inst.ClassName,
		path = inst:GetFullName(),
		childrenCount = #inst:GetChildren(),
	}

	if inst:IsA("BasePart") then
		node.position = { math.floor(inst.Position.X * 100) / 100, math.floor(inst.Position.Y * 100) / 100, math.floor(inst.Position.Z * 100) / 100 }
		node.size = { math.floor(inst.Size.X * 100) / 100, math.floor(inst.Size.Y * 100) / 100, math.floor(inst.Size.Z * 100) / 100 }
		node.material = inst.Material.Name
		node.transparency = inst.Transparency
		node.anchored = inst.Anchored
		node.canCollide = inst.CanCollide
	elseif inst:IsA("Model") and inst.PrimaryPart then
		node.primaryPart = inst.PrimaryPart.Name
	elseif inst:IsA("LuaSourceContainer") or inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript") then
		local s = ""
		pcall(function() s = (inst :: any).Source end)
		node.scriptLines = s and #string.split(s, "\n") or 0
	end

	if currentDepth < maxDepth and #inst:GetChildren() > 0 then
		local children = {}
		for _, child in ipairs(inst:GetChildren()) do
			if limitRef.count >= limitRef.max then break end
			if not classFilterMap or classFilterMap[child.ClassName] or (child:IsA("Folder") or child:IsA("Model")) then
				local childNode = serializeTreeNode(child, currentDepth + 1, maxDepth, classFilterMap, limitRef)
				if childNode then
					table.insert(children, childNode)
				end
			end
		end
		node.children = children
	end

	return node
end

function StudioAdapter.GetTree(params: {
	root: string?,
	depth: number?,
	limit: number?,
	classFilter: { string }?,
}): (any, Errors.ErrorObject?)
	local rootInst: Instance = workspace
	if params.root and params.root ~= "game" and params.root ~= "DataModel" then
		local InstanceAdapter = require(script.Parent.InstanceAdapter)
		local resolved, err = InstanceAdapter.Resolve(params.root)
		if not resolved then
			return nil, err
		end
		rootInst = resolved
	elseif params.root == "game" or params.root == "DataModel" then
		rootInst = game
	end

	local maxDepth = params.depth or 3
	local maxLimit = params.limit or 200

	local classFilterMap: { [string]: boolean }? = nil
	if params.classFilter and #params.classFilter > 0 then
		classFilterMap = {}
		for _, c in ipairs(params.classFilter) do
			classFilterMap[c] = true
		end
	end

	local limitRef = { count = 0, max = maxLimit }
	local tree = serializeTreeNode(rootInst, 0, maxDepth, classFilterMap, limitRef)

	return {
		success = true,
		root = rootInst:GetFullName(),
		totalNodes = limitRef.count,
		tree = tree,
	}, nil
end

function StudioAdapter.Search(params: {
	query: string?,
	className: string?,
	tag: string?,
	attributeName: string?,
	attributeValue: any?,
	scope: string?,
	limit: number?,
}): (any, Errors.ErrorObject?)
	local scopeInst: Instance = game
	if params.scope and params.scope ~= "game" then
		local InstanceAdapter = require(script.Parent.InstanceAdapter)
		local resolved, err = InstanceAdapter.Resolve(params.scope)
		if not resolved then
			return nil, err
		end
		scopeInst = resolved
	end

	local maxResults = params.limit or 100
	local results = {}

	local qLower = params.query and string.lower(params.query) or nil

	for _, inst in ipairs(scopeInst:GetDescendants()) do
		local matched = true

		if qLower and not string.find(string.lower(inst.Name), qLower) then
			matched = false
		end

		if matched and params.className and inst.ClassName ~= params.className and not inst:IsA(params.className) then
			matched = false
		end

		if matched and params.tag then
			local hasTag = false
			pcall(function()
				hasTag = CollectionService:HasTag(inst, params.tag :: string)
			end)
			if not hasTag then
				matched = false
			end
		end

		if matched and params.attributeName then
			local attrVal = inst:GetAttribute(params.attributeName)
			if attrVal == nil then
				matched = false
			elseif params.attributeValue ~= nil and attrVal ~= params.attributeValue then
				matched = false
			end
		end

		if matched then
			table.insert(results, {
				name = inst.Name,
				className = inst.ClassName,
				path = inst:GetFullName(),
				parent = inst.Parent and inst.Parent:GetFullName() or "nil",
			})
			if #results >= maxResults then
				break
			end
		end
	end

	return {
		success = true,
		count = #results,
		results = results,
	}, nil
end

function StudioAdapter.GetArchitecture(): (any, Errors.ErrorObject?)
	local realPlaceName = StudioAdapter.ResolvePlaceName()
	local remotes = {}
	local scripts = {}
	local serviceSummary = {}

	for _, sName in ipairs(KEY_SERVICES) do
		pcall(function()
			local s = game:GetService(sName)
			if s then
				serviceSummary[sName] = {
					childCount = #s:GetChildren(),
					descendantCount = #s:GetDescendants(),
				}

				for _, desc in ipairs(s:GetDescendants()) do
					if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") or desc:IsA("BindableEvent") or desc:IsA("BindableFunction") then
						table.insert(remotes, {
							name = desc.Name,
							className = desc.ClassName,
							path = desc:GetFullName(),
						})
					elseif desc:IsA("LuaSourceContainer") or desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
						table.insert(scripts, {
							name = desc.Name,
							className = desc.ClassName,
							path = desc:GetFullName(),
						})
					end
				end
			end
		end)
	end

	return {
		success = true,
		placeName = realPlaceName,
		placeId = game.PlaceId,
		services = serviceSummary,
		remotesCount = #remotes,
		remotes = remotes,
		scriptsCount = #scripts,
		scripts = scripts,
	}, nil
end

return StudioAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_59">
			<Properties>
				<string name="Name">TerrainAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Terrain Adapter: Safe interaction with Terrain APIs

local Errors = require(script.Parent.Parent.Core.Errors)
local Utils = require(script.Parent.Parent.Core.Utils)

local TerrainAdapter = {}

local function getTerrain(): Terrain?
	return workspace.Terrain
end

function TerrainAdapter.FillBlock(params: {
	cframe: any,
	size: any,
	material: string,
}): (any, Errors.ErrorObject?)
	local terrain = getTerrain()
	if not terrain then
		return nil, Errors.Create(Errors.INSTANCE_NOT_FOUND, "Workspace.Terrain not found.")
	end

	local cf = Utils.Coerce(params.cframe, "CFrame")
	local sz = Utils.Coerce(params.size, "Vector3")
	local matEnum = (Enum.Material :: any)[params.material] or Enum.Material.Grass

	local success, err = pcall(function()
		terrain:FillBlock(cf, sz, matEnum)
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, "FillBlock failed: " .. tostring(err))
	end

	return {
		success = true,
		material = matEnum.Name,
	}, nil
end

function TerrainAdapter.FillBall(params: {
	center: any,
	radius: number,
	material: string,
}): (any, Errors.ErrorObject?)
	local terrain = getTerrain()
	if not terrain then
		return nil, Errors.Create(Errors.INSTANCE_NOT_FOUND, "Workspace.Terrain not found.")
	end

	local center = Utils.Coerce(params.center, "Vector3")
	local matEnum = (Enum.Material :: any)[params.material] or Enum.Material.Grass

	local success, err = pcall(function()
		terrain:FillBall(center, params.radius, matEnum)
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, "FillBall failed: " .. tostring(err))
	end

	return {
		success = true,
		radius = params.radius,
		material = matEnum.Name,
	}, nil
end

function TerrainAdapter.Clear(): (any, Errors.ErrorObject?)
	local terrain = getTerrain()
	if not terrain then
		return nil, Errors.Create(Errors.INSTANCE_NOT_FOUND, "Workspace.Terrain not found.")
	end

	local success, err = pcall(function()
		terrain:Clear()
	end)

	if not success then
		return nil, Errors.Create(Errors.ROBLOX_API_ERROR, "Terrain clear failed: " .. tostring(err))
	end

	return {
		success = true,
		cleared = true,
	}, nil
end

return TerrainAdapter
]]></ProtectedString>
			</Properties>
		</Item>
