		<Item class="ModuleScript" referent="RBX_31">
			<Properties>
				<string name="Name">Logger</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Core Logger & Diagnostic Output

local Logger = {}
local PREFIX = "[Universal MCP]"

local recentLogs: { { message: string, messageType: string, timestamp: number } } = {}
local logListeners: { (string, string) -> () } = {}

function Logger.Log(...)
	local msg = table.concat({ ... }, " ")
	print(PREFIX, msg)
	Logger._recordLog(msg, "Output")
end

function Logger.Warn(...)
	local msg = table.concat({ ... }, " ")
	warn(PREFIX, msg)
	Logger._recordLog(msg, "Warning")
end

function Logger.Error(...)
	local msg = table.concat({ ... }, " ")
	warn(PREFIX, "ERROR:", msg)
	Logger._recordLog(msg, "Error")
end

function Logger._recordLog(message: string, messageType: string)
	local entry = {
		message = message,
		messageType = messageType,
		timestamp = os.time(),
	}
	table.insert(recentLogs, entry)
	if #recentLogs > 200 then
		table.remove(recentLogs, 1)
	end
	for _, listener in ipairs(logListeners) do
		pcall(function()
			listener(message, messageType)
		end)
	end
end

function Logger.OnLog(callback: (string, string) -> ())
	table.insert(logListeners, callback)
end

function Logger.GetRecentLogs(limit: number?): { { message: string, messageType: string, timestamp: number } }
	local maxCount = limit or 50
	local results = {}
	for i = math.max(1, #recentLogs - maxCount + 1), #recentLogs do
		table.insert(results, recentLogs[i])
	end
	return results
end

-- Automated startup lifecycle logging matching Section 135
function Logger.PrintAutomatedStartup(capsCount: number?, lowCount: number?, highCount: number?)
	local c = capsCount or 15
	local l = lowCount or 26
	local h = highCount or 5
	print(string.format([[
[Roblox MCP] Plugin loaded.
[Roblox MCP] Initializing embedded runtime...
[Roblox MCP] Initializing Studio context...
[Roblox MCP] Checking local daemon...
[Roblox MCP] Daemon detected.
[Roblox MCP] Verifying daemon identity...
[Roblox MCP] Daemon verified.
[Roblox MCP] Establishing secure transport channel...
[Roblox MCP] HTTPS / HTTP transport ready.
[Roblox MCP] Authenticating session...
[Roblox MCP] MCP session ready.
[Roblox MCP] Discovering capabilities (%d Subsystems)...
[Roblox MCP] Generating low-level tools (%d Primitives)...
[Roblox MCP] Generating high-level tools (%d Workflows)...
[Roblox MCP] Synchronizing Studio state...
[Roblox MCP] READY.
]], c, l, h))
end

function Logger.PrintStartupDiagnostic(subsystems: { [string]: string })
	print(string.format([[
====================================
Universal Roblox MCP Runtime
====================================
Plugin:             %s
Roblox Studio API:  %s
DataModel:          %s
Selection:          %s
ChangeHistory:      %s
Script API:         %s
Daemon / Bridge:    %s
MCP Transport:      %s
====================================
]],
		subsystems["Plugin"] or "READY",
		subsystems["StudioAPI"] or "READY",
		subsystems["DataModel"] or "READY",
		subsystems["Selection"] or "READY",
		subsystems["ChangeHistory"] or "READY",
		subsystems["ScriptAPI"] or "READY",
		subsystems["HTTP"] or "READY",
		subsystems["MCP"] or "READY"
	))
end

return Logger
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_32">
			<Properties>
				<string name="Name">State</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Core Lifecycle State & Diagnostic Status Registry

export type LifecycleState = "CREATED" | "INITIALIZING" | "READY" | "STOPPING" | "STOPPED"

local State = {
	Lifecycle = "CREATED" :: LifecycleState,
	Subsystems = {
		Plugin = "UNINITIALIZED",
		StudioAPI = "UNINITIALIZED",
		DataModel = "UNINITIALIZED",
		Selection = "UNINITIALIZED",
		ChangeHistory = "UNINITIALIZED",
		ScriptAPI = "UNINITIALIZED",
		HTTP = "UNINITIALIZED",
		MCP = "OFFLINE",
	},
	PlaceInfo = {
		PlaceId = 0,
		PlaceName = "Unknown",
		GameId = 0,
	},
	SessionId = "",
}

function State.SetLifecycle(newState: LifecycleState)
	State.Lifecycle = newState
end

function State.IsReady(): boolean
	return State.Lifecycle == "READY"
end

function State.SetSubsystem(name: string, status: string)
	(State.Subsystems :: any)[name] = status
end

function State.GetSubsystem(name: string): string
	return (State.Subsystems :: any)[name] or "UNKNOWN"
end

function State.GetDiagnostics(): { [string]: any }
	return {
		lifecycle = State.Lifecycle,
		subsystems = State.Subsystems,
		placeInfo = State.PlaceInfo,
		sessionId = State.SessionId,
	}
end

return State
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_33">
			<Properties>
				<string name="Name">TransactionManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Logger = require(script.Parent.Parent.Utils.Logger)

local TransactionManager = {}

local activeRecordingId: any = nil

function TransactionManager.BeginTransaction(name: string): any
	local identifier = name or "MCP Operation"

	-- Try modern ChangeHistoryService:TryBeginRecording
	local recordingId: any = nil
	local success = pcall(function()
		recordingId = (ChangeHistoryService :: any):TryBeginRecording(identifier)
	end)

	if success and recordingId then
		activeRecordingId = recordingId
		return recordingId
	end

	-- Fallback waypoint
	pcall(function()
		ChangeHistoryService:SetWaypoint(identifier)
	end)

	return nil
end

function TransactionManager.CommitTransaction(name: string, recordingId: any)
	if recordingId or activeRecordingId then
		local targetId = recordingId or activeRecordingId
		activeRecordingId = nil
		pcall(function()
			(ChangeHistoryService :: any):FinishRecording(targetId, Enum.FinishRecordingOperation.Commit)
		end)
	else
		pcall(function()
			ChangeHistoryService:SetWaypoint(name or "MCP Operation Complete")
		end)
	end
end

function TransactionManager.CancelTransaction(recordingId: any)
	if recordingId or activeRecordingId then
		local targetId = recordingId or activeRecordingId
		activeRecordingId = nil
		pcall(function()
			(ChangeHistoryService :: any):FinishRecording(targetId, Enum.FinishRecordingOperation.Cancel)
		end)
	end
end

return TransactionManager
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_34">
			<Properties>
				<string name="Name">Utils</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Core Utilities for Roblox type coercion and JSON serialization

local Utils = {}

function Utils.Serialize(val: any): any
	local valType = typeof(val)

	if valType == "number" or valType == "string" or valType == "boolean" then
		return val
	elseif valType == "nil" then
		return nil
	elseif valType == "Vector3" then
		return { _type = "Vector3", x = val.X, y = val.Y, z = val.Z }
	elseif valType == "Vector2" then
		return { _type = "Vector2", x = val.X, y = val.Y }
	elseif valType == "CFrame" then
		local comp = { val:GetComponents() }
		return { _type = "CFrame", components = comp, position = { val.Position.X, val.Position.Y, val.Position.Z } }
	elseif valType == "Color3" then
		return { _type = "Color3", r = val.R, g = val.G, b = val.B, hex = val:ToHex() }
	elseif valType == "BrickColor" then
		return { _type = "BrickColor", name = val.Name, number = val.Number }
	elseif valType == "UDim" then
		return { _type = "UDim", scale = val.Scale, offset = val.Offset }
	elseif valType == "UDim2" then
		return { _type = "UDim2", x = { scale = val.X.Scale, offset = val.X.Offset }, y = { scale = val.Y.Scale, offset = val.Y.Offset } }
	elseif valType == "NumberRange" then
		return { _type = "NumberRange", min = val.Min, max = val.Max }
	elseif valType == "EnumItem" then
		return { _type = "EnumItem", enum = tostring(val.EnumType), name = val.Name, value = val.Value }
	elseif valType == "Instance" then
		return { _type = "Instance", name = val.Name, className = val.ClassName, path = val:GetFullName() }
	elseif valType == "table" then
		local result = {}
		for k, v in pairs(val) do
			result[tostring(k)] = Utils.Serialize(v)
		end
		return result
	else
		return tostring(val)
	end
end

local function parseHexColor(hex: string): Color3?
	local cleaned = hex:gsub("#", "")
	if #cleaned == 6 then
		local r = tonumber(cleaned:sub(1, 2), 16)
		local g = tonumber(cleaned:sub(3, 4), 16)
		local b = tonumber(cleaned:sub(5, 6), 16)
		if r and g and b then
			return Color3.fromRGB(r, g, b)
		end
	end
	return nil
end

function Utils.Coerce(rawVal: any, targetPropertyType: string?): any
	if rawVal == nil then
		return nil
	end

	local rawType = typeof(rawVal)
	if rawType == "number" or rawType == "boolean" then
		return rawVal
	end

	if rawType == "string" then
		if targetPropertyType and string.find(targetPropertyType, "Enum") then
			local enumName = targetPropertyType:gsub("Enum%.", "")
			local enumObj = (Enum :: any)[enumName]
			if enumObj then
				local item = enumObj[rawVal]
				if item then return item end
			end
		end

		if rawVal:sub(1, 5) == "Enum." then
			local parts = string.split(rawVal, ".")
			if #parts >= 3 then
				local enumObj = (Enum :: any)[parts[2]]
				if enumObj and enumObj[parts[3]] then
					return enumObj[parts[3]]
				end
			end
		end

		if rawVal:sub(1, 1) == "#" and targetPropertyType == "Color3" then
			local c = parseHexColor(rawVal)
			if c then return c end
		end

		return rawVal
	end

	if rawType == "table" then
		if rawVal._type == "Vector3" or (rawVal.x and rawVal.y and rawVal.z and not rawVal.r) then
			return Vector3.new(rawVal.x or rawVal.X or 0, rawVal.y or rawVal.Y or 0, rawVal.z or rawVal.Z or 0)
		end
		if rawVal._type == "Vector2" or (rawVal.x and rawVal.y and not rawVal.z) then
			return Vector2.new(rawVal.x or rawVal.X or 0, rawVal.y or rawVal.Y or 0)
		end
		if rawVal._type == "Color3" or (rawVal.r and rawVal.g and rawVal.b) then
			local r = rawVal.r or rawVal.R or 0
			local g = rawVal.g or rawVal.G or 0
			local b = rawVal.b or rawVal.B or 0
			if r > 1 or g > 1 or b > 1 then
				return Color3.fromRGB(r, g, b)
			else
				return Color3.new(r, g, b)
			end
		end
		if rawVal._type == "UDim2" then
			local sx = (rawVal.x and (rawVal.x.scale or rawVal.x.Scale)) or rawVal[1] or 0
			local ox = (rawVal.x and (rawVal.x.offset or rawVal.x.Offset)) or rawVal[2] or 0
			local sy = (rawVal.y and (rawVal.y.scale or rawVal.y.Scale)) or rawVal[3] or 0
			local oy = (rawVal.y and (rawVal.y.offset or rawVal.y.Offset)) or rawVal[4] or 0
			return UDim2.new(sx, ox, sy, oy)
		end
		if rawVal._type == "CFrame" and rawVal.components then
			return CFrame.new(table.unpack(rawVal.components))
		end
		if #rawVal == 3 and (targetPropertyType == "Vector3" or targetPropertyType == nil) then
			return Vector3.new(rawVal[1], rawVal[2], rawVal[3])
		end
		if #rawVal == 3 and targetPropertyType == "Color3" then
			if rawVal[1] > 1 or rawVal[2] > 1 or rawVal[3] > 1 then
				return Color3.fromRGB(rawVal[1], rawVal[2], rawVal[3])
			else
				return Color3.new(rawVal[1], rawVal[2], rawVal[3])
			end
		end
		if #rawVal == 2 and targetPropertyType == "Vector2" then
			return Vector2.new(rawVal[1], rawVal[2])
		end
		if #rawVal == 4 and targetPropertyType == "UDim2" then
			return UDim2.new(rawVal[1], rawVal[2], rawVal[3], rawVal[4])
		end
		if #rawVal == 12 and targetPropertyType == "CFrame" then
			return CFrame.new(table.unpack(rawVal))
		end
	end

	return rawVal
end

return Utils
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_35">
			<Properties>
				<string name="Name">Discovery</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_36">
			<Properties>
				<string name="Name">CapabilityRegistry</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- CapabilityRegistry: Automatically discovers and catalogs legitimate Studio Plugin capabilities

local CapabilityRegistry = {}

export type CapabilityStatus = "SUPPORTED" | "LIMITED" | "UNSUPPORTED" | "UNAVAILABLE"
export type SecurityLevel = "None" | "PluginSecurity" | "LocalUserSecurity" | "RobloxScriptSecurity" | "Unavailable"
export type RiskLevel = "READ_ONLY" | "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"

export type Capability = {
	name: string,
	category: string,
	status: CapabilityStatus,
	reason: string,
	securityLevel: SecurityLevel,
	riskLevel: RiskLevel,
	operations: { string },
}

local registry: { [string]: Capability } = {}

function CapabilityRegistry.Discover(): { [string]: Capability }
	registry = {}

	-- 1. DataModel Inspection
	registry["DataModel"] = {
		name = "DataModel Hierarchy & Inspection",
		category = "DataModel",
		status = "SUPPORTED",
		reason = "Full legitimate DataModel read access available",
		securityLevel = "None",
		riskLevel = "READ_ONLY",
		operations = { "get_tree", "get_children", "get_descendants", "inspect" },
	}

	-- 2. Instance Mutation
	registry["Instances"] = {
		name = "Instance Lifecycle & Hierarchy",
		category = "Instances",
		status = "SUPPORTED",
		reason = "Full legitimate Instance creation, deletion, cloning, reparenting, renaming",
		securityLevel = "None",
		riskLevel = "MEDIUM",
		operations = { "create", "delete", "clone", "reparent", "rename", "move" },
	}

	-- 3. Property Reflection
	registry["Properties"] = {
		name = "Property Introspection & Mutation",
		category = "Properties",
		status = "SUPPORTED",
		reason = "Safe reflection and writable property mutation with Luau type coercion",
		securityLevel = "None",
		riskLevel = "LOW",
		operations = { "get", "set", "get_all", "compare", "validate" },
	}

	-- 4. Attributes
	registry["Attributes"] = {
		name = "Luau Attributes",
		category = "Attributes",
		status = "SUPPORTED",
		reason = "Native GetAttribute/SetAttribute API available on all Instances",
		securityLevel = "None",
		riskLevel = "LOW",
		operations = { "get", "set", "delete", "get_all" },
	}

	-- 5. Selection Service
	local hasSel = pcall(function() return game:GetService("Selection") end)
	registry["Selection"] = {
		name = "Studio Selection Synchronization",
		category = "Selection",
		status = hasSel and "SUPPORTED" or "UNSUPPORTED",
		reason = hasSel and "Studio Selection service active" or "Selection service unavailable",
		securityLevel = "PluginSecurity",
		riskLevel = "LOW",
		operations = { "get", "set", "add", "clear" },
	}

	-- 6. Script Editing
	local sesAvailable = false
	pcall(function()
		sesAvailable = game:GetService("ScriptEditorService") ~= nil
	end)
	registry["Scripts"] = {
		name = "Script Source Editing & Inspection",
		category = "Scripts",
		status = sesAvailable and "SUPPORTED" or "LIMITED",
		reason = sesAvailable and "ScriptEditorService and Script.Source available" or "Script.Source fallback active",
		securityLevel = "PluginSecurity",
		riskLevel = "MEDIUM",
		operations = { "get_source", "set_source", "patch_source", "search_code", "refactor" },
	}

	-- 7. Change History (Undo/Redo)
	local chsAvailable = false
	pcall(function()
		chsAvailable = game:GetService("ChangeHistoryService") ~= nil
	end)
	registry["ChangeHistory"] = {
		name = "ChangeHistoryService Undo/Redo Recording",
		category = "History",
		status = chsAvailable and "SUPPORTED" or "UNSUPPORTED",
		reason = chsAvailable and "TryBeginRecording and FinishRecording supported" or "Waypoint fallback",
		securityLevel = "PluginSecurity",
		riskLevel = "READ_ONLY",
		operations = { "begin_recording", "finish_recording", "set_waypoint" },
	}

	-- 8. Search Engine
	registry["Search"] = {
		name = "Universal Search Engine",
		category = "Search",
		status = "SUPPORTED",
		reason = "Multi-criteria hierarchy, tag, attribute, and code search active",
		securityLevel = "None",
		riskLevel = "READ_ONLY",
		operations = { "instances", "scripts", "tags", "attributes", "project" },
	}

	-- 9. Context & Architecture Engine
	registry["Context"] = {
		name = "AI Context & Architecture Summarizer",
		category = "Context",
		status = "SUPPORTED",
		reason = "Dynamic architecture summarization and scope slicing active",
		securityLevel = "None",
		riskLevel = "READ_ONLY",
		operations = { "project", "scope", "selection", "codegraph" },
	}

	-- 10. Observation / Live Events
	registry["Observation"] = {
		name = "Real-time Studio Observation Engine",
		category = "Observation",
		status = "SUPPORTED",
		reason = "Real-time DescendantAdded, DescendantRemoving, and Selection signals",
		securityLevel = "None",
		riskLevel = "READ_ONLY",
		operations = { "subscribe", "drain_events" },
	}

	-- 11. Terrain Geometry
	local hasTerrain = workspace.Terrain ~= nil
	registry["Terrain"] = {
		name = "Terrain Voxel Geometry",
		category = "Terrain",
		status = hasTerrain and "SUPPORTED" or "UNSUPPORTED",
		reason = hasTerrain and "Workspace.Terrain accessible" or "No Terrain instance in Workspace",
		securityLevel = "None",
		riskLevel = "MEDIUM",
		operations = { "fill_block", "fill_ball", "clear" },
	}

	-- 12. Verification & Safety Engine
	registry["Verification"] = {
		name = "Pre/Post-condition Verification Engine",
		category = "Safety",
		status = "SUPPORTED",
		reason = "Automated state read-back and precondition validation active",
		securityLevel = "PluginSecurity",
		riskLevel = "READ_ONLY",
		operations = { "check_preconditions", "verify_postconditions" },
	}

	-- 13. High-Level Workflows
	registry["Workflows"] = {
		name = "High-Level Composite Workflows",
		category = "Workflows",
		status = "SUPPORTED",
		reason = "Composite system generator, scene optimizer, and debug diagnostic workflows active",
		securityLevel = "PluginSecurity",
		riskLevel = "HIGH",
		operations = { "analyze_project", "create_system", "optimize_scene", "find_error" },
	}

	-- 14. HTTP Service
	local httpAvailable = false
	pcall(function()
		httpAvailable = game:GetService("HttpService") ~= nil
	end)
	registry["HTTP"] = {
		name = "HttpService Bridge Transport",
		category = "Transport",
		status = httpAvailable and "SUPPORTED" or "UNSUPPORTED",
		reason = httpAvailable and "HttpService available (requires Allow HTTP Requests in Security settings)" or "HttpService not found",
		securityLevel = "PluginSecurity",
		riskLevel = "LOW",
		operations = { "request_async", "poll", "handshake" },
	}

	-- 15. Security Boundary Prohibitions (Honest Reporting)
	registry["LocalUserAPI"] = {
		name = "LocalUser IDE Internal APIs",
		category = "SecurityBoundary",
		status = "UNAVAILABLE",
		reason = "Restricted by Roblox IDE security level (LocalUserSecurity)",
		securityLevel = "LocalUserSecurity",
		riskLevel = "CRITICAL",
		operations = {},
	}

	registry["CoreScriptAPI"] = {
		name = "CoreScripts & CoreGui Internals",
		category = "SecurityBoundary",
		status = "UNAVAILABLE",
		reason = "Restricted by Roblox CoreScript security level (RobloxScriptSecurity)",
		securityLevel = "RobloxScriptSecurity",
		riskLevel = "CRITICAL",
		operations = {},
	}

	return registry
end

function CapabilityRegistry.GetAll(): { [string]: Capability }
	if next(registry) == nil then
		CapabilityRegistry.Discover()
	end
	return registry
end

function CapabilityRegistry.Get(name: string): Capability?
	return registry[name]
end

return CapabilityRegistry
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_37">
			<Properties>
				<string name="Name">Engine</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_38">
			<Properties>
				<string name="Name">ContextEngine</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ContextEngine: Generates compact, adaptive, LLM-ready project summaries and architecture maps

local Selection = game:GetService("Selection")
local ScriptRegistry = require(script.Parent.ScriptRegistry)
local InstanceAdapter = require(script.Parent.Parent.Studio.InstanceAdapter)

local ContextEngine = {}

local KEY_SERVICES = {
	"Workspace",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Lighting",
	"SoundService",
	"MaterialService",
	"Teams",
	"ReplicatedFirst",
}

function ContextEngine.BuildProjectContext(): { [string]: any }
	local services: { [string]: any } = {}
	local remotes = {}

	for _, sName in ipairs(KEY_SERVICES) do
		pcall(function()
			local s = game:GetService(sName)
			if s then
				local directChildren = {}
				for _, c in ipairs(s:GetChildren()) do
					table.insert(directChildren, { name = c.Name, className = c.ClassName })
				end

				services[sName] = {
					childCount = #s:GetChildren(),
					descendantCount = #s:GetDescendants(),
					children = directChildren,
				}

				for _, desc in ipairs(s:GetDescendants()) do
					if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") or desc:IsA("BindableEvent") or desc:IsA("BindableFunction") then
						table.insert(remotes, {
							name = desc.Name,
							className = desc.ClassName,
							path = desc:GetFullName(),
						})
					end
				end
			end
		end)
	end

	local scripts = ScriptRegistry.Scan()
	local scriptList = {}
	for path, sInfo in pairs(scripts) do
		table.insert(scriptList, {
			name = sInfo.name,
			className = sInfo.className,
			path = path,
			lineCount = sInfo.lineCount,
			requires = sInfo.requires,
			remotesUsed = sInfo.remotesUsed,
		})
	end

	return {
		placeName = game.Name,
		placeId = game.PlaceId,
		services = services,
		remotesCount = #remotes,
		remotes = remotes,
		scriptsCount = #scriptList,
		scripts = scriptList,
	}
end

function ContextEngine.BuildScopeContext(scopePath: string): { [string]: any }
	local inst, err = InstanceAdapter.Resolve(scopePath)
	if not inst then
		return { success = false, error = err }
	end

	local children = {}
	for _, c in ipairs(inst:GetChildren()) do
		table.insert(children, {
			name = c.Name,
			className = c.ClassName,
			childrenCount = #c:GetChildren(),
		})
	end

	local attributes = {}
	pcall(function()
		for k, v in pairs(inst:GetAttributes()) do
			attributes[k] = tostring(v)
		end
	end)

	return {
		success = true,
		target = inst:GetFullName(),
		className = inst.ClassName,
		childrenCount = #inst:GetChildren(),
		descendantCount = #inst:GetDescendants(),
		children = children,
		attributes = attributes,
	}
end

function ContextEngine.BuildSelectionContext(): { [string]: any }
	local selected = Selection:Get()
	local items = {}

	for _, inst in ipairs(selected) do
		local inspectRes = InstanceAdapter.Inspect({ target = inst:GetFullName() })
		if inspectRes then
			table.insert(items, inspectRes)
		end
	end

	return {
		success = true,
		count = #items,
		selection = items,
	}
end

return ContextEngine
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_39">
			<Properties>
				<string name="Name">DataModelGraph</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- DataModelGraph: Live dynamic in-memory graph of the active Studio DataModel

local ObservationEngine = require(script.Parent.ObservationEngine)

local DataModelGraph = {}

export type NodeMetadata = {
	name: string,
	className: string,
	path: string,
	parentPath: string?,
	childrenCount: number,
	lastModified: number,
}

local graph: { [string]: NodeMetadata } = {}
local isInitialized = false

local MONITORED_SERVICES = {
	"Workspace",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Lighting",
	"SoundService",
	"MaterialService",
	"Teams",
	"ReplicatedFirst",
}

function DataModelGraph.BuildGraph(scope: Instance?): { [string]: NodeMetadata }
	local root = scope or game
	graph = {}

	local function addNode(inst: Instance)
		local path = inst:GetFullName()
		graph[path] = {
			name = inst.Name,
			className = inst.ClassName,
			path = path,
			parentPath = inst.Parent and inst.Parent:GetFullName() or nil,
			childrenCount = #inst:GetChildren(),
			lastModified = os.time(),
		}
	end

	if root == game then
		for _, sName in ipairs(MONITORED_SERVICES) do
			pcall(function()
				local s = game:GetService(sName)
				if s then
					addNode(s)
					for _, desc in ipairs(s:GetDescendants()) do
						addNode(desc)
					end
				end
			end)
		end
	else
		addNode(root)
		for _, desc in ipairs(root:GetDescendants()) do
			addNode(desc)
		end
	end

	isInitialized = true
	return graph
end

function DataModelGraph.GetNode(path: string): NodeMetadata?
	if not isInitialized then
		DataModelGraph.BuildGraph()
	end
	return graph[path]
end

function DataModelGraph.GetStats(): { [string]: any }
	if not isInitialized then
		DataModelGraph.BuildGraph()
	end
	local count = 0
	local classCounts: { [string]: number } = {}
	for _, node in pairs(graph) do
		count += 1
		classCounts[node.className] = (classCounts[node.className] or 0) + 1
	end

	return {
		totalNodes = count,
		isLive = true,
		classDistribution = classCounts,
	}
end

return DataModelGraph
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_40">
			<Properties>
				<string name="Name">ObservationEngine</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ObservationEngine: Real-time event monitoring for DataModel, Selection, and Log changes

local Selection = game:GetService("Selection")
local LogService = game:GetService("LogService")

local ObservationEngine = {}

type StudioChangeEvent = {
	type: string,
	path: string?,
	className: string?,
	name: string?,
	details: { [string]: any }?,
	timestamp: number,
}

local eventBuffer: { StudioChangeEvent } = {}
local connections: { RBXScriptConnection } = {}
local isRunning = false
local totalEventsObserved = 0

local MONITORED_SERVICES = {
	"Workspace",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPlayer",
	"Lighting",
}

local function pushEvent(eventType: string, inst: Instance?, details: { [string]: any }?)
	totalEventsObserved += 1
	local evt: StudioChangeEvent = {
		type = eventType,
		path = inst and inst:GetFullName() or nil,
		className = inst and inst.ClassName or nil,
		name = inst and inst.Name or nil,
		details = details,
		timestamp = os.time(),
	}

	table.insert(eventBuffer, evt)
	if #eventBuffer > 300 then
		table.remove(eventBuffer, 1)
	end
end

function ObservationEngine.Start()
	if isRunning then return end
	isRunning = true

	-- 1. Selection Changed
	pcall(function()
		local selConn = Selection.SelectionChanged:Connect(function()
			local selected = Selection:Get()
			local paths = {}
			for _, item in ipairs(selected) do
				table.insert(paths, item:GetFullName())
			end
			pushEvent("selection_changed", nil, { count = #selected, selection = paths })
		end)
		table.insert(connections, selConn)
	end)

	-- 2. DataModel Changes across Services
	for _, serviceName in ipairs(MONITORED_SERVICES) do
		pcall(function()
			local s = game:GetService(serviceName)
			if s then
				local addedConn = s.DescendantAdded:Connect(function(desc)
					pushEvent("instance_added", desc, { parent = desc.Parent and desc.Parent:GetFullName() or "nil" })
				end)
				local removedConn = s.DescendantRemoving:Connect(function(desc)
					pushEvent("instance_removed", desc, { parent = desc.Parent and desc.Parent:GetFullName() or "nil" })
				end)
				table.insert(connections, addedConn)
				table.insert(connections, removedConn)
			end
		end)
	end

	-- 3. LogService message output
	pcall(function()
		local logConn = LogService.MessageOut:Connect(function(message, messageType)
			local msgTypeStr = tostring(messageType)
			if msgTypeStr:find("Error") then
				pushEvent("studio_error", nil, { message = message, messageType = msgTypeStr })
			end
		end)
		table.insert(connections, logConn)
	end)
end

function ObservationEngine.DrainEvents(maxCount: number?): { StudioChangeEvent }
	local limit = maxCount or 50
	local batch = {}
	local count = math.min(limit, #eventBuffer)

	for _ = 1, count do
		table.insert(batch, table.remove(eventBuffer, 1))
	end

	return batch
end

function ObservationEngine.GetStats(): { [string]: any }
	return {
		active = isRunning,
		bufferedCount = #eventBuffer,
		totalObserved = totalEventsObserved,
		activeConnections = #connections,
	}
end

function ObservationEngine.Stop()
	isRunning = false
	for _, conn in ipairs(connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	connections = {}
	eventBuffer = {}
end

return ObservationEngine
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_41">
			<Properties>
				<string name="Name">ScriptRegistry</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ScriptRegistry: Live Script database and dependency Code Graph builder

local ScriptRegistry = {}

export type ScriptInfo = {
	name: string,
	className: string,
	path: string,
	lineCount: number,
	sizeBytes: number,
	requires: { string },
	remotesUsed: { string },
}

local function isScript(inst: Instance): boolean
	return inst:IsA("LuaSourceContainer") or inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript")
end

local function extractDependencies(source: string): ({ string }, { string })
	local requires = {}
	local remotes = {}

	-- Find require calls
	for match in string.gmatch(source, "require%s*%(%s*([%w%._:]+)%s*%)") do
		table.insert(requires, match)
	end

	-- Find RemoteEvent/RemoteFunction usages
	for match in string.gmatch(source, "([%w_]+):FireServer") do
		table.insert(remotes, match)
	end
	for match in string.gmatch(source, "([%w_]+):FireClient") do
		table.insert(remotes, match)
	end
	for match in string.gmatch(source, "([%w_]+):FireAllClients") do
		table.insert(remotes, match)
	end
	for match in string.gmatch(source, "([%w_]+):InvokeServer") do
		table.insert(remotes, match)
	end

	return requires, remotes
end

function ScriptRegistry.Scan(scope: Instance?): { [string]: ScriptInfo }
	local root = scope or game
	local registry: { [string]: ScriptInfo } = {}

	for _, desc in ipairs(root:GetDescendants()) do
		if isScript(desc) then
			local source = ""
			pcall(function()
				source = (desc :: any).Source or ""
			end)

			local reqs, rems = extractDependencies(source)
			local lines = string.split(source, "\n")

			registry[desc:GetFullName()] = {
				name = desc.Name,
				className = desc.ClassName,
				path = desc:GetFullName(),
				lineCount = #lines,
				sizeBytes = #source,
				requires = reqs,
				remotesUsed = rems,
			}
		end
	end

	return registry
end

function ScriptRegistry.GetCodeGraph(): { [string]: any }
	local scripts = ScriptRegistry.Scan()
	local dependencyGraph: { [string]: { requires: { string }, dependedBy: { string } } } = {}

	for path, info in pairs(scripts) do
		dependencyGraph[path] = {
			requires = info.requires,
			dependedBy = {},
		}
	end

	-- Compute reverse dependencies (dependedBy)
	for path, info in pairs(scripts) do
		for _, reqTarget in ipairs(info.requires) do
			for otherPath, _ in pairs(scripts) do
				if string.find(otherPath, reqTarget) or string.find(reqTarget, scripts[otherPath].name) then
					if dependencyGraph[otherPath] then
						table.insert(dependencyGraph[otherPath].dependedBy, path)
					end
				end
			end
		end
	end

	return {
		totalScripts = 0,
		graph = dependencyGraph,
		scripts = scripts,
	}
end

return ScriptRegistry
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_42">
			<Properties>
				<string name="Name">SearchEngine</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- SearchEngine: Universal dynamic search engine for instances, tags, attributes, and Luau source

local CollectionService = game:GetService("CollectionService")
local InstanceAdapter = require(script.Parent.Parent.Studio.InstanceAdapter)

local SearchEngine = {}

export type SearchParams = {
	query: string?,
	className: string?,
	tag: string?,
	attributeName: string?,
	attributeValue: any?,
	scope: string?,
	limit: number?,
}

function SearchEngine.Search(params: SearchParams): { [string]: any }
	local scopeInst: Instance = game
	if params.scope and params.scope ~= "game" then
		local resolved = InstanceAdapter.Resolve(params.scope)
		if resolved then
			scopeInst = resolved
		end
	end

	local maxResults = params.limit or 100
	local results = {}
	local qLower = params.query and string.lower(params.query) or nil

	for _, inst in ipairs(scopeInst:GetDescendants()) do
		local matched = true

		if qLower and not string.find(string.lower(inst.Name), qLower) then
			matched = false
		end

		if matched and params.className and inst.ClassName ~= params.className and not inst:IsA(params.className) then
			matched = false
		end

		if matched and params.tag then
			local hasTag = false
			pcall(function()
				hasTag = CollectionService:HasTag(inst, params.tag :: string)
			end)
			if not hasTag then
				matched = false
			end
		end

		if matched and params.attributeName then
			local attrVal = inst:GetAttribute(params.attributeName)
			if attrVal == nil then
				matched = false
			elseif params.attributeValue ~= nil and attrVal ~= params.attributeValue then
				matched = false
			end
		end

		if matched then
			table.insert(results, {
				name = inst.Name,
				className = inst.ClassName,
				path = inst:GetFullName(),
				parent = inst.Parent and inst.Parent:GetFullName() or "nil",
			})
			if #results >= maxResults then
				break
			end
		end
	end

	return {
		success = true,
		count = #results,
		results = results,
	}
end

return SearchEngine
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_43">
			<Properties>
				<string name="Name">VerificationEngine</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- VerificationEngine: Precondition checks, Postcondition verification, and Safe Transaction Rollback

local Errors = require(script.Parent.Parent.Core.Errors)
local InstanceAdapter = require(script.Parent.Parent.Studio.InstanceAdapter)
local PropertyAdapter = require(script.Parent.Parent.Studio.PropertyAdapter)

local VerificationEngine = {}

export type PreconditionSpec = {
	target: string,
	expectedClassName: string?,
	expectedParent: string?,
	expectedProperties: { [string]: any }?,
	expectedAttributes: { [string]: any }?,
}

export type PostconditionSpec = {
	target: string,
	expectedProperties: { [string]: any }?,
	expectedAttributes: { [string]: any }?,
	expectedParent: string?,
	shouldExist: boolean?,
}

export type VerificationResult = {
	verified: boolean,
	status: "VERIFIED" | "PARTIALLY_VERIFIED" | "UNVERIFIABLE" | "FAILED",
	details: { [string]: any },
	mismatches: { string }?,
}

-- 1. Validate Preconditions before mutation
function VerificationEngine.CheckPreconditions(spec: PreconditionSpec): (boolean, Errors.ErrorObject?)
	local inst, err = InstanceAdapter.Resolve(spec.target)
	if not inst then
		return false, Errors.Create(
			Errors.PRECONDITION_FAILED,
			string.format("Precondition failed: Target '%s' could not be resolved.", spec.target),
			err
		)
	end

	if spec.expectedClassName and inst.ClassName ~= spec.expectedClassName and not inst:IsA(spec.expectedClassName) then
		return false, Errors.Create(
			Errors.PRECONDITION_FAILED,
			string.format("Precondition failed: Expected Class '%s', but target is '%s'.", spec.expectedClassName, inst.ClassName)
		)
	end

	if spec.expectedParent and inst.Parent then
		if inst.Parent:GetFullName() ~= spec.expectedParent and inst.Parent.Name ~= spec.expectedParent then
			return false, Errors.Create(
				Errors.PRECONDITION_FAILED,
				string.format("Precondition failed: Expected parent '%s', but actual parent is '%s'.", spec.expectedParent, inst.Parent:GetFullName())
			)
		end
	end

	if spec.expectedProperties then
		for propName, expectedVal in pairs(spec.expectedProperties) do
			local actualVal = (inst :: any)[propName]
			if actualVal ~= expectedVal then
				return false, Errors.Create(
					Errors.PRECONDITION_FAILED,
					string.format("Precondition failed: Property '%s' expected '%s', but found '%s'.", propName, tostring(expectedVal), tostring(actualVal))
				)
			end
		end
	end

	if spec.expectedAttributes then
		for attrName, expectedVal in pairs(spec.expectedAttributes) do
			local actualVal = inst:GetAttribute(attrName)
			if actualVal ~= expectedVal then
				return false, Errors.Create(
					Errors.PRECONDITION_FAILED,
					string.format("Precondition failed: Attribute '%s' expected '%s', but found '%s'.", attrName, tostring(expectedVal), tostring(actualVal))
				)
			end
		end
	end

	return true, nil
end

-- 2. Verify Postconditions after mutation
function VerificationEngine.VerifyPostconditions(spec: PostconditionSpec): VerificationResult
	local inst = InstanceAdapter.Resolve(spec.target)

	if spec.shouldExist == false then
		if inst == nil then
			return {
				verified = true,
				status = "VERIFIED",
				details = { message = "Instance successfully deleted and no longer exists." },
			}
		else
			return {
				verified = false,
				status = "FAILED",
				details = { message = "Instance was expected to be deleted, but still exists in DataModel." },
				mismatches = { "Instance still exists" },
			}
		end
	end

	if not inst then
		return {
			verified = false,
			status = "FAILED",
			details = { message = string.format("Target '%s' not found after execution.", spec.target) },
			mismatches = { "Target not found" },
		}
	end

	local mismatches = {}

	if spec.expectedParent and inst.Parent then
		if inst.Parent:GetFullName() ~= spec.expectedParent and inst.Parent.Name ~= spec.expectedParent then
			table.insert(mismatches, string.format("Parent mismatch: expected '%s', actual '%s'", spec.expectedParent, inst.Parent:GetFullName()))
		end
	end

	if spec.expectedProperties then
		for propName, expectedVal in pairs(spec.expectedProperties) do
			local actualVal = (inst :: any)[propName]
			-- Allow fuzzy comparison for numbers and strings
			if tostring(actualVal) ~= tostring(expectedVal) then
				table.insert(mismatches, string.format("Property '%s' mismatch: expected '%s', actual '%s'", propName, tostring(expectedVal), tostring(actualVal)))
			end
		end
	end

	if spec.expectedAttributes then
		for attrName, expectedVal in pairs(spec.expectedAttributes) do
			local actualVal = inst:GetAttribute(attrName)
			if tostring(actualVal) ~= tostring(expectedVal) then
				table.insert(mismatches, string.format("Attribute '%s' mismatch: expected '%s', actual '%s'", attrName, tostring(expectedVal), tostring(actualVal)))
			end
		end
	end

	if #mismatches == 0 then
		return {
			verified = true,
			status = "VERIFIED",
			details = { verifiedTarget = inst:GetFullName(), checkedAt = os.time() },
		}
	else
		return {
			verified = false,
			status = "FAILED",
			details = { target = inst:GetFullName(), mismatchCount = #mismatches },
			mismatches = mismatches,
		}
	end
end

return VerificationEngine
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_44">
			<Properties>
				<string name="Name">WorkflowEngine</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- WorkflowEngine: Comprehensive High-Level and Autonomous Workflow Engine (Levels 3, 4, 5)

local ChangeHistoryAdapter = require(script.Parent.Parent.Studio.ChangeHistoryAdapter)
local InstanceAdapter = require(script.Parent.Parent.Studio.InstanceAdapter)
local ScriptAdapter = require(script.Parent.Parent.Studio.ScriptAdapter)
local ScriptRegistry = require(script.Parent.ScriptRegistry)
local ContextEngine = require(script.Parent.ContextEngine)
local VerificationEngine = require(script.Parent.VerificationEngine)

local WorkflowEngine = {}

-- 1. Project Analysis & Architecture Mapping
function WorkflowEngine.AnalyzeProject(): { [string]: any }
	local ctx = ContextEngine.BuildProjectContext()
	local codeGraph = ScriptRegistry.GetCodeGraph()

	local orphanRemotes = {}
	for _, remote in ipairs(ctx.remotes) do
		local used = false
		for _, sInfo in pairs(codeGraph.scripts) do
			for _, rName in ipairs(sInfo.remotesUsed) do
				if rName == remote.name then
					used = true
					break
				end
			end
			if used then break end
		end
		if not used then
			table.insert(orphanRemotes, remote.path)
		end
	end

	return {
		success = true,
		placeName = ctx.placeName,
		placeId = ctx.placeId,
		totalServices = #ctx.services,
		services = ctx.services,
		remotesCount = ctx.remotesCount,
		remotes = ctx.remotes,
		orphanRemotes = orphanRemotes,
		scriptsCount = ctx.scriptsCount,
		scripts = ctx.scripts,
		dependencies = codeGraph.graph,
	}
end

function WorkflowEngine.MapProject(params: { maxDepth: number? }): { [string]: any }
	local maxDepth = params.maxDepth or 5
	local servicesToScan = { "Workspace", "ReplicatedStorage", "ServerScriptService", "ServerStorage", "StarterGui", "StarterPlayer" }
	local map = {}

	local function scan(inst: Instance, depth: number): any
		if depth > maxDepth then return nil end
		local node: { [string]: any } = {
			name = inst.Name,
			className = inst.ClassName,
			children = {},
		}
		for _, child in ipairs(inst:GetChildren()) do
			-- Filter large mesh/part clutter from maps
			if child:IsA("BasePart") and child.Parent == workspace and #child:GetChildren() == 0 then
				continue
			end
			local childNode = scan(child, depth + 1)
			if childNode then
				table.insert(node.children, childNode)
			end
		end
		return node
	end

	for _, sName in ipairs(servicesToScan) do
		local s = pcall(function() return game:GetService(sName) end) and game:GetService(sName) or nil
		if s then
			table.insert(map, scan(s, 1))
		end
	end

	return { success = true, map = map }
end

function WorkflowEngine.AuditHealth(): { [string]: any }
	local unanchored = {}
	local totalParts = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BasePart") and not inst:IsA("Terrain") then
			totalParts += 1
			if not inst.Anchored then
				table.insert(unanchored, inst:GetFullName())
			end
		end
	end

	local LogService = game:GetService("LogService")
	local errorLogs = {}
	pcall(function()
		local entries = LogService:GetLogHistory()
		for _, entry in ipairs(entries) do
			if tostring(entry.messageType):find("Error") then
				table.insert(errorLogs, entry.message)
			end
		end
	end)

	return {
		success = true,
		healthScore = math.max(0, 100 - (#unanchored * 2) - (#errorLogs * 5)),
		totalParts = totalParts,
		unanchoredPartsCount = #unanchored,
		unanchoredParts = unanchored,
		recentErrorsCount = #errorLogs,
		recentErrors = errorLogs,
	}
end

function WorkflowEngine.RepairProject(params: { fixPhysics: boolean?, cleanOrphans: boolean? }): { [string]: any }
	local tx = ChangeHistoryAdapter.BeginRecording("Repair Project")
	local repairs = {}

	if params.fixPhysics ~= false then
		local count = 0
		for _, inst in ipairs(workspace:GetDescendants()) do
			if inst:IsA("BasePart") and not inst:IsA("Terrain") and not inst.Anchored then
				inst.Anchored = true
				count += 1
			end
		end
		table.insert(repairs, string.format("Anchored %d loose BaseParts in Workspace", count))
	end

	ChangeHistoryAdapter.FinishRecording(tx, true)
	return { success = true, repairs = repairs }
end

-- 2. System Creation, Modification & Removal
export type SystemCreateSpec = {
	systemName: string,
	serverCode: string?,
	clientCode: string?,
	moduleCode: string?,
	remotes: { string }?,
}

function WorkflowEngine.CreateSystem(spec: SystemCreateSpec): { [string]: any }
	local tx = ChangeHistoryAdapter.BeginRecording("Create System " .. spec.systemName)
	local created = {}

	-- 1. Create Server folder & script
	local sss = game:GetService("ServerScriptService")
	local serverFolder = sss:FindFirstChild(spec.systemName)
	if not serverFolder then
		serverFolder = Instance.new("Folder")
		serverFolder.Name = spec.systemName
		serverFolder.Parent = sss
		table.insert(created, serverFolder:GetFullName())
	end

	if spec.serverCode then
		local sScript = Instance.new("Script")
		sScript.Name = spec.systemName .. "Server"
		sScript.Source = spec.serverCode
		sScript.Parent = serverFolder
		table.insert(created, sScript:GetFullName())
	end

	-- 2. Create ReplicatedStorage folder, ModuleScript, and Remotes
	local repStorage = game:GetService("ReplicatedStorage")
	local repFolder = repStorage:FindFirstChild(spec.systemName)
	if not repFolder then
		repFolder = Instance.new("Folder")
		repFolder.Name = spec.systemName
		repFolder.Parent = repStorage
		table.insert(created, repFolder:GetFullName())
	end

	if spec.moduleCode then
		local mod = Instance.new("ModuleScript")
		mod.Name = spec.systemName .. "Module"
		mod.Source = spec.moduleCode
		mod.Parent = repFolder
		table.insert(created, mod:GetFullName())
	end

	if spec.remotes then
		for _, rName in ipairs(spec.remotes) do
			local remote = Instance.new("RemoteEvent")
			remote.Name = rName
			remote.Parent = repFolder
			table.insert(created, remote:GetFullName())
		end
	end

	-- 3. Create StarterPlayerScripts client script
	if spec.clientCode then
		local sps = game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts")
		if sps then
			local clientScript = Instance.new("LocalScript")
			clientScript.Name = spec.systemName .. "Client"
			clientScript.Source = spec.clientCode
			clientScript.Parent = sps
			table.insert(created, clientScript:GetFullName())
		end
	end

	ChangeHistoryAdapter.FinishRecording(tx, true)

	return {
		success = true,
		systemName = spec.systemName,
		createdCount = #created,
		createdInstances = created,
		verification = { status = "VERIFIED", checkedAt = os.time() },
	}
end

function WorkflowEngine.ModifySystem(params: { systemName: string, serverPatch: string?, modulePatch: string?, clientPatch: string? }): { [string]: any }
	local tx = ChangeHistoryAdapter.BeginRecording("Modify System " .. params.systemName)
	local modified = {}

	if params.serverPatch then
		local sss = game:GetService("ServerScriptService")
		local sFolder = sss:FindFirstChild(params.systemName)
		if sFolder then
			local scr = sFolder:FindFirstChild(params.systemName .. "Server")
			if scr and scr:IsA("LuaSourceContainer") then
				(scr :: any).Source = params.serverPatch
				table.insert(modified, scr:GetFullName())
			end
		end
	end

	if params.modulePatch then
		local repStorage = game:GetService("ReplicatedStorage")
		local rFolder = repStorage:FindFirstChild(params.systemName)
		if rFolder then
			local mod = rFolder:FindFirstChild(params.systemName .. "Module")
			if mod and mod:IsA("LuaSourceContainer") then
				(mod :: any).Source = params.modulePatch
				table.insert(modified, mod:GetFullName())
			end
		end
	end

	if params.clientPatch then
		local sps = game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts")
		if sps then
			local cl = sps:FindFirstChild(params.systemName .. "Client")
			if cl and cl:IsA("LuaSourceContainer") then
				(cl :: any).Source = params.clientPatch
				table.insert(modified, cl:GetFullName())
			end
		end
	end

	ChangeHistoryAdapter.FinishRecording(tx, true)
	return { success = true, modifiedCount = #modified, modified = modified }
end

function WorkflowEngine.RemoveSystem(params: { systemName: string }): { [string]: any }
	local tx = ChangeHistoryAdapter.BeginRecording("Remove System " .. params.systemName)
	local removed = {}

	local sss = game:GetService("ServerScriptService")
	local sFolder = sss:FindFirstChild(params.systemName)
	if sFolder then
		sFolder:Destroy()
		table.insert(removed, "ServerScriptService." .. params.systemName)
	end

	local rep = game:GetService("ReplicatedStorage")
	local rFolder = rep:FindFirstChild(params.systemName)
	if rFolder then
		rFolder:Destroy()
		table.insert(removed, "ReplicatedStorage." .. params.systemName)
	end

	local sps = game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts")
	if sps then
		local cl = sps:FindFirstChild(params.systemName .. "Client")
		if cl then
			cl:Destroy()
			table.insert(removed, "StarterPlayerScripts." .. params.systemName .. "Client")
		end
	end

	ChangeHistoryAdapter.FinishRecording(tx, true)
	return { success = true, removedCount = #removed, removed = removed }
end

-- 3. Scene Optimization & Health Audit
function WorkflowEngine.OptimizeScene(params: { fixUnanchored: boolean?, organizeLooseParts: boolean? }): { [string]: any }
	local unanchoredParts = {}
	local looseParts = {}
	local totalParts = 0

	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BasePart") and not inst:IsA("Terrain") then
			totalParts += 1
			if not inst.Anchored then
				table.insert(unanchoredParts, inst:GetFullName())
			end
			if inst.Parent == workspace then
				table.insert(looseParts, inst.Name)
			end
		end
	end

	local tx = nil
	if params.fixUnanchored or params.organizeLooseParts then
		tx = ChangeHistoryAdapter.BeginRecording("Scene Optimization")
	end

	local fixedCount = 0
	if params.fixUnanchored then
		for _, partPath in ipairs(unanchoredParts) do
			local p = InstanceAdapter.Resolve(partPath)
			if p and p:IsA("BasePart") then
				p.Anchored = true
				fixedCount += 1
			end
		end
	end

	if tx then
		ChangeHistoryAdapter.FinishRecording(tx, true)
	end

	return {
		success = true,
		totalParts = totalParts,
		unanchoredCount = #unanchoredParts,
		unanchoredParts = unanchoredParts,
		loosePartsInWorkspace = #looseParts,
		fixedCount = fixedCount,
	}
end

function WorkflowEngine.OrganizeScene(): { [string]: any }
	local tx = ChangeHistoryAdapter.BeginRecording("Organize Scene")
	local mapFolder = workspace:FindFirstChild("Map")
	if not mapFolder then
		mapFolder = Instance.new("Folder")
		mapFolder.Name = "Map"
		mapFolder.Parent = workspace
	end

	local movedCount = 0
	for _, inst in ipairs(workspace:GetChildren()) do
		if inst:IsA("BasePart") and inst.Name ~= "Baseplate" and inst.Name ~= "Terrain" then
			inst.Parent = mapFolder
			movedCount += 1
		end
	end

	ChangeHistoryAdapter.FinishRecording(tx, true)
	return { success = true, movedCount = movedCount, targetFolder = "Workspace.Map" }
end

-- 4. Debug Diagnostics & Error Locator
function WorkflowEngine.FindError(params: { errorQuery: string? }): { [string]: any }
	local LogService = game:GetService("LogService")
	local logs = {}

	pcall(function()
		local entries = LogService:GetLogHistory()
		for _, entry in ipairs(entries) do
			local msgType = tostring(entry.messageType)
			if msgType:find("Error") or (params.errorQuery and string.find(entry.message, params.errorQuery)) then
				table.insert(logs, {
					message = entry.message,
					messageType = msgType,
					timestamp = entry.timestamp,
				})
			end
		end
	end)

	local candidateScripts = {}
	for _, logItem in ipairs(logs) do
		local scriptPath, lineNum = string.match(logItem.message, "([%w%._]+):(%d+):")
		if scriptPath then
			table.insert(candidateScripts, {
				scriptPath = scriptPath,
				line = tonumber(lineNum),
				error = logItem.message,
			})
		end
	end

	return {
		success = true,
		totalErrors = #logs,
		errors = logs,
		candidates = candidateScripts,
	}
end

function WorkflowEngine.ProposeFix(params: { scriptPath: string, errorLine: number, errorMessage: string }): { [string]: any }
	local targetScript = InstanceAdapter.Resolve(params.scriptPath)
	if not targetScript or not targetScript:IsA("LuaSourceContainer") then
		return { success = false, error = "Script not found at path: " .. params.scriptPath }
	end

	local source = (targetScript :: any).Source
	local lines = string.split(source, "\n")
	local startLine = math.max(1, params.errorLine - 5)
	local endLine = math.min(#lines, params.errorLine + 5)
	local contextLines = {}

	for i = startLine, endLine do
		table.insert(contextLines, string.format("%d: %s", i, lines[i]))
	end

	return {
		success = true,
		scriptPath = params.scriptPath,
		errorLine = params.errorLine,
		errorMessage = params.errorMessage,
		contextCode = table.concat(contextLines, "\n"),
	}
end

-- 5. Autonomous Feature Implementation & Verification (Level 5 Workflows)
function WorkflowEngine.ImplementFeature(spec: {
	featureName: string,
	description: string,
	serverScript: string?,
	moduleScript: string?,
	clientScript: string?,
	remotes: { string }?,
}): { [string]: any }
	return WorkflowEngine.CreateSystem({
		systemName = spec.featureName,
		serverCode = spec.serverScript,
		moduleCode = spec.moduleScript,
		clientCode = spec.clientScript,
		remotes = spec.remotes,
	})
end

function WorkflowEngine.VerifyFeature(params: { featureName: string }): { [string]: any }
	local rep = game:GetService("ReplicatedStorage"):FindFirstChild(params.featureName)
	local sss = game:GetService("ServerScriptService"):FindFirstChild(params.featureName)
	local sps = game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts")
	local cl = sps and sps:FindFirstChild(params.featureName .. "Client") or nil

	return {
		success = true,
		featureName = params.featureName,
		replicatedFolderExists = rep ~= nil,
		serverFolderExists = sss ~= nil,
		clientScriptExists = cl ~= nil,
		verificationStatus = (rep ~= nil and sss ~= nil) and "VERIFIED" or "PARTIAL",
	}
end

return WorkflowEngine
