<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Script" referent="RBX_1">
		<Properties>
			<string name="Name">UniversalMCP</string>
			<token name="RunContext">0</token>
			<ProtectedString name="Source"><![CDATA[--!strict
-- Roblox Studio Universal MCP Plugin - Main Entry Point

local hasPlugin = false
pcall(function()
	hasPlugin = (typeof(plugin) == "Instance" and plugin:IsA("Plugin")) or (typeof(plugin) == "userdata") or (typeof(plugin) == "table")
end)

if not hasPlugin or not plugin then
	warn("===================================================================")
	warn("⚠️ [Universal MCP] This script must be executed as a Roblox Studio Plugin.")
	warn("Please save this script or file into your Roblox Studio Plugins folder.")
	warn("===================================================================")
	return
end

local Bootstrap = require(script.Bootstrap)
Bootstrap.Init(plugin)
]]></ProtectedString>
		</Properties>
		<Item class="Folder" referent="RBX_2">
			<Properties>
				<string name="Name">Adapters</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_3">
			<Properties>
				<string name="Name">AttributeAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local LuauTypeCoercion = require(script.Parent.Parent.Utils.LuauTypeCoercion)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local AttributeAdapter = {}

function AttributeAdapter.Get(params: { target: string, attributeName: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local val = inst:GetAttribute(params.attributeName)
	return {
		success = true,
		attributeName = params.attributeName,
		value = LuauTypeCoercion.Serialize(val),
	}, nil
end

function AttributeAdapter.Set(params: { target: string, attributeName: string, value: any }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local coerced = LuauTypeCoercion.Coerce(params.value)
	local success, setErr = pcall(function()
		inst:SetAttribute(params.attributeName, coerced)
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to set attribute '%s': %s", params.attributeName, tostring(setErr)))
	end

	return {
		success = true,
		attributeName = params.attributeName,
		newValue = LuauTypeCoercion.Serialize(inst:GetAttribute(params.attributeName)),
	}, nil
end

function AttributeAdapter.Delete(params: { target: string, attributeName: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local success, delErr = pcall(function()
		inst:SetAttribute(params.attributeName, nil)
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to delete attribute '%s': %s", params.attributeName, tostring(delErr)))
	end

	return {
		success = true,
		deleted = true,
		attributeName = params.attributeName,
	}, nil
end

function AttributeAdapter.GetAll(params: { target: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local rawAttributes = inst:GetAttributes()
	local serialized: { [string]: any } = {}
	for k, v in pairs(rawAttributes) do
		serialized[k] = LuauTypeCoercion.Serialize(v)
	end

	return {
		success = true,
		target = inst:GetFullName(),
		attributes = serialized,
	}, nil
end

return AttributeAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_4">
			<Properties>
				<string name="Name">InstanceAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local UuidRegistry = require(script.Parent.Parent.Addressing.UuidRegistry)
local LuauTypeCoercion = require(script.Parent.Parent.Utils.LuauTypeCoercion)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local InstanceAdapter = {}

function InstanceAdapter.Create(params: {
	className: string,
	parent: string,
	name: string?,
	properties: { [string]: any }?,
	attributes: { [string]: any }?,
	tags: { string }?,
}): (any, ErrorCodes.ErrorObject?)
	if not params.className or #params.className == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Parameter 'className' is required.")
	end
	if not params.parent or #params.parent == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Parameter 'parent' is required.")
	end

	local parentInst, parentErr = InstanceResolver.Resolve(params.parent)
	if not parentInst then
		return nil, parentErr
	end

	local newInst: Instance
	local success, err = pcall(function()
		newInst = Instance.new(params.className)
	end)

	if not success or not newInst then
		return nil, ErrorCodes.Create(ErrorCodes.UNSUPPORTED_OPERATION, string.format("Cannot create Instance of ClassName '%s': %s", params.className, tostring(err)))
	end

	if params.name and #params.name > 0 then
		newInst.Name = params.name
	end

	-- Apply initial properties
	if params.properties then
		for propName, rawVal in pairs(params.properties) do
			local propSuccess, propErr = pcall(function()
				local coerced = LuauTypeCoercion.Coerce(rawVal)
				(newInst :: any)[propName] = coerced
			end)
			if not propSuccess then
				warn(string.format("[InstanceAdapter] Failed to set property '%s' on new '%s': %s", propName, params.className, tostring(propErr)))
			end
		end
	end

	-- Apply initial attributes
	if params.attributes then
		for attrName, val in pairs(params.attributes) do
			pcall(function()
				newInst:SetAttribute(attrName, LuauTypeCoercion.Coerce(val))
			end)
		end
	end

	-- Apply tags
	if params.tags then
		local CollectionService = game:GetService("CollectionService")
		for _, tag in ipairs(params.tags) do
			CollectionService:AddTag(newInst, tag)
		end
	end

	-- Reparent to destination
	local parentSuccess, parentSetErr = pcall(function()
		newInst.Parent = parentInst
	end)
	if not parentSuccess then
		newInst:Destroy()
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to parent new instance to '%s': %s", params.parent, tostring(parentSetErr)))
	end

	local uuid = UuidRegistry.GetOrCreateUuid(newInst)
	return {
		success = true,
		uuid = uuid,
		name = newInst.Name,
		className = newInst.ClassName,
		path = newInst:GetFullName(),
	}, nil
end

function InstanceAdapter.Delete(params: { target: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if inst == game or inst == workspace then
		return nil, ErrorCodes.Create(ErrorCodes.PERMISSION_DENIED, "Cannot destroy root Game or Workspace container.")
	end

	local name = inst.Name
	local className = inst.ClassName
	local path = inst:GetFullName()

	local success, delErr = pcall(function()
		inst:Destroy()
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to destroy '%s': %s", path, tostring(delErr)))
	end

	return {
		success = true,
		deleted = true,
		name = name,
		className = className,
		path = path,
	}, nil
end

function InstanceAdapter.Clone(params: {
	target: string,
	parent: string?,
	newName: string?,
	properties: { [string]: any }?,
}): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local cloned: Instance
	local success, cloneErr = pcall(function()
		cloned = inst:Clone()
	end)

	if not success or not cloned then
		return nil, ErrorCodes.Create(ErrorCodes.UNSUPPORTED_OPERATION, string.format("Failed to clone '%s' (Archivable might be false or type not cloneable): %s", params.target, tostring(cloneErr)))
	end

	if params.newName and #params.newName > 0 then
		cloned.Name = params.newName
	end

	if params.properties then
		for propName, rawVal in pairs(params.properties) do
			pcall(function()
				(cloned :: any)[propName] = LuauTypeCoercion.Coerce(rawVal)
			end)
		end
	end

	local targetParent: Instance = inst.Parent or workspace
	if params.parent then
		local pInst, pErr = InstanceResolver.Resolve(params.parent)
		if pInst then
			targetParent = pInst
		else
			cloned:Destroy()
			return nil, pErr
		end
	end

	cloned.Parent = targetParent
	local uuid = UuidRegistry.GetOrCreateUuid(cloned)

	return {
		success = true,
		uuid = uuid,
		name = cloned.Name,
		className = cloned.ClassName,
		path = cloned:GetFullName(),
	}, nil
end

function InstanceAdapter.Reparent(params: { target: string, newParent: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end
	local parentInst, pErr = InstanceResolver.Resolve(params.newParent)
	if not parentInst then
		return nil, pErr
	end

	local success, reparentErr = pcall(function()
		inst.Parent = parentInst
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to reparent '%s' to '%s': %s", params.target, params.newParent, tostring(reparentErr)))
	end

	return {
		success = true,
		name = inst.Name,
		newPath = inst:GetFullName(),
		parent = parentInst:GetFullName(),
	}, nil
end

function InstanceAdapter.Rename(params: { target: string, newName: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not params.newName or #params.newName == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Parameter 'newName' cannot be empty.")
	end

	local oldName = inst.Name
	local success, renameErr = pcall(function()
		inst.Name = params.newName
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to rename '%s': %s", params.target, tostring(renameErr)))
	end

	return {
		success = true,
		oldName = oldName,
		newName = inst.Name,
		path = inst:GetFullName(),
	}, nil
end

function InstanceAdapter.Move(params: {
	target: string,
	position: { number }?,
	cframe: { number }?,
	pivot: boolean?,
}): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local targetCFrame: CFrame? = nil

	if params.cframe then
		if #params.cframe == 3 then
			targetCFrame = CFrame.new(params.cframe[1], params.cframe[2], params.cframe[3])
		elseif #params.cframe == 12 then
			targetCFrame = CFrame.new(table.unpack(params.cframe))
		end
	elseif params.position and #params.position == 3 then
		targetCFrame = CFrame.new(params.position[1], params.position[2], params.position[3])
	end

	if not targetCFrame then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Must provide valid 'position' [X, Y, Z] or 'cframe'.")
	end

	local success, moveErr = pcall(function()
		if inst:IsA("Model") then
			if params.pivot ~= false then
				inst:PivotTo(targetCFrame)
			else
				inst:MoveTo(targetCFrame.Position)
			end
		elseif inst:IsA("BasePart") then
			inst.CFrame = targetCFrame
		elseif inst:IsA("Attachment") then
			inst.CFrame = targetCFrame
		else
			error("Target instance must be a Model, BasePart, or Attachment to be moved.")
		end
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to move '%s': %s", params.target, tostring(moveErr)))
	end

	return {
		success = true,
		path = inst:GetFullName(),
		position = { targetCFrame.Position.X, targetCFrame.Position.Y, targetCFrame.Position.Z },
	}, nil
end

return InstanceAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_5">
			<Properties>
				<string name="Name">OutputAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local LogService = game:GetService("LogService")
local ScriptContext = game:GetService("ScriptContext")
local Config = require(script.Parent.Parent.Config)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local OutputAdapter = {}

export type LogItem = {
	message: string,
	messageType: string,
	timestamp: number,
	traceback: string?,
}

local buffer: { LogItem } = {}
local errorBuffer: { LogItem } = {}
local listeners: { (LogItem) -> () } = {}

local initialized = false

function OutputAdapter.Initialize()
	if initialized then return end
	initialized = true

	-- Connect LogService.MessageOut
	pcall(function()
		LogService.MessageOut:Connect(function(message: string, messageType: Enum.MessageType)
			local typeName = tostring(messageType):gsub("Enum.MessageType.", "")
			local item: LogItem = {
				message = message,
				messageType = typeName,
				timestamp = os.time(),
			}

			table.insert(buffer, item)
			if #buffer > Config.MaxLogBuffer then
				table.remove(buffer, 1)
			end

			if typeName == "MessageError" then
				table.insert(errorBuffer, item)
				if #errorBuffer > Config.MaxLogBuffer then
					table.remove(errorBuffer, 1)
				end
			end

			for _, listener in ipairs(listeners) do
				pcall(function()
					listener(item)
				end)
			end
		end)
	end)

	-- Connect ScriptContext.Error
	pcall(function()
		ScriptContext.Error:Connect(function(message: string, stackTrace: string, scriptInst: Instance?)
			local item: LogItem = {
				message = message,
				messageType = "MessageError",
				timestamp = os.time(),
				traceback = stackTrace,
			}

			table.insert(buffer, item)
			table.insert(errorBuffer, item)
			if #buffer > Config.MaxLogBuffer then table.remove(buffer, 1) end
			if #errorBuffer > Config.MaxLogBuffer then table.remove(errorBuffer, 1) end

			for _, listener in ipairs(listeners) do
				pcall(function()
					listener(item)
				end)
			end
		end)
	end)
end

function OutputAdapter.OnLog(callback: (LogItem) -> ())
	table.insert(listeners, callback)
end

function OutputAdapter.GetRecent(params: { limit: number?, filterType: string? }): (any, ErrorCodes.ErrorObject?)
	local limit = params.limit or 50
	local filter = params.filterType

	local results = {}
	for i = #buffer, 1, -1 do
		local item = buffer[i]
		if not filter or item.messageType == filter then
			table.insert(results, 1, item)
			if #results >= limit then
				break
			end
		end
	end

	return {
		success = true,
		count = #results,
		logs = results,
	}, nil
end

function OutputAdapter.GetErrors(params: { limit: number? }): (any, ErrorCodes.ErrorObject?)
	local limit = params.limit or 30
	local results = {}
	for i = #errorBuffer, 1, -1 do
		table.insert(results, 1, errorBuffer[i])
		if #results >= limit then
			break
		end
	end

	return {
		success = true,
		count = #results,
		errors = results,
	}, nil
end

function OutputAdapter.Clear(): (any, ErrorCodes.ErrorObject?)
	buffer = {}
	errorBuffer = {}
	return {
		success = true,
		cleared = true,
	}, nil
end

return OutputAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_6">
			<Properties>
				<string name="Name">PlaytestAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- PlaytestAdapter: Safe Playtest Simulation & Runtime State Inspection
local RunService = game:GetService("RunService")
local Errors = require(script.Parent.Parent.Core.Errors)

local PlaytestAdapter = {}

function PlaytestAdapter.GetState(): (any, Errors.ErrorObject?)
	local isEdit = true
	local isRunMode = false
	local isRunning = false

	pcall(function()
		isEdit = RunService:IsEdit()
		isRunMode = RunService:IsRunMode()
		isRunning = RunService:IsRunning()
	end)

	local currentMode = "Edit"
	if isRunning then
		currentMode = "Play"
	elseif isRunMode then
		currentMode = "Run"
	end

	return {
		success = true,
		mode = currentMode,
		isEdit = isEdit,
		isRunMode = isRunMode,
		isRunning = isRunning,
	}, nil
end

function PlaytestAdapter.Control(params: { action: string }): (any, Errors.ErrorObject?)
	local action = string.lower(params.action or "")
	if action ~= "start" and action ~= "stop" and action ~= "pause" and action ~= "resume" then
		return nil, Errors.Create(Errors.INVALID_ARGUMENT, "Action must be 'start', 'stop', 'pause', or 'resume'.")
	end

	local success, err = pcall(function()
		if action == "start" or action == "resume" then
			if RunService:IsEdit() then
				RunService:Run()
			end
		elseif action == "stop" then
			if not RunService:IsEdit() then
				RunService:Stop()
			end
		elseif action == "pause" then
			RunService:Pause()
		end
	end)

	if not success then
		-- Graceful fallback if Studio security policy restricts script-initiated playtest
		local state, _ = PlaytestAdapter.GetState()
		return {
			success = false,
			action = action,
			warning = string.format("Studio Security Note: Direct programmatic simulation '%s' is restricted by Roblox Studio's current execution identity. Current mode: %s. Error: %s", action, state.mode, tostring(err)),
			currentState = state,
		}, nil
	end

	return PlaytestAdapter.GetState()
end

return PlaytestAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_7">
			<Properties>
				<string name="Name">PropertyAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local LuauTypeCoercion = require(script.Parent.Parent.Utils.LuauTypeCoercion)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local PropertyAdapter = {}

-- Common properties to scan for getAll
local COMMON_PROPERTIES = {
	"Name", "ClassName", "Archivable",
	-- BasePart
	"Size", "Position", "CFrame", "Orientation", "Anchored", "CanCollide", "CanTouch", "CanQuery",
	"Transparency", "Reflectance", "Material", "Color", "CastShadow", "Massless",
	-- Model
	"PrimaryPart", "WorldPivot",
	-- Light
	"Brightness", "Range", "Shadows", "Enabled",
	-- Script
	"Disabled", "RunContext",
	-- GuiObject
	"Visible", "Active", "AnchorPoint", "BackgroundColor3", "BackgroundTransparency",
	"BorderSizePixel", "BorderColor3", "ClipsDescendants", "LayoutOrder", "ZIndex",
	"Text", "TextColor3", "TextSize", "Font", "TextScaled", "Image", "ImageColor3", "ImageTransparency",
	-- ValueObjects
	"Value",
	-- Sound
	"SoundId", "Volume", "Pitch", "PlaybackSpeed", "Playing", "Looped",
	-- ParticleEmitter
	"Rate", "Speed", "Lifetime", "Texture",
	-- Humanoid
	"Health", "MaxHealth", "WalkSpeed", "JumpPower", "JumpHeight", "DisplayName",
}

function PropertyAdapter.Get(params: { target: string, property: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not params.property or #params.property == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Parameter 'property' is required.")
	end

	local rawVal: any
	local success, readErr = pcall(function()
		rawVal = (inst :: any)[params.property]
	end)

	if not success then
		return nil, ErrorCodes.Create(
			ErrorCodes.PROPERTY_NOT_FOUND,
			string.format("Property '%s' does not exist or is not readable on '%s': %s", params.property, inst.ClassName, tostring(readErr)),
			{ property = params.property, className = inst.ClassName }
		)
	end

	return {
		success = true,
		property = params.property,
		value = LuauTypeCoercion.Serialize(rawVal),
		rawType = typeof(rawVal),
	}, nil
end

function PropertyAdapter.Set(params: { target: string, property: string, value: any }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not params.property or #params.property == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Parameter 'property' is required.")
	end

	-- Check existing property type if accessible
	local existingType: string? = nil
	pcall(function()
		local val = (inst :: any)[params.property]
		if val ~= nil then
			existingType = typeof(val)
		end
	end)

	local coercedVal = LuauTypeCoercion.Coerce(params.value, existingType)

	local success, setErr = pcall(function()
		(inst :: any)[params.property] = coercedVal
	end)

	if not success then
		return nil, ErrorCodes.Create(
			ErrorCodes.EXECUTION_FAILED,
			string.format("Failed to set property '%s' on '%s' (%s): %s", params.property, inst.Name, inst.ClassName, tostring(setErr)),
			{ property = params.property, value = params.value, className = inst.ClassName }
		)
	end

	-- Read back verified value
	local updatedVal: any = nil
	pcall(function()
		updatedVal = (inst :: any)[params.property]
	end)

	return {
		success = true,
		property = params.property,
		newValue = LuauTypeCoercion.Serialize(updatedVal),
	}, nil
end

function PropertyAdapter.GetAll(params: { target: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	local properties: { [string]: any } = {}
	for _, propName in ipairs(COMMON_PROPERTIES) do
		local success, val = pcall(function()
			return (inst :: any)[propName]
		end)
		if success and val ~= nil then
			properties[propName] = LuauTypeCoercion.Serialize(val)
		end
	end

	return {
		success = true,
		target = inst:GetFullName(),
		className = inst.ClassName,
		properties = properties,
	}, nil
end

return PropertyAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_8">
			<Properties>
				<string name="Name">ScriptAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local ScriptEditorService = game:GetService("ScriptEditorService")
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local ScriptAdapter = {}

-- Helper to check if an instance is a script
local function isScriptInstance(inst: Instance): boolean
	return inst:IsA("LuaSourceContainer") or inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript")
end

-- Read source safely with ScriptEditorService fallback
function ScriptAdapter.GetSource(params: { target: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not isScriptInstance(inst) then
		return nil, ErrorCodes.Create(
			ErrorCodes.INVALID_ARGUMENT,
			string.format("Instance '%s' of class '%s' is not a script.", inst.Name, inst.ClassName),
			{ target = params.target, className = inst.ClassName }
		)
	end

	local source: string? = nil

	-- 1. Try ScriptEditorService
	pcall(function()
		source = ScriptEditorService:GetEditorSource(inst :: any)
	end)

	-- 2. Fallback to Script.Source
	if source == nil then
		local success, readErr = pcall(function()
			source = (inst :: any).Source
		end)
		if not success or source == nil then
			return nil, ErrorCodes.Create(
				ErrorCodes.SCRIPT_NOT_EDITABLE,
				string.format("Cannot read source of '%s': %s", params.target, tostring(readErr)),
				{ target = params.target }
			)
		end
	end

	local lines = string.split(source, "\n")

	return {
		success = true,
		target = inst:GetFullName(),
		className = inst.ClassName,
		lineCount = #lines,
		characterCount = #source,
		source = source,
	}, nil
end

-- Write source safely with ScriptEditorService fallback
function ScriptAdapter.SetSource(params: { target: string, source: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	if not isScriptInstance(inst) then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, string.format("Instance '%s' is not a script.", inst.Name))
	end

	if params.source == nil or type(params.source) ~= "string" then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Parameter 'source' must be a string.")
	end

	local updated = false
	local updateErr: any = nil

	-- 1. Try ScriptEditorService:UpdateSourceAsync
	pcall(function()
		ScriptEditorService:UpdateSourceAsync(inst :: any, function(_oldSource)
			return params.source
		end)
		updated = true
	end)

	-- 2. Fallback to direct Source property
	if not updated then
		local success, setErr = pcall(function()
			(inst :: any).Source = params.source
		end)
		if success then
			updated = true
		else
			updateErr = setErr
		end
	end

	if not updated then
		return nil, ErrorCodes.Create(
			ErrorCodes.SCRIPT_NOT_EDITABLE,
			string.format("Failed to update script source for '%s': %s", params.target, tostring(updateErr)),
			{ target = params.target }
		)
	end

	local lines = string.split(params.source, "\n")

	return {
		success = true,
		target = inst:GetFullName(),
		className = inst.ClassName,
		lineCount = #lines,
		characterCount = #params.source,
	}, nil
end

-- Patch source (search & replace or regex)
function ScriptAdapter.PatchSource(params: {
	target: string,
	search: string,
	replacement: string,
	isRegex: boolean?,
	allowMultiple: boolean?,
}): (any, ErrorCodes.ErrorObject?)
	local currentData, readErr = ScriptAdapter.GetSource({ target = params.target })
	if not currentData then
		return nil, readErr
	end

	local source = currentData.source
	local newSource: string
	local count = 0

	if params.isRegex then
		newSource, count = string.gsub(source, params.search, params.replacement, params.allowMultiple and 0 or 1)
	else
		-- Escape Lua pattern characters for exact string match
		local pattern = string.gsub(params.search, "([%%%^%$%(%)%%.%[%]%*%+%-%?])", "%%%1")
		newSource, count = string.gsub(source, pattern, params.replacement, params.allowMultiple and 0 or 1)
	end

	if count == 0 then
		return nil, ErrorCodes.Create(
			ErrorCodes.SCRIPT_PATCH_FAILED,
			string.format("Search target not found in script '%s'.", params.target),
			{ target = params.target, search = params.search }
		)
	end

	return ScriptAdapter.SetSource({
		target = params.target,
		source = newSource,
	})
end

-- Project-wide code search
function ScriptAdapter.SearchCode(params: {
	query: string,
	scope: string?,
	caseSensitive: boolean?,
	isRegex: boolean?,
	maxResults: number?,
}): (any, ErrorCodes.ErrorObject?)
	if not params.query or #params.query == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Parameter 'query' cannot be empty.")
	end

	local scopeRoot: Instance = game
	if params.scope and params.scope ~= "game" then
		local sInst, sErr = InstanceResolver.Resolve(params.scope)
		if sInst then
			scopeRoot = sInst
		else
			return nil, sErr
		end
	end

	local maxResults = params.maxResults or 50
	local results = {}
	local totalMatches = 0

	local queryPattern = params.query
	if not params.isRegex then
		queryPattern = string.gsub(params.query, "([%%%^%$%(%)%%.%[%]%*%+%-%?])", "%%%1")
	end
	if not params.caseSensitive then
		queryPattern = string.lower(queryPattern)
	end

	local function processScript(scriptInst: Instance)
		if totalMatches >= maxResults then return end

		local source: string? = nil
		pcall(function()
			source = (scriptInst :: any).Source
		end)

		if not source or #source == 0 then return end

		local lines = string.split(source, "\n")
		local matchesInScript = {}

		for lineNum, line in ipairs(lines) do
			local testLine = params.caseSensitive and line or string.lower(line)
			if string.find(testLine, queryPattern) then
				table.insert(matchesInScript, {
					line = lineNum,
					content = line,
				})
				totalMatches += 1
				if totalMatches >= maxResults then break end
			end
		end

		if #matchesInScript > 0 then
			table.insert(results, {
				path = scriptInst:GetFullName(),
				name = scriptInst.Name,
				className = scriptInst.ClassName,
				matches = matchesInScript,
			})
		end
	end

	-- Traverse descendants
	for _, desc in ipairs(scopeRoot:GetDescendants()) do
		if isScriptInstance(desc) then
			processScript(desc)
			if totalMatches >= maxResults then break end
		end
	end

	return {
		success = true,
		query = params.query,
		totalMatches = totalMatches,
		matchingScriptsCount = #results,
		results = results,
	}, nil
end

return ScriptAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_9">
			<Properties>
				<string name="Name">SelectionAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Selection = game:GetService("Selection")
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local UuidRegistry = require(script.Parent.Parent.Addressing.UuidRegistry)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local SelectionAdapter = {}

function SelectionAdapter.Get(): (any, ErrorCodes.ErrorObject?)
	local selected = Selection:Get()
	local result = {}

	for _, inst in ipairs(selected) do
		table.insert(result, {
			uuid = UuidRegistry.GetOrCreateUuid(inst),
			name = inst.Name,
			className = inst.ClassName,
			path = inst:GetFullName(),
		})
	end

	return {
		success = true,
		count = #result,
		selection = result,
	}, nil
end

function SelectionAdapter.Set(params: { targets: { string } }): (any, ErrorCodes.ErrorObject?)
	local instancesToSelect = {}

	if params.targets then
		for _, targetStr in ipairs(params.targets) do
			local inst, err = InstanceResolver.Resolve(targetStr)
			if inst then
				table.insert(instancesToSelect, inst)
			else
				warn(string.format("[SelectionAdapter] Could not resolve '%s' for selection.", targetStr))
			end
		end
	end

	Selection:Set(instancesToSelect)

	return {
		success = true,
		selectedCount = #instancesToSelect,
	}, nil
end

function SelectionAdapter.Add(params: { targets: { string } }): (any, ErrorCodes.ErrorObject?)
	local current = Selection:Get()
	local setMap = {}
	for _, inst in ipairs(current) do
		setMap[inst] = true
	end

	if params.targets then
		for _, targetStr in ipairs(params.targets) do
			local inst = InstanceResolver.Resolve(targetStr)
			if inst and not setMap[inst] then
				table.insert(current, inst)
				setMap[inst] = true
			end
		end
	end

	Selection:Set(current)

	return {
		success = true,
		totalSelected = #current,
	}, nil
end

function SelectionAdapter.Clear(): (any, ErrorCodes.ErrorObject?)
	Selection:Set({})
	return {
		success = true,
		cleared = true,
	}, nil
end

return SelectionAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_10">
			<Properties>
				<string name="Name">TagAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local InstanceResolver = require(script.Parent.Parent.Addressing.InstanceResolver)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local TagAdapter = {}

function TagAdapter.Add(params: { target: string, tag: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	CollectionService:AddTag(inst, params.tag)
	return {
		success = true,
		tag = params.tag,
		target = inst:GetFullName(),
	}, nil
end

function TagAdapter.Remove(params: { target: string, tag: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	CollectionService:RemoveTag(inst, params.tag)
	return {
		success = true,
		removed = true,
		tag = params.tag,
		target = inst:GetFullName(),
	}, nil
end

function TagAdapter.GetTags(params: { target: string }): (any, ErrorCodes.ErrorObject?)
	local inst, err = InstanceResolver.Resolve(params.target)
	if not inst then
		return nil, err
	end

	return {
		success = true,
		target = inst:GetFullName(),
		tags = CollectionService:GetTags(inst),
	}, nil
end

function TagAdapter.GetTagged(params: { tag: string }): (any, ErrorCodes.ErrorObject?)
	local instances = CollectionService:GetTagged(params.tag)
	local result = {}
	for _, inst in ipairs(instances) do
		table.insert(result, {
			name = inst.Name,
			className = inst.ClassName,
			path = inst:GetFullName(),
		})
	end

	return {
		success = true,
		tag = params.tag,
		count = #result,
		instances = result,
	}, nil
end

return TagAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_11">
			<Properties>
				<string name="Name">TerrainAdapter</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local LuauTypeCoercion = require(script.Parent.Parent.Utils.LuauTypeCoercion)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local TerrainAdapter = {}

local function getTerrain(): Terrain?
	return workspace.Terrain
end

local function parseMaterial(matName: string): Enum.Material
	local enumObj = Enum.Material
	local item = (enumObj :: any)[matName]
	if item then
		return item
	end
	return Enum.Material.Grass
end

function TerrainAdapter.FillBlock(params: {
	cframe: { number },
	size: { number },
	material: string,
}): (any, ErrorCodes.ErrorObject?)
	local terrain = getTerrain()
	if not terrain then
		return nil, ErrorCodes.Create(ErrorCodes.INSTANCE_NOT_FOUND, "Workspace.Terrain not found.")
	end

	local cf: CFrame
	if #params.cframe == 3 then
		cf = CFrame.new(params.cframe[1], params.cframe[2], params.cframe[3])
	elseif #params.cframe == 12 then
		cf = CFrame.new(table.unpack(params.cframe))
	else
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Invalid 'cframe' array.")
	end

	local sz = Vector3.new(params.size[1], params.size[2], params.size[3])
	local mat = parseMaterial(params.material)

	local success, err = pcall(function()
		terrain:FillBlock(cf, sz, mat)
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to FillBlock terrain: %s", tostring(err)))
	end

	return {
		success = true,
		material = mat.Name,
		size = { sz.X, sz.Y, sz.Z },
		position = { cf.Position.X, cf.Position.Y, cf.Position.Z },
	}, nil
end

function TerrainAdapter.FillBall(params: {
	center: { number },
	radius: number,
	material: string,
}): (any, ErrorCodes.ErrorObject?)
	local terrain = getTerrain()
	if not terrain then
		return nil, ErrorCodes.Create(ErrorCodes.INSTANCE_NOT_FOUND, "Workspace.Terrain not found.")
	end

	local center = Vector3.new(params.center[1], params.center[2], params.center[3])
	local mat = parseMaterial(params.material)

	local success, err = pcall(function()
		terrain:FillBall(center, params.radius, mat)
	end)

	if not success then
		return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to FillBall terrain: %s", tostring(err)))
	end

	return {
		success = true,
		material = mat.Name,
		radius = params.radius,
		center = { center.X, center.Y, center.Z },
	}, nil
end

function TerrainAdapter.Clear(params: { region: { min: { number }, max: { number } }? }): (any, ErrorCodes.ErrorObject?)
	local terrain = getTerrain()
	if not terrain then
		return nil, ErrorCodes.Create(ErrorCodes.INSTANCE_NOT_FOUND, "Workspace.Terrain not found.")
	end

	if params and params.region then
		local minV = Vector3.new(params.region.min[1], params.region.min[2], params.region.min[3])
		local maxV = Vector3.new(params.region.max[1], params.region.max[2], params.region.max[3])
		local region3 = Region3.new(minV, maxV)

		local success, err = pcall(function()
			terrain:FillRegion(region3:ExpandToGrid(4), 4, Enum.Material.Air)
		end)
		if not success then
			return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to clear terrain region: %s", tostring(err)))
		end
		return { success = true, clearedRegion = true }, nil
	else
		local success, err = pcall(function()
			terrain:Clear()
		end)
		if not success then
			return nil, ErrorCodes.Create(ErrorCodes.EXECUTION_FAILED, string.format("Failed to Clear terrain: %s", tostring(err)))
		end
		return { success = true, clearedEntireTerrain = true }, nil
	end
end

return TerrainAdapter
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_12">
			<Properties>
				<string name="Name">Addressing</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_13">
			<Properties>
				<string name="Name">InstanceResolver</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local UuidRegistry = require(script.Parent.UuidRegistry)
local ErrorCodes = require(script.Parent.Parent.Utils.ErrorCodes)

local InstanceResolver = {}

-- Standard service shortcuts
local SERVICES: { [string]: string } = {
	Workspace = "Workspace",
	workspace = "Workspace",
	ReplicatedStorage = "ReplicatedStorage",
	ServerScriptService = "ServerScriptService",
	ServerStorage = "ServerStorage",
	StarterGui = "StarterGui",
	StarterPack = "StarterPack",
	StarterPlayer = "StarterPlayer",
	Lighting = "Lighting",
	SoundService = "SoundService",
	MaterialService = "MaterialService",
	Chat = "Chat",
	Players = "Players",
	Teams = "Teams",
	TestService = "TestService",
	CollectionService = "CollectionService",
}

function InstanceResolver.Resolve(target: string): (Instance?, ErrorCodes.ErrorObject?)
	if not target or type(target) ~= "string" or #target == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Target path or UUID must be a non-empty string.")
	end

	-- 1. Check UUID format
	if target:sub(1, 5) == "id://" or (target:find("^[%x%-]+$") and #target >= 8) then
		local instance = UuidRegistry.GetInstanceByUuid(target)
		if instance then
			return instance, nil
		else
			return nil, ErrorCodes.Create(ErrorCodes.INSTANCE_NOT_FOUND, "No instance found for UUID: " .. target, { target = target })
		end
	end

	-- 2. Clean root prefix
	local path = target
	if path == "game" or path == "DataModel" then
		return game, nil
	end

	if path:sub(1, 5) == "game." then
		path = path:sub(6)
	end

	-- Split path by dots
	local segments = string.split(path, ".")
	if #segments == 0 then
		return nil, ErrorCodes.Create(ErrorCodes.INVALID_ARGUMENT, "Invalid target path: " .. target)
	end

	local firstSegment = segments[1]
	local current: Instance? = nil

	-- Match root service
	local serviceName = SERVICES[firstSegment]
	if serviceName then
		local success, s = pcall(function()
			return game:GetService(serviceName)
		end)
		if success and s then
			current = s
		end
	end

	if not current then
		-- Fallback check on game child
		current = game:FindFirstChild(firstSegment)
	end

	if not current then
		return nil, ErrorCodes.Create(ErrorCodes.INSTANCE_NOT_FOUND, string.format("Root service or container '%s' not found.", firstSegment), { target = target, segment = firstSegment })
	end

	-- Traverse remaining segments
	for i = 2, #segments do
		local seg = segments[i]
		if not current then
			break
		end

		-- Check array index notation: e.g. "Part[2]"
		local name, indexStr = seg:match("^(.-)%[(%d+)%]$")
		if name and indexStr then
			local targetIndex = tonumber(indexStr) or 1
			local matches = {}
			for _, child in ipairs(current:GetChildren()) do
				if child.Name == name then
					table.insert(matches, child)
				end
			end
			current = matches[targetIndex]
		else
			current = current:FindFirstChild(seg)
		end

		if not current then
			return nil, ErrorCodes.Create(
				ErrorCodes.INSTANCE_NOT_FOUND,
				string.format("Child '%s' not found under '%s'.", seg, segments[i - 1]),
				{ target = target, failedAt = seg }
			)
		end
	end

	return current, nil
end

function InstanceResolver.GetPath(instance: Instance): string
	if instance == game then
		return "game"
	end
	return instance:GetFullName()
end

return InstanceResolver
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_14">
			<Properties>
				<string name="Name">UuidRegistry</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")

local UuidRegistry = {}

-- Table with weak keys to prevent preventing garbage collection
local instanceToUuid = setmetatable({}, { __mode = "k" })
local uuidToInstance = setmetatable({}, { __mode = "v" })

function UuidRegistry.GetOrCreateUuid(instance: Instance): string
	local existingUuid = instanceToUuid[instance]
	if existingUuid then
		return existingUuid
	end

	local newUuid = "id://" .. HttpService:GenerateGUID(false):lower():sub(1, 12)
	instanceToUuid[instance] = newUuid
	uuidToInstance[newUuid] = instance
	return newUuid
end

function UuidRegistry.GetInstanceByUuid(uuid: string): Instance?
	-- Clean prefix if present
	local cleanUuid = uuid
	if cleanUuid:sub(1, 5) ~= "id://" then
		cleanUuid = "id://" .. cleanUuid
	end
	return uuidToInstance[cleanUuid]
end

function UuidRegistry.Register(instance: Instance, uuid: string)
	instanceToUuid[instance] = uuid
	uuidToInstance[uuid] = instance
end

return UuidRegistry
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX_15">
			<Properties>
				<string name="Name">Bootstrap</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Plugin Bootstrap: Deterministic startup, daemon discovery, and capability initialization

local HttpService = game:GetService("HttpService")
local State = require(script.Parent.Core.State)
local Logger = require(script.Parent.Core.Logger)
local Toolbar = require(script.Parent.UI.Toolbar)
local Widget = require(script.Parent.UI.Widget)
local StudioAdapter = require(script.Parent.Studio.StudioAdapter)
local CapabilityRegistry = require(script.Parent.Discovery.CapabilityRegistry)
local ObservationEngine = require(script.Parent.Engine.ObservationEngine)
local DataModelGraph = require(script.Parent.Engine.DataModelGraph)
local ScriptRegistry = require(script.Parent.Engine.ScriptRegistry)
local ToolRegistry = require(script.Parent.Tools.ToolRegistry)
local DaemonManager = require(script.Parent.Bridge.DaemonManager)
local Transport = require(script.Parent.MCP.Transport)

local Bootstrap = {}

function Bootstrap.Init(pluginObj: Plugin): boolean
	-- 1. Prevent duplicate initialization
	if State.Lifecycle == "INITIALIZING" or State.Lifecycle == "READY" then
		Logger.Warn("Plugin is already initialized or initializing.")
		return true
	end

	State.SetLifecycle("INITIALIZING")

	-- 2. Validate Environment
	local isValidPlugin = false
	pcall(function()
		isValidPlugin = (pluginObj ~= nil) and (pluginObj:IsA("Plugin") or typeof(pluginObj) == "userdata" or typeof(pluginObj) == "Instance" or typeof(pluginObj) == "table")
	end)

	if not isValidPlugin then
		Logger.Error("Invalid environment: Bootstrap must receive a valid Roblox Plugin instance.")
		State.SetLifecycle("STOPPED")
		return false
	end

	State.SetSubsystem("Plugin", "OK")
	pcall(function()
		State.SessionId = "studio_" .. HttpService:GenerateGUID(false):lower():sub(1, 12)
	end)

	-- 3. Initialize Studio Adapters
	pcall(function()
		StudioAdapter.Initialize()
	end)

	-- 4. Dynamic Capability Discovery & Tool Registration
	local caps = CapabilityRegistry.Discover()
	ToolRegistry.Initialize()
	local toolStats = ToolRegistry.GetStats()
	local capCount = 0
	for _ in pairs(caps) do capCount += 1 end

	-- 5. Start Real-time Observation Engine
	pcall(function()
		ObservationEngine.Start()
	end)

	-- 6. Start Daemon Health Monitoring
	pcall(function()
		DaemonManager.StartMonitoring()
	end)

	-- 7. Build Initial DataModel Graph & Script Registry (Asynchronous)
	task.spawn(function()
		DataModelGraph.BuildGraph()
		ScriptRegistry.Scan()
	end)

	-- 8. Initialize Toolbar & Button
	local toolbarOk, toolbarErr = Toolbar.Create(pluginObj, function()
		Widget.Toggle()
	end)
	if not toolbarOk then
		Logger.Warn("Toolbar initialization notice:", toolbarErr)
	end

	-- 9. Initialize DockWidget
	local widget, widgetErr = Widget.Create(pluginObj, function()
		Transport.Handshake()
	end, function()
		StudioAdapter.Initialize()
		CapabilityRegistry.Discover()
	end)
	if not widget then
		Logger.Warn("Widget initialization notice:", widgetErr)
	end

	-- 10. Automated Lifecycle Startup Log (Section 135)
	Logger.PrintAutomatedStartup(capCount, toolStats.lowLevel, toolStats.highLevel)

	-- 11. Initialize MCP Transport
	pcall(function()
		Transport.Start()
	end)

	-- 12. Connect Plugin Unloading Lifecycle
	pcall(function()
		pluginObj.Unloading:Connect(function()
			Bootstrap.Shutdown()
		end)
	end)

	State.SetLifecycle("READY")
	return true
end

function Bootstrap.Shutdown()
	if State.Lifecycle == "STOPPING" or State.Lifecycle == "STOPPED" then return end
	State.SetLifecycle("STOPPING")

	Logger.Log("Shutting down Universal MCP Plugin...")
	Transport.Stop()
	DaemonManager.StopMonitoring()
	ObservationEngine.Stop()
	Toolbar.Destroy()
	Widget.Destroy()

	State.SetLifecycle("STOPPED")
	Logger.Log("Plugin unloaded cleanly.")
end

return Bootstrap
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX_16">
			<Properties>
				<string name="Name">Bridge</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_17">
			<Properties>
				<string name="Name">DaemonManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- DaemonManager: Detects, health-checks, verifies identity, and connects to the local MCP transport daemon

local HttpService = game:GetService("HttpService")
local State = require(script.Parent.Parent.Core.State)
local Config = require(script.Parent.Parent.Core.Config)
local Logger = require(script.Parent.Parent.Core.Logger)

local DaemonManager = {}

export type DaemonState = "NOT_FOUND" | "STARTING" | "ONLINE" | "DEGRADED" | "UNHEALTHY" | "STOPPING" | "STOPPED" | "FAILED"

local currentDaemonState: DaemonState = "NOT_FOUND"
local isMonitoring = false
local verifiedDaemonFingerprint: string? = nil

function DaemonManager.GetState(): DaemonState
	return currentDaemonState
end

function DaemonManager.GetFingerprint(): string?
	return verifiedDaemonFingerprint
end

function DaemonManager.CheckHealth(): (boolean, { [string]: any }?)
	local healthUrl = Config.GetBaseUrl() .. "/health"
	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = healthUrl,
			Method = "GET",
			Headers = { ["Accept"] = "application/json" },
		})
	end)

	if success and response and response.StatusCode == 200 then
		local decodeOk, data = pcall(function()
			return HttpService:JSONDecode(response.Body)
		end)

		if decodeOk and data and data.status == "ready" then
			currentDaemonState = "ONLINE"
			verifiedDaemonFingerprint = data.tls and data.tls.fingerprint or "verified"
			State.SetSubsystem("HTTP", "OK")
			State.SetSubsystem("MCP", "CONNECTED")
			return true, data
		else
			currentDaemonState = "DEGRADED"
			return false, nil
		end
	else
		currentDaemonState = "NOT_FOUND"
		State.SetSubsystem("MCP", "OFFLINE")
		return false, nil
	end
end

function DaemonManager.StartMonitoring()
	if isMonitoring then return end
	isMonitoring = true

	task.spawn(function()
		local retryDelay = 2
		while isMonitoring do
			local isHealthy, _data = DaemonManager.CheckHealth()
			if isHealthy then
				retryDelay = Config.PollInterval
			else
				retryDelay = math.min(retryDelay * 1.5, 10)
			end
			task.wait(retryDelay)
		end
	end)
end

function DaemonManager.StopMonitoring()
	isMonitoring = false
	currentDaemonState = "STOPPED"
end

return DaemonManager
]]></ProtectedString>
