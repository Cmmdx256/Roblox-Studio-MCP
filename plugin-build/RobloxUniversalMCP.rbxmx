		<Item class="Folder" referent="RBX_60">
			<Properties>
				<string name="Name">Tools</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_61">
			<Properties>
				<string name="Name">ToolRegistry</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ToolRegistry: Dynamic catalog and metadata manager for all low-level and high-level MCP tools

local ToolRegistry = {}

export type ToolDefinition = {
	id: string,
	name: string,
	level: number, -- 1: Primitive, 2: Studio Low-level, 3: Composite, 4: High-level, 5: Autonomous
	category: string,
	risk: "READ_ONLY" | "LOW" | "MEDIUM" | "HIGH" | "CRITICAL",
	description: string,
	requiredCapabilities: { string },
}

local registeredTools: { [string]: ToolDefinition } = {}

function ToolRegistry.Register(tool: ToolDefinition)
	registeredTools[tool.id] = tool
end

function ToolRegistry.Initialize()
	registeredTools = {}

	-- Level 1 & 2: Low-Level Primitives
	local primitives = {
		{ id = "instance.inspect", name = "Instance Inspect", level = 1, category = "Instances", risk = "READ_ONLY", desc = "Deep inspection of an instance (properties, attributes, tags, children)", caps = { "DataModel" } },
		{ id = "instance.create", name = "Instance Create", level = 2, category = "Instances", risk = "MEDIUM", desc = "Create a new Roblox instance with initial properties and attributes", caps = { "Instances" } },
		{ id = "instance.delete", name = "Instance Delete", level = 2, category = "Instances", risk = "HIGH", desc = "Safely delete a target instance with ambiguity checks", caps = { "Instances" } },
		{ id = "instance.clone", name = "Instance Clone", level = 2, category = "Instances", risk = "MEDIUM", desc = "Clone an instance hierarchy with optional new parent and name", caps = { "Instances" } },
		{ id = "instance.reparent", name = "Instance Reparent", level = 2, category = "Instances", risk = "MEDIUM", desc = "Reparent an instance with verified target checks", caps = { "Instances" } },
		{ id = "instance.rename", name = "Instance Rename", level = 2, category = "Instances", risk = "LOW", desc = "Rename an instance with conflict checks", caps = { "Instances" } },
		{ id = "instance.move", name = "Instance Move", level = 2, category = "Instances", risk = "LOW", desc = "Move a 3D BasePart or Model to new world coordinates", caps = { "Instances" } },
		{ id = "instance.get_children", name = "Get Children", level = 1, category = "Instances", risk = "READ_ONLY", desc = "List direct children of a target instance", caps = { "DataModel" } },
		{ id = "instance.get_descendants", name = "Get Descendants", level = 1, category = "Instances", risk = "READ_ONLY", desc = "List all recursive descendants under a scope", caps = { "DataModel" } },

		{ id = "property.get", name = "Property Get", level = 1, category = "Properties", risk = "READ_ONLY", desc = "Read a single property value with accurate type coercion", caps = { "Properties" } },
		{ id = "property.set", name = "Property Set", level = 2, category = "Properties", risk = "LOW", desc = "Set a property value with postcondition verification", caps = { "Properties" } },
		{ id = "property.get_all", name = "Property Get All", level = 1, category = "Properties", risk = "READ_ONLY", desc = "Reflect and read all common properties of an instance", caps = { "Properties" } },

		{ id = "attribute.get", name = "Attribute Get", level = 1, category = "Attributes", risk = "READ_ONLY", desc = "Read a Luau attribute value", caps = { "Attributes" } },
		{ id = "attribute.set", name = "Attribute Set", level = 2, category = "Attributes", risk = "LOW", desc = "Set a Luau attribute with verification", caps = { "Attributes" } },
		{ id = "attribute.delete", name = "Attribute Delete", level = 2, category = "Attributes", risk = "MEDIUM", desc = "Delete a Luau attribute from an instance", caps = { "Attributes" } },
		{ id = "attribute.get_all", name = "Attribute Get All", level = 1, category = "Attributes", risk = "READ_ONLY", desc = "Retrieve all attributes defined on an instance", caps = { "Attributes" } },

		{ id = "script.get_source", name = "Script Get Source", level = 1, category = "Scripts", risk = "READ_ONLY", desc = "Read exact Luau source code of a script", caps = { "Scripts" } },
		{ id = "script.set_source", name = "Script Set Source", level = 2, category = "Scripts", risk = "MEDIUM", desc = "Overwrite script source code with verification", caps = { "Scripts" } },
		{ id = "script.patch", name = "Script Patch", level = 2, category = "Scripts", risk = "MEDIUM", desc = "Apply diff patch with source change conflict detection", caps = { "Scripts" } },
		{ id = "script.search", name = "Script Code Search", level = 1, category = "Scripts", risk = "READ_ONLY", desc = "Search text/patterns across all scripts in the DataModel", caps = { "Scripts" } },

		{ id = "selection.get", name = "Selection Get", level = 1, category = "Selection", risk = "READ_ONLY", desc = "Get currently selected instances in Studio Viewport/Explorer", caps = { "Selection" } },
		{ id = "selection.set", name = "Selection Set", level = 2, category = "Selection", risk = "LOW", desc = "Set Studio selection to specific targets", caps = { "Selection" } },
		{ id = "selection.add", name = "Selection Add", level = 2, category = "Selection", risk = "LOW", desc = "Add instances to current Studio selection", caps = { "Selection" } },
		{ id = "selection.clear", name = "Selection Clear", level = 2, category = "Selection", risk = "LOW", desc = "Clear all active selections in Studio", caps = { "Selection" } },

		{ id = "terrain.fill_block", name = "Terrain Fill Block", level = 2, category = "Terrain", risk = "MEDIUM", desc = "Generate voxel terrain block with material", caps = { "Terrain" } },
		{ id = "terrain.fill_ball", name = "Terrain Fill Ball", level = 2, category = "Terrain", risk = "MEDIUM", desc = "Generate voxel terrain ball with material", caps = { "Terrain" } },
		{ id = "terrain.clear", name = "Terrain Clear", level = 2, category = "Terrain", risk = "HIGH", desc = "Clear all voxel terrain in Workspace", caps = { "Terrain" } },

		{ id = "batch.execute", name = "Batch Execute", level = 2, category = "Transactions", risk = "MEDIUM", desc = "Execute multiple actions atomically in a single ChangeHistory record", caps = { "ChangeHistory" } },
	}

	for _, p in ipairs(primitives) do
		ToolRegistry.Register({
			id = p.id,
			name = p.name,
			level = p.level,
			category = p.category,
			risk = p.risk :: any,
			description = p.desc,
			requiredCapabilities = p.caps,
		})
	end

	-- Level 3, 4 & 5: High-Level Composite Workflows
	local workflows = {
		{ id = "project.analyze", name = "Project Architecture Analyzer", level = 4, category = "Workflows", risk = "READ_ONLY", desc = "Full project analysis: services, remotes, scripts, dependencies, orphan remotes", caps = { "DataModel", "Scripts" } },
		{ id = "project.dependencies", name = "Code Graph Builder", level = 4, category = "Workflows", risk = "READ_ONLY", desc = "Static Luau dependency graph of require chains and remote calls", caps = { "Scripts" } },
		{ id = "system.create", name = "System Generator", level = 5, category = "Workflows", risk = "HIGH", desc = "Atomic generation of complete multi-script architecture with remotes and modules", caps = { "Instances", "Scripts", "ChangeHistory" } },
		{ id = "scene.optimize", name = "Scene Optimizer", level = 4, category = "Workflows", risk = "MEDIUM", desc = "Scan Workspace for unanchored parts and loose instances with auto-anchoring", caps = { "DataModel", "Instances" } },
		{ id = "debug.find_error", name = "Debug Diagnostic Engine", level = 4, category = "Workflows", risk = "READ_ONLY", desc = "Analyze Studio output logs, stack traces, and candidate error lines", caps = { "Scripts" } },
	}

	for _, w in ipairs(workflows) do
		ToolRegistry.Register({
			id = w.id,
			name = w.name,
			level = w.level,
			category = w.category,
			risk = w.risk :: any,
			description = w.desc,
			requiredCapabilities = w.caps,
		})
	end
end

function ToolRegistry.GetStats(): { total: number, lowLevel: number, highLevel: number }
	if next(registeredTools) == nil then
		ToolRegistry.Initialize()
	end

	local lowCount = 0
	local highCount = 0
	for _, tool in pairs(registeredTools) do
		if tool.level <= 2 then
			lowCount += 1
		else
			highCount += 1
		end
	end

	return {
		total = lowCount + highCount,
		lowLevel = lowCount,
		highLevel = highCount,
	}
end

function ToolRegistry.GetAll(): { [string]: ToolDefinition }
	if next(registeredTools) == nil then
		ToolRegistry.Initialize()
	end
	return registeredTools
end

return ToolRegistry
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_62">
			<Properties>
				<string name="Name">UI</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_63">
			<Properties>
				<string name="Name">DiagnosticsView</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- DiagnosticsView: Embedded Studio DockWidget displaying live runtime metrics, capabilities, and workflow states

local Selection = game:GetService("Selection")
local HttpService = game:GetService("HttpService")
local State = require(script.Parent.Parent.Core.State)
local Config = require(script.Parent.Parent.Core.Config)
local Logger = require(script.Parent.Parent.Core.Logger)
local CapabilityRegistry = require(script.Parent.Parent.Discovery.CapabilityRegistry)
local ObservationEngine = require(script.Parent.Parent.Engine.ObservationEngine)
local ToolRegistry = require(script.Parent.Parent.Tools.ToolRegistry)

local DiagnosticsView = {}

function DiagnosticsView.Render(parent: Instance, onConnectRequest: () -> (), onRefreshRequest: () -> ()): Frame
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(24, 25, 29)
	frame.BorderSizePixel = 0
	frame.Parent = parent

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 12)
	padding.PaddingRight = UDim.new(0, 12)
	padding.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = frame

	-- Header
	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, 0, 0, 22)
	header.BackgroundTransparency = 1
	header.Text = "⚡ UNIVERSAL ROBLOX MCP RUNTIME"
	header.TextColor3 = Color3.fromRGB(245, 245, 245)
	header.Font = Enum.Font.GothamBold
	header.TextSize = 13
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.LayoutOrder = 1
	header.Parent = frame

	-- Metrics Card
	local metricsCard = Instance.new("Frame")
	metricsCard.Size = UDim2.new(1, 0, 0, 195)
	metricsCard.BackgroundColor3 = Color3.fromRGB(33, 35, 41)
	metricsCard.BorderSizePixel = 0
	metricsCard.LayoutOrder = 2
	metricsCard.Parent = frame

	local mCorner = Instance.new("UICorner")
	mCorner.CornerRadius = UDim.new(0, 6)
	mCorner.Parent = metricsCard

	local mPad = Instance.new("UIPadding")
	mPad.PaddingTop = UDim.new(0, 8)
	mPad.PaddingBottom = UDim.new(0, 8)
	mPad.PaddingLeft = UDim.new(0, 10)
	mPad.PaddingRight = UDim.new(0, 10)
	mPad.Parent = metricsCard

	local mLayout = Instance.new("UIListLayout")
	mLayout.SortOrder = Enum.SortOrder.LayoutOrder
	mLayout.Padding = UDim.new(0, 3)
	mLayout.Parent = metricsCard

	local statusLabels: { [string]: TextLabel } = {}

	local function addRow(title: string, defaultVal: string, order: number, color: Color3?)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 16)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order
		row.Parent = metricsCard

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(0, 150, 1, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = title .. ":"
		nameLbl.TextColor3 = Color3.fromRGB(160, 165, 175)
		nameLbl.Font = Enum.Font.GothamMedium
		nameLbl.TextSize = 11
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.Parent = row

		local valLbl = Instance.new("TextLabel")
		valLbl.Size = UDim2.new(1, -155, 1, 0)
		valLbl.Position = UDim2.new(0, 155, 0, 0)
		valLbl.BackgroundTransparency = 1
		valLbl.Text = defaultVal
		valLbl.TextColor3 = color or Color3.fromRGB(46, 204, 113)
		valLbl.Font = Enum.Font.Code
		valLbl.TextSize = 11
		valLbl.TextXAlignment = Enum.TextXAlignment.Left
		valLbl.Parent = row

		statusLabels[title] = valLbl
	end

	addRow("Plugin Runtime", "ONLINE", 1)
	addRow("Place Info", State.PlaceInfo.PlaceName or "Local Place", 2, Color3.fromRGB(52, 152, 219))
	addRow("Capabilities Discovered", "Discovering...", 3)
	addRow("Low-Level Tools", "Discovering...", 4)
	addRow("High-Level Workflows", "Discovering...", 5)
	addRow("Total Universal Tools", "Discovering...", 6)
	addRow("Active Mode", "CHAT", 7, Color3.fromRGB(155, 89, 182))
	addRow("Observation Engine", "ACTIVE (Streaming)", 8)
	addRow("Verification Engine", "ACTIVE (Pre/Post)", 9)
	addRow("MCP Bridge", State.GetSubsystem("MCP"), 10)

	-- Selection Preview Card
	local selCard = Instance.new("Frame")
	selCard.Size = UDim2.new(1, 0, 0, 24)
	selCard.BackgroundColor3 = Color3.fromRGB(30, 32, 38)
	selCard.BorderSizePixel = 0
	selCard.LayoutOrder = 3
	selCard.Parent = frame

	local selCorner = Instance.new("UICorner")
	selCorner.CornerRadius = UDim.new(0, 4)
	selCorner.Parent = selCard

	local selText = Instance.new("TextLabel")
	selText.Size = UDim2.new(1, -12, 1, 0)
	selText.Position = UDim2.new(0, 8, 0, 0)
	selText.BackgroundTransparency = 1
	selText.Text = "Selection: None"
	selText.TextColor3 = Color3.fromRGB(200, 200, 210)
	selText.Font = Enum.Font.Code
	selText.TextSize = 11
	selText.TextXAlignment = Enum.TextXAlignment.Left
	selText.TextTruncate = Enum.TextTruncate.AtEnd
	selText.Parent = selCard

	-- Buttons Row
	local btnRow = Instance.new("Frame")
	btnRow.Size = UDim2.new(1, 0, 0, 28)
	btnRow.BackgroundTransparency = 1
	btnRow.LayoutOrder = 4
	btnRow.Parent = frame

	local btnLayout = Instance.new("UIListLayout")
	btnLayout.FillDirection = Enum.FillDirection.Horizontal
	btnLayout.Padding = UDim.new(0, 6)
	btnLayout.Parent = btnRow

	local function makeBtn(text: string, bgColor: Color3, onClick: () -> ())
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, 80, 1, 0)
		b.BackgroundColor3 = bgColor
		b.Text = text
		b.TextColor3 = Color3.fromRGB(255, 255, 255)
		b.Font = Enum.Font.GothamMedium
		b.TextSize = 11
		b.Parent = btnRow

		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 4)
		c.Parent = b

		b.MouseButton1Click:Connect(onClick)
		return b
	end

	makeBtn("Connect", Color3.fromRGB(0, 162, 255), function()
		if onConnectRequest then onConnectRequest() end
	end)

	makeBtn("Refresh", Color3.fromRGB(55, 58, 68), function()
		if onRefreshRequest then onRefreshRequest() end
	end)

	makeBtn("Print Diag", Color3.fromRGB(55, 58, 68), function()
		Logger.PrintStartupDiagnostic(State.Subsystems)
	end)

	-- Live Activity Stream
	local scrollLogs = Instance.new("ScrollingFrame")
	scrollLogs.Size = UDim2.new(1, 0, 1, -295)
	scrollLogs.BackgroundColor3 = Color3.fromRGB(18, 19, 22)
	scrollLogs.BorderSizePixel = 0
	scrollLogs.CanvasSize = UDim2.new(0, 0, 0, 0)
	scrollLogs.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scrollLogs.ScrollBarThickness = 5
	scrollLogs.LayoutOrder = 5
	scrollLogs.Parent = frame

	local sCorner = Instance.new("UICorner")
	sCorner.CornerRadius = UDim.new(0, 4)
	sCorner.Parent = scrollLogs

	local logList = Instance.new("UIListLayout")
	logList.SortOrder = Enum.SortOrder.LayoutOrder
	logList.Padding = UDim.new(0, 3)
	logList.Parent = scrollLogs

	local logPad = Instance.new("UIPadding")
	logPad.PaddingTop = UDim.new(0, 6)
	logPad.PaddingBottom = UDim.new(0, 6)
	logPad.PaddingLeft = UDim.new(0, 6)
	logPad.PaddingRight = UDim.new(0, 6)
	logPad.Parent = scrollLogs

	local function addLog(msg: string, msgType: string)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, -6, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Text = string.format("[%s] %s", os.date("%X"), msg)
		l.TextColor3 = msgType == "Error" and Color3.fromRGB(255, 100, 100) or (msgType == "Warning" and Color3.fromRGB(241, 196, 15) or Color3.fromRGB(200, 205, 215))
		l.Font = Enum.Font.Code
		l.TextSize = 11
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Parent = scrollLogs
	end

	Logger.OnLog(function(msg, msgType)
		addLog(msg, msgType)
	end)

	-- Dynamic Real-Time Update Loop
	task.spawn(function()
		local lastServerSync = 0
		local liveMetrics: { [string]: any }? = nil

		while frame.Parent do
			-- 1. Selection update
			local sel = Selection:Get()
			if #sel == 0 then
				selText.Text = "Selection: None"
			elseif #sel == 1 then
				selText.Text = "Selection: " .. sel[1]:GetFullName()
			else
				selText.Text = string.format("Selection: %d instances (%s...)", #sel, sel[1].Name)
			end

			-- 2. Local dynamic discovery calculations
			local localToolStats = ToolRegistry.GetStats()
			local localCaps = CapabilityRegistry.GetAll()
			local localCapCount = 0
			for _ in pairs(localCaps) do localCapCount += 1 end

			-- 3. Live Server Telemetry Sync (Every 2 seconds when MCP bridge is active)
			local mcpVal = State.GetSubsystem("MCP")
			local now = os.clock()
			if (mcpVal == "CONNECTED" or mcpVal == "ONLINE") and (now - lastServerSync >= 2) then
				lastServerSync = now
				task.spawn(function()
					local success, response = pcall(function()
						return HttpService:RequestAsync({
							Url = Config.GetBaseUrl() .. "/telemetry",
							Method = "GET",
							Headers = { ["Content-Type"] = "application/json" },
						})
					end)
					if success and response and response.StatusCode == 200 then
						local decodeOk, data = pcall(function()
							return HttpService:JSONDecode(response.Body)
						end)
						if decodeOk and data then
							liveMetrics = data.metrics or data
						end
					end
				end)
			end

			-- 4. Dynamic UI Label Updates (Never hardcoded)
			local capCount = (liveMetrics and liveMetrics.liveCapabilitiesCount and liveMetrics.liveCapabilitiesCount > 0) and liveMetrics.liveCapabilitiesCount or localCapCount
			local lowTools = (liveMetrics and liveMetrics.lowLevelToolsCount and liveMetrics.lowLevelToolsCount > 0) and liveMetrics.lowLevelToolsCount or localToolStats.lowLevel
			local highWorkflows = (liveMetrics and liveMetrics.highLevelWorkflowsCount and liveMetrics.highLevelWorkflowsCount > 0) and liveMetrics.highLevelWorkflowsCount or localToolStats.highLevel
			local totalTools = (liveMetrics and liveMetrics.totalUniversalTools and liveMetrics.totalUniversalTools > 0) and liveMetrics.totalUniversalTools or (lowTools + highWorkflows)
			local activeMode = (liveMetrics and liveMetrics.activeMode) or "CHAT"

			if statusLabels["Capabilities Discovered"] then
				statusLabels["Capabilities Discovered"].Text = string.format("%d Live Capabilities", capCount)
			end
			if statusLabels["Low-Level Tools"] then
				statusLabels["Low-Level Tools"].Text = string.format("%d Primitive Tools", lowTools)
			end
			if statusLabels["High-Level Workflows"] then
				statusLabels["High-Level Workflows"].Text = string.format("%d Composite Workflows", highWorkflows)
			end
			if statusLabels["Total Universal Tools"] then
				statusLabels["Total Universal Tools"].Text = string.format("%d Universal Tools", totalTools)
			end
			if statusLabels["Active Mode"] then
				statusLabels["Active Mode"].Text = string.format("%s Mode", activeMode)
			end
			if statusLabels["MCP Bridge"] then
				statusLabels["MCP Bridge"].Text = mcpVal
				statusLabels["MCP Bridge"].TextColor3 = (mcpVal == "CONNECTED" or mcpVal == "ONLINE") and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
			end
			if statusLabels["Place Info"] then
				statusLabels["Place Info"].Text = State.PlaceInfo.PlaceName or "Local Place"
			end
			if statusLabels["Plugin Runtime"] then
				statusLabels["Plugin Runtime"].Text = (mcpVal == "CONNECTED" or mcpVal == "ONLINE") and "ONLINE" or "STANDALONE"
			end

			task.wait(0.5)
		end
	end)

	return frame
end

return DiagnosticsView
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_64">
			<Properties>
				<string name="Name">DockWidget</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Config = require(script.Parent.Parent.Config)
local Session = require(script.Parent.Parent.Bridge.Session)
local HttpClient = require(script.Parent.Parent.Bridge.HttpClient)
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")

local DockWidget = {}

function DockWidget.Create(pluginObj: any): any
	local container: any = nil

	if pluginObj and typeof(pluginObj.CreateDockWidgetPluginGui) == "function" then
		local success, widget = pcall(function()
			local widgetInfo = DockWidgetPluginGuiInfo.new(
				Enum.InitialDockState.Right,
				false, -- Initially enabled
				false, -- Override previous enabled state
				320,   -- Default width
				450,   -- Default height
				280,   -- Min width
				300    -- Min height
			)
			return pluginObj:CreateDockWidgetPluginGui("RobloxUniversalMCPWidget_v2", widgetInfo)
		end)
		if success and widget then
			widget.Title = "Roblox Universal MCP"
			container = widget
		end
	end

	if not container then
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "RobloxUniversalMCP_ScreenGui"
		screenGui.ResetOnSpawn = false
		screenGui.Enabled = false

		pcall(function() screenGui.Parent = CoreGui end)
		if not screenGui.Parent then
			pcall(function() screenGui.Parent = StarterGui end)
		end
		container = screenGui
	end

	-- Main Background Frame
	local mainFrame = Instance.new("Frame")
	if container:IsA("ScreenGui") then
		mainFrame.Size = UDim2.new(0, 320, 0, 460)
		mainFrame.Position = UDim2.new(1, -340, 0.5, -230)
		local frameCorner = Instance.new("UICorner")
		frameCorner.CornerRadius = UDim.new(0, 8)
		frameCorner.Parent = mainFrame
	else
		mainFrame.Size = UDim2.new(1, 0, 1, 0)
	end
	mainFrame.BackgroundColor3 = Color3.fromRGB(36, 37, 41)
	mainFrame.BorderSizePixel = 0
	mainFrame.Parent = container

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = mainFrame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = mainFrame

	-- Title / Header
	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, 0, 0, 24)
	header.BackgroundTransparency = 1
	header.Text = "⚡ Universal MCP Bridge"
	header.TextColor3 = Color3.fromRGB(240, 240, 240)
	header.Font = Enum.Font.GothamBold
	header.TextSize = 16
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.LayoutOrder = 1
	header.Parent = mainFrame

	-- Status Card
	local statusCard = Instance.new("Frame")
	statusCard.Size = UDim2.new(1, 0, 0, 75)
	statusCard.BackgroundColor3 = Color3.fromRGB(46, 47, 52)
	statusCard.BorderSizePixel = 0
	statusCard.LayoutOrder = 2
	statusCard.Parent = mainFrame

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 6)
	cardCorner.Parent = statusCard

	local statusIndicator = Instance.new("Frame")
	statusIndicator.Size = UDim2.new(0, 12, 0, 12)
	statusIndicator.Position = UDim2.new(0, 12, 0, 14)
	statusIndicator.BackgroundColor3 = Color3.fromRGB(235, 87, 87)
	statusIndicator.BorderSizePixel = 0
	statusIndicator.Parent = statusCard

	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = statusIndicator

	local statusText = Instance.new("TextLabel")
	statusText.Size = UDim2.new(1, -35, 0, 20)
	statusText.Position = UDim2.new(0, 32, 0, 10)
	statusText.BackgroundTransparency = 1
	statusText.Text = "Disconnected"
	statusText.TextColor3 = Color3.fromRGB(240, 240, 240)
	statusText.Font = Enum.Font.GothamMedium
	statusText.TextSize = 14
	statusText.TextXAlignment = Enum.TextXAlignment.Left
	statusText.Parent = statusCard

	local bridgeInfo = Instance.new("TextLabel")
	bridgeInfo.Size = UDim2.new(1, -24, 0, 32)
	bridgeInfo.Position = UDim2.new(0, 12, 0, 34)
	bridgeInfo.BackgroundTransparency = 1
	bridgeInfo.Text = "Target: " .. Config.GetBaseUrl() .. "\nSession: " .. Session.GetSessionId()
	bridgeInfo.TextColor3 = Color3.fromRGB(160, 160, 170)
	bridgeInfo.Font = Enum.Font.Code
	bridgeInfo.TextSize = 10
	bridgeInfo.TextXAlignment = Enum.TextXAlignment.Left
	bridgeInfo.Parent = statusCard

	-- Buttons Frame
	local buttonFrame = Instance.new("Frame")
	buttonFrame.Size = UDim2.new(1, 0, 0, 32)
	buttonFrame.BackgroundTransparency = 1
	buttonFrame.LayoutOrder = 3
	buttonFrame.Parent = mainFrame

	local btnLayout = Instance.new("UIListLayout")
	btnLayout.FillDirection = Enum.FillDirection.Horizontal
	btnLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	btnLayout.Padding = UDim.new(0, 8)
	btnLayout.Parent = buttonFrame

	local reconnectBtn = Instance.new("TextButton")
	reconnectBtn.Size = UDim2.new(0, 100, 1, 0)
	reconnectBtn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
	reconnectBtn.Text = "Reconnect"
	reconnectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	reconnectBtn.Font = Enum.Font.GothamMedium
	reconnectBtn.TextSize = 12
	reconnectBtn.Parent = buttonFrame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 4)
	btnCorner.Parent = reconnectBtn

	reconnectBtn.MouseButton1Click:Connect(function()
		statusText.Text = "Connecting..."
		statusIndicator.BackgroundColor3 = Color3.fromRGB(242, 201, 76)
		task.spawn(function()
			HttpClient.Handshake()
		end)
	end)

	-- Log Viewer Header
	local logHeader = Instance.new("TextLabel")
	logHeader.Size = UDim2.new(1, 0, 0, 18)
	logHeader.BackgroundTransparency = 1
	logHeader.Text = "Live Activity & Command Stream"
	logHeader.TextColor3 = Color3.fromRGB(180, 180, 190)
	logHeader.Font = Enum.Font.GothamMedium
	logHeader.TextSize = 12
	logHeader.TextXAlignment = Enum.TextXAlignment.Left
	logHeader.LayoutOrder = 4
	logHeader.Parent = mainFrame

	-- Scrolling Log Box
	local scrollLogs = Instance.new("ScrollingFrame")
	scrollLogs.Size = UDim2.new(1, 0, 1, -170)
	scrollLogs.BackgroundColor3 = Color3.fromRGB(24, 24, 27)
	scrollLogs.BorderSizePixel = 0
	scrollLogs.CanvasSize = UDim2.new(0, 0, 0, 0)
	scrollLogs.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scrollLogs.ScrollBarThickness = 6
	scrollLogs.LayoutOrder = 5
	scrollLogs.Parent = mainFrame

	local scrollCorner = Instance.new("UICorner")
	scrollCorner.CornerRadius = UDim.new(0, 4)
	scrollCorner.Parent = scrollLogs

	local logListLayout = Instance.new("UIListLayout")
	logListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	logListLayout.Padding = UDim.new(0, 4)
	logListLayout.Parent = scrollLogs

	local logPadding = Instance.new("UIPadding")
	logPadding.PaddingTop = UDim.new(0, 6)
	logPadding.PaddingBottom = UDim.new(0, 6)
	logPadding.PaddingLeft = UDim.new(0, 6)
	logPadding.PaddingRight = UDim.new(0, 6)
	logPadding.Parent = scrollLogs

	local function addLogEntry(text: string, isError: boolean?)
		local entry = Instance.new("TextLabel")
		entry.Size = UDim2.new(1, -10, 0, 0)
		entry.AutomaticSize = Enum.AutomaticSize.Y
		entry.BackgroundTransparency = 1
		entry.Text = string.format("[%s] %s", os.date("%X"), text)
		entry.TextColor3 = isError and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(200, 200, 210)
		entry.Font = Enum.Font.Code
		entry.TextSize = 11
		entry.TextWrapped = true
		entry.TextXAlignment = Enum.TextXAlignment.Left
		entry.Parent = scrollLogs
	end

	-- Connect status callbacks
	HttpClient.OnStatusChanged(function(connected, message)
		if connected then
			statusIndicator.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
			statusText.Text = "● Connected to AI Runtime"
			addLogEntry("Connected to MCP Bridge at " .. Config.GetBaseUrl())
		else
			statusIndicator.BackgroundColor3 = Color3.fromRGB(235, 87, 87)
			statusText.Text = "○ Disconnected"
			if message then
				addLogEntry(message, true)
			end
		end
	end)

	return container
end

return DockWidget
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_65">
			<Properties>
				<string name="Name">MessageBox</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- MessageBox and Toast Notification helper for Roblox Studio Universal MCP
local StarterGui = game:GetService("StarterGui")
local CoreGui = game:GetService("CoreGui")
local Config = require(script.Parent.Parent.Config)

local MessageBox = {}

function MessageBox.ShowNotification(title: string, message: string)
	-- 1. Native Studio Notification (Bottom-Right Toast)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = message,
			Duration = 8,
			Icon = "rbxasset://textures/ui/Settings/MenuBar/SettingsButton.png",
		})
	end)

	-- 2. Output Window Big ASCII Banner
	print([[

===================================================================
⚡ ROBLOX STUDIO UNIVERSAL MCP BRIDGE AKTİF EDİLDİ!
-------------------------------------------------------------------
🌐 Adres: ]] .. Config.GetBaseUrl() .. [[

🎯 Oturum: Hazır (Claude / Cursor / AI Agent dinleniyor)
🛡️ Güvenlik: Localhost (127.0.0.1)
===================================================================
]])
end

function MessageBox.ShowPopupModal(pluginObj: any, baseUrl: string, onOpenPanel: () -> ())
	-- If running with native Plugin object
	if pluginObj and typeof(pluginObj.CreateDockWidgetPluginGui) == "function" then
		local success, modal = pcall(function()
			local widgetInfo = DockWidgetPluginGuiInfo.new(
				Enum.InitialDockState.Float,
				true,  -- Enabled
				true,  -- Override previous state
				380,   -- Width
				200,   -- Height
				320,   -- Min width
				180    -- Min height
			)
			return pluginObj:CreateDockWidgetPluginGui("UniversalMCP_ConnectedModal_" .. tostring(os.time()), widgetInfo)
		end)

		if success and modal then
			modal.Title = "⚡ Universal MCP Aktif"

			local main = Instance.new("Frame")
			main.Size = UDim2.new(1, 0, 1, 0)
			main.BackgroundColor3 = Color3.fromRGB(24, 25, 29)
			main.BorderSizePixel = 0
			main.Parent = modal

			local padding = Instance.new("UIPadding")
			padding.PaddingTop = UDim.new(0, 16)
			padding.PaddingBottom = UDim.new(0, 16)
			padding.PaddingLeft = UDim.new(0, 16)
			padding.PaddingRight = UDim.new(0, 16)
			padding.Parent = main

			local layout = Instance.new("UIListLayout")
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Padding = UDim.new(0, 10)
			layout.Parent = main

			local titleLabel = Instance.new("TextLabel")
			titleLabel.Size = UDim2.new(1, 0, 0, 24)
			titleLabel.BackgroundTransparency = 1
			titleLabel.Text = "⚡ Universal MCP Köprüsü Aktif Edildi!"
			titleLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
			titleLabel.Font = Enum.Font.GothamBold
			titleLabel.TextSize = 16
			titleLabel.TextXAlignment = Enum.TextXAlignment.Left
			titleLabel.LayoutOrder = 1
			titleLabel.Parent = main

			local infoLabel = Instance.new("TextLabel")
			infoLabel.Size = UDim2.new(1, 0, 0, 48)
			infoLabel.BackgroundTransparency = 1
			infoLabel.Text = string.format("MCP Köprüsü %s üzerinde bağlandı.\nAI Agent (Claude / Cursor) projenizi yönetmeye hazır.", baseUrl)
			infoLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
			infoLabel.Font = Enum.Font.Gotham
			infoLabel.TextSize = 13
			infoLabel.TextWrapped = true
			infoLabel.TextXAlignment = Enum.TextXAlignment.Left
			infoLabel.LayoutOrder = 2
			infoLabel.Parent = main

			local btnRow = Instance.new("Frame")
			btnRow.Size = UDim2.new(1, 0, 0, 36)
			btnRow.BackgroundTransparency = 1
			btnRow.LayoutOrder = 3
			btnRow.Parent = main

			local btnLayout = Instance.new("UIListLayout")
			btnLayout.FillDirection = Enum.FillDirection.Horizontal
			btnLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
			btnLayout.Padding = UDim.new(0, 10)
			btnLayout.Parent = btnRow

			local openBtn = Instance.new("TextButton")
			openBtn.Size = UDim2.new(0, 130, 1, 0)
			openBtn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
			openBtn.Text = "Paneli Aç"
			openBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			openBtn.Font = Enum.Font.GothamMedium
			openBtn.TextSize = 13
			openBtn.Parent = btnRow

			local openCorner = Instance.new("UICorner")
			openCorner.CornerRadius = UDim.new(0, 6)
			openCorner.Parent = openBtn

			openBtn.MouseButton1Click:Connect(function()
				modal.Enabled = false
				if onOpenPanel then
					onOpenPanel()
				end
			end)

			local closeBtn = Instance.new("TextButton")
			closeBtn.Size = UDim2.new(0, 90, 1, 0)
			closeBtn.BackgroundColor3 = Color3.fromRGB(50, 52, 60)
			closeBtn.Text = "Tamam"
			closeBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
			closeBtn.Font = Enum.Font.GothamMedium
			closeBtn.TextSize = 13
			closeBtn.Parent = btnRow

			local closeCorner = Instance.new("UICorner")
			closeCorner.CornerRadius = UDim.new(0, 6)
			closeCorner.Parent = closeBtn

			closeBtn.MouseButton1Click:Connect(function()
				modal.Enabled = false
			end)

			return modal
		end
	end

	-- Fallback ScreenGui Modal (for Command Bar / Live injection when plugin is nil)
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "UniversalMCP_ModalGui"
	screenGui.ResetOnSpawn = false

	pcall(function()
		screenGui.Parent = CoreGui
	end)
	if not screenGui.Parent then
		pcall(function()
			screenGui.Parent = StarterGui
		end)
	end

	local modalFrame = Instance.new("Frame")
	modalFrame.Size = UDim2.new(0, 420, 0, 220)
	modalFrame.Position = UDim2.new(0.5, -210, 0.5, -110)
	modalFrame.BackgroundColor3 = Color3.fromRGB(24, 25, 29)
	modalFrame.BorderSizePixel = 0
	modalFrame.Parent = screenGui

	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 8)
	frameCorner.Parent = modalFrame

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 18)
	pad.PaddingBottom = UDim.new(0, 18)
	pad.PaddingLeft = UDim.new(0, 20)
	pad.PaddingRight = UDim.new(0, 20)
	pad.Parent = modalFrame

	local vLayout = Instance.new("UIListLayout")
	vLayout.SortOrder = Enum.SortOrder.LayoutOrder
	vLayout.Padding = UDim.new(0, 12)
	vLayout.Parent = modalFrame

	local tLabel = Instance.new("TextLabel")
	tLabel.Size = UDim2.new(1, 0, 0, 26)
	tLabel.BackgroundTransparency = 1
	tLabel.Text = "⚡ Universal MCP Köprüsü Aktif Edildi!"
	tLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
	tLabel.Font = Enum.Font.GothamBold
	tLabel.TextSize = 17
	tLabel.TextXAlignment = Enum.TextXAlignment.Left
	tLabel.LayoutOrder = 1
	tLabel.Parent = modalFrame

	local iLabel = Instance.new("TextLabel")
	iLabel.Size = UDim2.new(1, 0, 0, 52)
	iLabel.BackgroundTransparency = 1
	iLabel.Text = string.format("MCP Köprüsü %s üzerinde aktif edildi!\nAI Agent (Claude / Cursor) projenizi yönetmeye hazır.", baseUrl)
	iLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
	iLabel.Font = Enum.Font.Gotham
	iLabel.TextSize = 14
	iLabel.TextWrapped = true
	iLabel.TextXAlignment = Enum.TextXAlignment.Left
	iLabel.LayoutOrder = 2
	iLabel.Parent = modalFrame

	local bRow = Instance.new("Frame")
	bRow.Size = UDim2.new(1, 0, 0, 36)
	bRow.BackgroundTransparency = 1
	bRow.LayoutOrder = 3
	bRow.Parent = modalFrame

	local bLayout = Instance.new("UIListLayout")
	bLayout.FillDirection = Enum.FillDirection.Horizontal
	bLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	bLayout.Padding = UDim.new(0, 10)
	bLayout.Parent = bRow

	local okBtn = Instance.new("TextButton")
	okBtn.Size = UDim2.new(0, 100, 1, 0)
	okBtn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
	okBtn.Text = "Tamam"
	okBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	okBtn.Font = Enum.Font.GothamBold
	okBtn.TextSize = 14
	okBtn.Parent = bRow

	local okCorner = Instance.new("UICorner")
	okCorner.CornerRadius = UDim.new(0, 6)
	okCorner.Parent = okBtn

	okBtn.MouseButton1Click:Connect(function()
		screenGui:Destroy()
	end)

	return screenGui
end

return MessageBox
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_66">
			<Properties>
				<string name="Name">Toolbar</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- UI Toolbar management

local Toolbar = {}

local activeToolbar: PluginToolbar? = nil
local activeButtons: { [string]: PluginToolbarButton } = {}

function Toolbar.Create(plugin: Plugin, onToggleWidget: () -> ()): (boolean, string?)
	if not plugin or typeof(plugin.CreateToolbar) ~= "function" then
		return false, "Invalid Plugin object passed to Toolbar"
	end

	local success, err = pcall(function()
		local toolbar = plugin:CreateToolbar("Universal MCP")
		activeToolbar = toolbar

		local button = toolbar:CreateButton(
			"MCP Status",
			"Open Universal MCP Diagnostics & Status",
			"rbxasset://textures/ui/Settings/MenuBar/SettingsButton.png"
		)
		button.ClickableWhenViewportHidden = true

		button.Click:Connect(function()
			if onToggleWidget then
				onToggleWidget()
			end
		end)

		activeButtons["Status"] = button
	end)

	if not success then
		return false, tostring(err)
	end

	return true, nil
end

function Toolbar.SetButtonActive(buttonName: string, active: boolean)
	local btn = activeButtons[buttonName]
	if btn then
		pcall(function()
			btn:SetActive(active)
		end)
	end
end

function Toolbar.Destroy()
	activeToolbar = nil
	activeButtons = {}
end

return Toolbar
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_67">
			<Properties>
				<string name="Name">Widget</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Widget: Manages creation and lifecycle of the Studio DockWidget

local DiagnosticsView = require(script.Parent.DiagnosticsView)

local Widget = {}

local activeWidget: DockWidgetPluginGui? = nil

function Widget.Create(plugin: Plugin, onConnectRequest: () -> (), onRefreshRequest: () -> ()): (DockWidgetPluginGui?, string?)
	if not plugin or typeof(plugin.CreateDockWidgetPluginGui) ~= "function" then
		return nil, "Invalid Plugin object passed to Widget.Create"
	end

	local widgetInfo = DockWidgetPluginGuiInfo.new(
		Enum.InitialDockState.Right,
		false, -- Initially enabled
		false, -- Override previous enabled state
		320,   -- Default width
		480,   -- Default height
		280,   -- Min width
		300    -- Min height
	)

	local success, widget = pcall(function()
		return plugin:CreateDockWidgetPluginGui("UniversalMCP_Widget_V3", widgetInfo)
	end)

	if not success or not widget then
		return nil, tostring(widget or "Failed to create DockWidgetPluginGui")
	end

	widget.Title = "Universal MCP"
	activeWidget = widget

	-- Render diagnostics view inside widget
	DiagnosticsView.Render(widget, onConnectRequest, onRefreshRequest)

	return widget, nil
end

function Widget.Toggle()
	if activeWidget then
		activeWidget.Enabled = not activeWidget.Enabled
	end
end

function Widget.SetEnabled(enabled: boolean)
	if activeWidget then
		activeWidget.Enabled = enabled
	end
end

function Widget.Destroy()
	activeWidget = nil
end

return Widget
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
		<Item class="Folder" referent="RBX_68">
			<Properties>
				<string name="Name">Utils</string>
			</Properties>
		<Item class="ModuleScript" referent="RBX_69">
			<Properties>
				<string name="Name">ErrorCodes</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local ErrorCodes = {
	INVALID_ARGUMENT = "INVALID_ARGUMENT",
	INSTANCE_NOT_FOUND = "INSTANCE_NOT_FOUND",
	PROPERTY_NOT_FOUND = "PROPERTY_NOT_FOUND",
	PROPERTY_READ_ONLY = "PROPERTY_READ_ONLY",
	TYPE_COERCION_FAILED = "TYPE_COERCION_FAILED",
	SCRIPT_NOT_FOUND = "SCRIPT_NOT_FOUND",
	SCRIPT_NOT_EDITABLE = "SCRIPT_NOT_EDITABLE",
	SCRIPT_PATCH_FAILED = "SCRIPT_PATCH_FAILED",
	UNSUPPORTED_OPERATION = "UNSUPPORTED_OPERATION",
	UNSUPPORTED_BY_ROBLOX_PLUGIN_API = "UNSUPPORTED_BY_ROBLOX_PLUGIN_API",
	PERMISSION_DENIED = "PERMISSION_DENIED",
	PLAYTEST_NOT_ACTIVE = "PLAYTEST_NOT_ACTIVE",
	EXECUTION_FAILED = "EXECUTION_FAILED",
	INTERNAL_ERROR = "INTERNAL_ERROR",
}

export type ErrorObject = {
	code: string,
	message: string,
	details: { [string]: any }?,
}

function ErrorCodes.Create(code: string, message: string, details: { [string]: any }?): ErrorObject
	return {
		code = code,
		message = message,
		details = details or {},
	}
end

return ErrorCodes
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_70">
			<Properties>
				<string name="Name">Logger</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Config = require(script.Parent.Parent.Config)

local Logger = {}
local PREFIX = "[Roblox MCP Bridge]"

function Logger.Log(...)
	if Config.DebugMode then
		print(PREFIX, ...)
	end
end

function Logger.Warn(...)
	warn(PREFIX, ...)
end

function Logger.Error(...)
	warn(PREFIX, "ERROR:", ...)
end

return Logger
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_71">
			<Properties>
				<string name="Name">LuauTypeCoercion</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local LuauTypeCoercion = {}

-- Serialize any Roblox DataModel value to JSON-safe structure
function LuauTypeCoercion.Serialize(val: any): any
	local valType = typeof(val)

	if valType == "number" or valType == "string" or valType == "boolean" then
		return val
	elseif valType == "nil" then
		return nil
	elseif valType == "Vector3" then
		return { _type = "Vector3", x = val.X, y = val.Y, z = val.Z }
	elseif valType == "Vector2" then
		return { _type = "Vector2", x = val.X, y = val.Y }
	elseif valType == "CFrame" then
		local comp = { val:GetComponents() }
		return { _type = "CFrame", components = comp, position = { val.Position.X, val.Position.Y, val.Position.Z } }
	elseif valType == "Color3" then
		return { _type = "Color3", r = val.R, g = val.G, b = val.B, hex = val:ToHex() }
	elseif valType == "BrickColor" then
		return { _type = "BrickColor", name = val.Name, number = val.Number }
	elseif valType == "UDim" then
		return { _type = "UDim", scale = val.Scale, offset = val.Offset }
	elseif valType == "UDim2" then
		return { _type = "UDim2", x = { scale = val.X.Scale, offset = val.X.Offset }, y = { scale = val.Y.Scale, offset = val.Y.Offset } }
	elseif valType == "NumberRange" then
		return { _type = "NumberRange", min = val.Min, max = val.Max }
	elseif valType == "EnumItem" then
		return { _type = "EnumItem", enum = tostring(val.EnumType), name = val.Name, value = val.Value }
	elseif valType == "Instance" then
		return { _type = "Instance", name = val.Name, className = val.ClassName, path = val:GetFullName() }
	elseif valType == "table" then
		local result = {}
		for k, v in pairs(val) do
			result[tostring(k)] = LuauTypeCoercion.Serialize(v)
		end
		return result
	else
		return tostring(val)
	end
end

-- Parse hex color string "#RRGGBB"
local function parseHexColor(hex: string): Color3?
	local cleaned = hex:gsub("#", "")
	if #cleaned == 6 then
		local r = tonumber(cleaned:sub(1, 2), 16)
		local g = tonumber(cleaned:sub(3, 4), 16)
		local b = tonumber(cleaned:sub(5, 6), 16)
		if r and g and b then
			return Color3.fromRGB(r, g, b)
		end
	end
	return nil
end

-- Coerce raw incoming value into expected Roblox engine type
function LuauTypeCoercion.Coerce(rawVal: any, targetPropertyType: string?): any
	if rawVal == nil then
		return nil
	end

	local rawType = typeof(rawVal)

	-- Direct match
	if rawType == "number" or rawType == "boolean" then
		return rawVal
	end

	if rawType == "string" then
		-- Check for Enum string: "Enum.Material.Neon" or "Material.Neon" or "Neon"
		if targetPropertyType and string.find(targetPropertyType, "Enum") then
			local enumName = targetPropertyType:gsub("Enum%.", "")
			local enumObj = (Enum :: any)[enumName]
			if enumObj then
				local item = enumObj[rawVal]
				if item then return item end
			end
		end

		-- Check if it's an Enum string literal like "Enum.Material.Plastic"
		if rawVal:sub(1, 5) == "Enum." then
			local parts = string.split(rawVal, ".")
			if #parts >= 3 then
				local enumObj = (Enum :: any)[parts[2]]
				if enumObj and enumObj[parts[3]] then
					return enumObj[parts[3]]
				end
			end
		end

		-- Hex color
		if rawVal:sub(1, 1) == "#" and targetPropertyType == "Color3" then
			local c = parseHexColor(rawVal)
			if c then return c end
		end

		return rawVal
	end

	if rawType == "table" then
		-- Check explicit _type tag
		if rawVal._type == "Vector3" or (rawVal.x and rawVal.y and rawVal.z and not rawVal.r) then
			return Vector3.new(rawVal.x or rawVal.X or 0, rawVal.y or rawVal.Y or 0, rawVal.z or rawVal.Z or 0)
		end

		if rawVal._type == "Vector2" or (rawVal.x and rawVal.y and not rawVal.z) then
			return Vector2.new(rawVal.x or rawVal.X or 0, rawVal.y or rawVal.Y or 0)
		end

		if rawVal._type == "Color3" or (rawVal.r and rawVal.g and rawVal.b) then
			local r = rawVal.r or rawVal.R or 0
			local g = rawVal.g or rawVal.G or 0
			local b = rawVal.b or rawVal.B or 0
			-- If values > 1, treat as 0-255 RGB
			if r > 1 or g > 1 or b > 1 then
				return Color3.fromRGB(r, g, b)
			else
				return Color3.new(r, g, b)
			end
		end

		if rawVal._type == "UDim2" then
			local sx = (rawVal.x and (rawVal.x.scale or rawVal.x.Scale)) or rawVal[1] or 0
			local ox = (rawVal.x and (rawVal.x.offset or rawVal.x.Offset)) or rawVal[2] or 0
			local sy = (rawVal.y and (rawVal.y.scale or rawVal.y.Scale)) or rawVal[3] or 0
			local oy = (rawVal.y and (rawVal.y.offset or rawVal.y.Offset)) or rawVal[4] or 0
			return UDim2.new(sx, ox, sy, oy)
		end

		if rawVal._type == "CFrame" and rawVal.components then
			return CFrame.new(table.unpack(rawVal.components))
		end

		-- Array forms [X, Y, Z]
		if #rawVal == 3 and (targetPropertyType == "Vector3" or targetPropertyType == nil) then
			return Vector3.new(rawVal[1], rawVal[2], rawVal[3])
		end

		if #rawVal == 3 and targetPropertyType == "Color3" then
			if rawVal[1] > 1 or rawVal[2] > 1 or rawVal[3] > 1 then
				return Color3.fromRGB(rawVal[1], rawVal[2], rawVal[3])
			else
				return Color3.new(rawVal[1], rawVal[2], rawVal[3])
			end
		end

		if #rawVal == 2 and targetPropertyType == "Vector2" then
			return Vector2.new(rawVal[1], rawVal[2])
		end

		if #rawVal == 4 and targetPropertyType == "UDim2" then
			return UDim2.new(rawVal[1], rawVal[2], rawVal[3], rawVal[4])
		end

		if #rawVal == 12 and targetPropertyType == "CFrame" then
			return CFrame.new(table.unpack(rawVal))
		end
	end

	return rawVal
end

return LuauTypeCoercion
]]></ProtectedString>
			</Properties>
		</Item>
		</Item>
	</Item>
</roblox>