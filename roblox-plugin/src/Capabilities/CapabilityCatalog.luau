function CapabilityCatalog.GetClass(className: string): ClassSpec?
	return classCatalog[className]
end

function CapabilityCatalog.GetAllClasses(): { [string]: ClassSpec }
	return classCatalog
end

function CapabilityCatalog.IsCreatable(className: string): boolean
	local spec = classCatalog[className]
	return spec ~= nil and spec.creatable
end

return CapabilityCatalog
